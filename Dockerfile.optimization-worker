FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY ["workers/optimization-worker/StockTrader.OptimizationWorker.fsproj", "workers/optimization-worker/"]
COPY ["src/StockTrader.Engine/StockTrader.Engine.csproj", "src/StockTrader.Engine/"]
COPY ["src/StockTrader.OptimizationProtocol/StockTrader.OptimizationProtocol.csproj", "src/StockTrader.OptimizationProtocol/"]
COPY ["src/StockTrader.ServiceContracts/StockTrader.ServiceContracts.csproj", "src/StockTrader.ServiceContracts/"]
RUN dotnet restore "workers/optimization-worker/StockTrader.OptimizationWorker.fsproj"
COPY . .
RUN dotnet publish "workers/optimization-worker/StockTrader.OptimizationWorker.fsproj" \
    -c Release -o /app/publish /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app
COPY --from=build /app/publish .
ENV ASPNETCORE_HTTP_PORTS=8080
ENV ASPNETCORE_ENVIRONMENT=Production
EXPOSE 8080
USER $APP_UID
ENTRYPOINT ["dotnet", "StockTrader.OptimizationWorker.dll", "--serve"]
