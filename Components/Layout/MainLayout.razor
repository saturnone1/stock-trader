@inherits LayoutComponentBase
@using StockTrader.Models
@using StockTrader.Models.Enums
@using StockTrader.Services.Account
@using System.Net.Http.Json
@inject IAccountManager AccountManager
@inject NavigationManager Navigation
@inject IHttpClientFactory HttpClientFactory
@implements IDisposable

<MudThemeProvider Theme="_tradingTheme" IsDarkMode="true" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" Dense="true">
        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Inherit"
                       Edge="Edge.Start"
                       OnClick="@ToggleDrawer" />
        <MudText Typo="Typo.h6" Class="ml-3">주식 트레이더</MudText>
        <MudSpacer />

        @* 활성 계좌 드롭다운 *@
        @if (_accounts.Count > 0)
        {
            <MudMenu Dense="true" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                <ActivatorContent>
                    <MudButton Variant="Variant.Text" Color="Color.Inherit" Size="Size.Small"
                               EndIcon="@Icons.Material.Filled.ArrowDropDown"
                               StartIcon="@Icons.Material.Filled.AccountBalance"
                               Class="mr-1">
                        @(_activeAccount?.AccountName ?? "계좌 없음")
                    </MudButton>
                </ActivatorContent>
                <ChildContent>
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="px-4 py-1">계좌 전환</MudText>
                    <MudDivider />
                    @foreach (var account in _accounts)
                    {
                        <MudMenuItem OnClick="@(() => SwitchAccountAsync(account.Id))">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                @if (account.IsActive)
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.RadioButtonChecked"
                                             Size="Size.Small" Color="Color.Primary" />
                                }
                                else
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.RadioButtonUnchecked"
                                             Size="Size.Small" Color="Color.Secondary" />
                                }
                                <div>
                                    <MudText Typo="Typo.body2">@account.AccountName</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        @account.BrokerType · @account.Environment
                                    </MudText>
                                </div>
                            </MudStack>
                        </MudMenuItem>
                    }
                    <MudDivider />
                    <MudMenuItem OnClick="@(() => Navigation.NavigateTo("/accounts"))">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            <MudIcon Icon="@Icons.Material.Filled.Settings" Size="Size.Small" />
                            <MudText Typo="Typo.body2">계좌 관리</MudText>
                        </MudStack>
                    </MudMenuItem>
                </ChildContent>
            </MudMenu>
        }
        else
        {
            <MudButton Variant="Variant.Outlined" Color="Color.Warning" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Add" Class="mr-2"
                       OnClick="@(() => Navigation.NavigateTo("/accounts"))">
                계좌 추가
            </MudButton>
        }

        <StreamingStatus />
        <MudIconButton Icon="@Icons.Material.Filled.HelpOutline"
                       Color="Color.Inherit"
                       Href="guide"
                       title="사용 가이드" />
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen"
               ClipMode="DrawerClipMode.Always"
               Elevation="2"
               Variant="@DrawerVariant.Responsive">
        <NavMenu />
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.False" Class="pa-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    처리되지 않은 오류가 발생했습니다.
    <a href="." class="reload">새로고침</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _drawerOpen = true;
    private List<TradingAccount> _accounts = new();
    private TradingAccount? _activeAccount;

    protected override async Task OnInitializedAsync()
    {
        // 인증 확인 — /login, /setup 페이지는 인증 없이 접근 허용
        await CheckAuthAsync();

        AccountManager.OnAccountsChanged += OnAccountsChanged;
        await LoadAccountsAsync();
    }

    private async Task CheckAuthAsync()
    {
        var uri = Navigation.Uri;
        var path = new Uri(uri).AbsolutePath.TrimEnd('/').ToLower();

        // 공개 경로는 인증 체크 건너뜀
        if (path == "/login" || path == "/setup")
            return;

        try
        {
            var client = HttpClientFactory.CreateClient("Auth");
            var resp = await client.GetAsync("/api/auth/me");
            if (resp.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                Navigation.NavigateTo("/login", forceLoad: true);
            }
        }
        catch
        {
            // 연결 실패 시 로그인 페이지로 이동 (서버가 실행 중이지 않은 경우 제외)
            // Blazor Server 자체 API이므로 연결 실패는 비정상 상황
        }
    }

    private async Task LoadAccountsAsync()
    {
        _accounts = await AccountManager.GetAllAccountsAsync();
        _activeAccount = _accounts.FirstOrDefault(a => a.IsActive);
    }

    private void OnAccountsChanged()
    {
        _ = InvokeAsync(async () =>
        {
            try { await LoadAccountsAsync(); StateHasChanged(); }
            catch (ObjectDisposedException) { }
        });
    }

    private async Task SwitchAccountAsync(int accountId)
    {
        if (_activeAccount?.Id == accountId) return;
        try
        {
            await AccountManager.SetActiveAccountAsync(accountId);
            await LoadAccountsAsync();
        }
        catch { /* 무시 */ }
    }

    public void Dispose()
    {
        AccountManager.OnAccountsChanged -= OnAccountsChanged;
    }

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    private readonly MudTheme _tradingTheme = new()
    {
        PaletteDark = new PaletteDark
        {
            Primary = "#1565C0",
            Secondary = "#37474F",
            Success = "#2E7D32",
            Error = "#C62828",
            Warning = "#F57F17",
            Background = "#121212",
            BackgroundGray = "#1E1E1E",
            Surface = "#1E1E1E",
            AppbarBackground = "#0D0D0D",
            DrawerBackground = "#161616",
            TextPrimary = "#EEEEEE",
            TextSecondary = "#9E9E9E",
        }
    };
}
