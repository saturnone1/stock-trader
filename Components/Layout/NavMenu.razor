@inject NavigationManager Navigation
@inject IJSRuntime JS

<MudNavMenu>
    <MudNavLink Href="" Match="NavLinkMatch.All"
                Icon="@Icons.Material.Filled.Dashboard">대시보드</MudNavLink>
    <MudNavLink Href="recommendations"
                Icon="@Icons.Material.Filled.Recommend">종목 추천</MudNavLink>
    <MudNavLink Href="signals"
                Icon="@Icons.Material.Filled.ShowChart">활성 시그널</MudNavLink>
    <MudNavLink Href="patterns"
                Icon="@Icons.Material.Filled.BarChart">패턴 통계</MudNavLink>
    <MudNavLink Href="history"
                Icon="@Icons.Material.Filled.History">거래 내역</MudNavLink>
    <MudNavLink Href="portfolio"
                Icon="@Icons.Material.Filled.Analytics">포트폴리오 분석</MudNavLink>
    <MudNavLink Href="backtest"
                Icon="@Icons.Material.Filled.Science">백테스트</MudNavLink>
    <MudNavLink Href="ml"
                Icon="@Icons.Material.Filled.Psychology">ML 분석</MudNavLink>
    <MudNavLink Href="risk"
                Icon="@Icons.Material.Filled.Security">리스크 모니터</MudNavLink>
    <MudNavLink Href="accounts"
                Icon="@Icons.Material.Filled.AccountBalance">계좌 관리</MudNavLink>
    <MudNavLink Href="settings"
                Icon="@Icons.Material.Filled.Settings">설정</MudNavLink>
    <MudDivider Class="my-2" />
    <MudNavLink Href="guide"
                Icon="@Icons.Material.Filled.Help">사용 가이드</MudNavLink>
    <MudDivider Class="my-2" />
    <MudNavLink Href="account"
                Icon="@Icons.Material.Filled.ManageAccounts">계정 관리</MudNavLink>
    <div class="px-2 pb-2">
        <MudButton FullWidth="true"
                   Variant="Variant.Text"
                   Color="Color.Error"
                   StartIcon="@Icons.Material.Filled.Logout"
                   OnClick="@LogoutAsync"
                   Disabled="@_isLoggingOut"
                   Style="justify-content: flex-start; text-transform: none; font-size: 0.875rem; padding: 6px 16px;">
            @if (_isLoggingOut)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                <span>로그아웃 중...</span>
            }
            else
            {
                <span>로그아웃</span>
            }
        </MudButton>
    </div>
</MudNavMenu>

@code {
    private bool _isLoggingOut;

    private async Task LogoutAsync()
    {
        _isLoggingOut = true;
        try
        {
            var module = await JS.InvokeAsync<IJSObjectReference>(
                "import", "./js/auth.js");
            await module.InvokeVoidAsync("authFetch", "/api/auth/logout", "POST", null);
        }
        catch { }
        finally
        {
            Navigation.NavigateTo("/login", forceLoad: true);
        }
    }
}

