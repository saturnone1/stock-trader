@using StockTrader.Models.Enums
@using StockTrader.Data.Repositories
@inject ISettingsRepository SettingsRepo
@inject IDialogService DialogService

<MudChip T="string"
         Color="@(CurrentMode == OrderMode.AutoOrder ? Color.Error : Color.Success)"
         Variant="Variant.Filled"
         Size="Size.Medium"
         OnClick="ToggleMode">
    @(CurrentMode == OrderMode.AutoOrder ? "자동 주문" : "알림 전용")
</MudChip>

@code {
    [Parameter] public EventCallback<OrderMode> OnModeChanged { get; set; }

    private OrderMode CurrentMode { get; set; } = OrderMode.AlertOnly;

    protected override async Task OnInitializedAsync()
    {
        var settings = await SettingsRepo.GetAsync();
        CurrentMode = settings.OrderMode;
    }

    private async Task ToggleMode()
    {
        if (CurrentMode == OrderMode.AlertOnly)
        {
            var parameters = new DialogParameters<ConfirmDialog>
            {
                { x => x.Title, "자동 주문 모드" },
                { x => x.Message, "경고: 자동 주문 모드는 Alpaca API를 통해 자동으로 매매를 실행합니다.\n\n테스트를 위해 반드시 모의 투자(Paper Trading) 계좌를 사용해 주세요.\n\n자동 주문을 활성화하시겠습니까?" },
                { x => x.ConfirmText, "자동 주문 활성화" },
                { x => x.ConfirmColor, Color.Error }
            };

            var dialog = await DialogService.ShowAsync<ConfirmDialog>("자동 주문 모드", parameters);
            var result = await dialog.Result;

            if (result != null && !result.Canceled)
            {
                CurrentMode = OrderMode.AutoOrder;
                await SaveMode();
            }
        }
        else
        {
            CurrentMode = OrderMode.AlertOnly;
            await SaveMode();
        }
    }

    private async Task SaveMode()
    {
        var settings = await SettingsRepo.GetAsync();
        settings.OrderMode = CurrentMode;
        await SettingsRepo.SaveAsync(settings);
        await OnModeChanged.InvokeAsync(CurrentMode);
    }
}
