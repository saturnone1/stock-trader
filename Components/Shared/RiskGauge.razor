@using StockTrader.Models

<MudCard>
    <MudCardContent>
        <MudTooltip Text="@($"오늘 하루 손익. 계좌의 -{DailyLossLimitPercent * 100:F0}% 도달 시 거래 자동 중단, 다음 거래일 재개")">
            <MudText Typo="Typo.subtitle2" Style="cursor:help">일일 손익 ⓘ</MudText>
        </MudTooltip>
        <MudProgressLinear Color="@BarColor"
                           Value="@BarWidth"
                           Size="Size.Large"
                           Rounded="true"
                           Class="my-2" />
        <MudStack Row="true" Justify="Justify.SpaceBetween">
            <MudText Typo="Typo.caption" Color="Color.Error">한도: -@((DailyLossLimitPercent * 100m).ToString("F2"))%</MudText>
            <MudText Typo="Typo.caption"
                     Color="@(State.DailyPnL >= 0 ? Color.Success : Color.Error)">
                $@State.DailyPnL.ToString("N2")
            </MudText>
        </MudStack>
        @if (State.IsTradingHalted)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2">
                <strong>거래 중단</strong>
            </MudAlert>
        }
    </MudCardContent>
</MudCard>

@code {
    [Parameter] public RiskState State { get; set; } = new();
    [Parameter] public decimal DailyLossLimitPercent { get; set; } = 0.03m;

    private Color BarColor => State.DailyPnLPercent >= 0
        ? Color.Success
        : State.IsTradingHalted ? Color.Error : Color.Warning;

    // Fix 4: DailyLossLimitPercent가 0 이하이면 0으로 나누기 방지 - 안전한 기본값 5 반환
    // 이익(양수) 시에는 게이지를 0으로 표시 — 손실 방향만 시각화
    private double BarWidth
    {
        get
        {
            if (State.DailyPnLPercent >= 0) return 0;
            if (DailyLossLimitPercent <= 0) return 5;
            return Math.Min(100, Math.Max(5,
                (double)(-State.DailyPnLPercent) / (double)DailyLossLimitPercent * 100));
        }
    }
}
