@using StockTrader.Services.Notification
@inject INotificationService NotificationService
@implements IDisposable

<span class="streaming-status">
    <MudTooltip Text="@_tooltip">
        <MudIcon Icon="@Icons.Material.Filled.Wifi"
                 Color="@(_isActive ? Color.Success : Color.Error)"
                 Size="Size.Small"
                 Class="ml-2" />
    </MudTooltip>
</span>

@code {
    private bool _isActive;
    private string _tooltip = "스트리밍: 비활성";

    protected override void OnInitialized()
    {
        NotificationService.OnStreamingStatusChanged += OnStatusChanged;
    }

    private void OnStatusChanged(bool isActive)
    {
        _ = InvokeAsync(() =>
        {
            try
            {
                _isActive = isActive;
                _tooltip = isActive ? "스트리밍: 실시간 연결" : "스트리밍: 비활성 (폴링 모드)";
                StateHasChanged();
            }
            catch (ObjectDisposedException) { }
        });
    }

    public void Dispose()
    {
        NotificationService.OnStreamingStatusChanged -= OnStatusChanged;
    }
}
