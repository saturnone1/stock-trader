<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@Title</MudText>
    </TitleContent>
    <DialogContent>
        @* 줄바꿈(\n) 처리: white-space: pre-line *@
        <MudText Style="white-space: pre-line;">@Message</MudText>
    </DialogContent>
    <DialogActions>
        @* 모바일: 버튼을 세로 스택으로 전체 너비 표시 (터치 타겟 44px+ 확보) *@
        @if (_isMobile)
        {
            <MudStack Class="w-100 pa-2" Spacing="2">
                <MudButton OnClick="Confirm" Variant="Variant.Filled" Color="@ConfirmColor"
                           FullWidth="true" Size="Size.Large">@ConfirmText</MudButton>
                <MudButton OnClick="Cancel" Variant="Variant.Text" FullWidth="true">취소</MudButton>
            </MudStack>
        }
        else
        {
            <MudButton OnClick="Cancel" Variant="Variant.Text">취소</MudButton>
            <MudButton OnClick="Confirm" Variant="Variant.Filled" Color="@ConfirmColor">@ConfirmText</MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [CascadingParameter(Name = "IsMobile")] private bool _isMobile { get; set; }

    [Parameter] public string Title { get; set; } = "확인";
    [Parameter] public string Message { get; set; } = "계속하시겠습니까?";
    [Parameter] public string ConfirmText { get; set; } = "확인";
    [Parameter] public Color ConfirmColor { get; set; } = Color.Primary;

    private void Confirm() => MudDialog.Close(DialogResult.Ok(true));
    private void Cancel() => MudDialog.Cancel();
}
