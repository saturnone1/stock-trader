@using StockTrader.Models
@using StockTrader.Models.Enums

@* 모바일: 컴팩트 뷰 (패딩 축소, 가격 인라인 배치), 데스크톱: 기본 뷰 *@
<div class="signal-card" style="border-left: 3px solid @BorderColor; @(_isMobile ? "padding: 6px 8px;" : "")">

    @* 1행: 종목 + 패턴칩 + 가격 *@
    <div class="signal-card-row">
        <div class="signal-card-left">
            <div class="signal-card-tags">
                <strong style="font-size: @(_isMobile ? "0.85rem" : "0.9rem"); white-space: nowrap;">@Signal.Symbol</strong>
                <MudChip T="string" Color="@PatternMetadataMap.GetMudColor(Signal.PatternType)"
                         Variant="Variant.Filled" Size="Size.Small" Class="chip-xs">
                    @* 모바일: 스타일 레이블(단타/스윙 등) 만 표시, 데스크톱: 전체 패턴명 *@
                    @if (_isMobile)
                    {
                        @PatternMetadataMap.GetStyleLabel(Signal.PatternType)
                    }
                    else
                    {
                        @PatternMetadataMap.GetKoreanName(Signal.PatternType)
                    }
                </MudChip>
                @if (IsStale)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Warning"
                             Variant="Variant.Outlined" Class="chip-xs">만료</MudChip>
                }
            </div>
        </div>
        <div class="signal-card-prices" style="@(_isMobile ? "font-size: 0.8rem;" : "")">
            <div><b>$@Signal.EntryPrice.ToString("F2")</b></div>
            <div style="color: var(--mud-palette-error);">$@Signal.StopLossPrice.ToString("F2")</div>
            <div style="color: var(--mud-palette-success);">$@Signal.TargetPrice.ToString("F2")</div>
        </div>
    </div>

    @* 2행: 메타 정보 — 모바일에서 스타일/보유기간 생략(1행 칩에 스타일 표시) *@
    <div class="signal-card-meta" style="@(_isMobile ? "font-size: 0.75rem; gap: 6px;" : "")">
        <span style="color: @(IsStale ? "var(--mud-palette-warning)" : "inherit");">@GetElapsedText()</span>
        <span>R:R <span style="color: @(RiskRewardRatio >= 2m ? "var(--mud-palette-success)" : RiskRewardRatio >= 1m ? "var(--mud-palette-warning)" : "var(--mud-palette-error)");">@RiskRewardRatio.ToString("F1")</span></span>
        <span>신뢰도 <span style="color: @ConfidenceColor;">@((Signal.Confidence * 100).ToString("F0"))%</span></span>
        @* 모바일: 스타일·보유기간 숨김 (1행 칩으로 충분) *@
        <span class="hide-mobile-sm">@PatternMetadataMap.GetStyleLabel(Signal.PatternType)</span>
        <span class="hide-mobile-sm">@PatternMetadataMap.Get(Signal.PatternType).HoldingPeriod</span>
    </div>

    @* 3행: 추천 정보 (있을 때만) *@
    @if (Recommendation != null)
    {
        <div class="signal-card-meta" style="margin-top: 4px; padding-top: 4px; border-top: 1px solid rgba(255,255,255,0.08); @(_isMobile ? "font-size: 0.75rem;" : "")">
            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled" Class="chip-xs">추천</MudChip>
            <span>@(Recommendation.ShareQuantity)주 · $@(Recommendation.PositionSize.ToString("N0"))</span>
            @if (Recommendation.Expectancy > 0)
            {
                <span style="color: var(--mud-palette-success);">기대값 @(Recommendation.Expectancy.ToString("P2"))</span>
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public PatternSignal Signal { get; set; } = default!;
    [Parameter] public TradeRecommendation? Recommendation { get; set; }
    [CascadingParameter(Name = "IsMobile")] private bool _isMobile { get; set; }

    private string BorderColor => Signal.Confidence > 0.7m
        ? "var(--mud-palette-success)"
        : Signal.Confidence > 0.4m
        ? "var(--mud-palette-warning)"
        : "var(--mud-palette-text-disabled)";

    private string ConfidenceColor => Signal.Confidence > 0.7m
        ? "var(--mud-palette-success)"
        : Signal.Confidence > 0.4m
        ? "var(--mud-palette-warning)"
        : "var(--mud-palette-error)";

    private decimal RiskRewardRatio
    {
        get
        {
            var risk = Math.Abs(Signal.EntryPrice - Signal.StopLossPrice);
            var reward = Math.Abs(Signal.TargetPrice - Signal.EntryPrice);
            return risk > 0 ? Math.Round(reward / risk, 1) : 0;
        }
    }

    private bool IsStale => (DateTime.UtcNow - Signal.DetectedAt).TotalHours > 24;

    private string GetElapsedText()
    {
        var elapsed = DateTime.UtcNow - Signal.DetectedAt;
        if (elapsed.TotalMinutes < 5) return "방금";
        if (elapsed.TotalMinutes < 60) return $"{(int)elapsed.TotalMinutes}분 전";
        if (elapsed.TotalHours < 24) return $"{(int)elapsed.TotalHours}시간 전";
        return $"{(int)elapsed.TotalDays}일 전";
    }
}
