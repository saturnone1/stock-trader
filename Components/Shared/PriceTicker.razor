@using StockTrader.Models
@using StockTrader.Services.Notification
@using System.Collections.Concurrent
@inject INotificationService NotificationService
@implements IDisposable

@if (_prices.Count > 0)
{
    <MudStack Row="true" Spacing="1" Class="mt-2 flex-wrap">
        @foreach (var kv in _prices)
        {
            var p = kv.Value;
            <MudChip T="string"
                     Color="@(p.ChangePercent >= 0 ? Color.Success : Color.Error)"
                     Variant="Variant.Outlined"
                     Size="Size.Small">
                @p.Symbol $@p.Price.ToString("F2") (@(p.ChangePercent >= 0 ? "+" : "")@p.ChangePercent.ToString("F2")%)
            </MudChip>
        }
    </MudStack>
}
else
{
    @* CLS 방지: 데이터 없을 때 동일 높이의 플레이스홀더로 레이아웃 공간 확보 *@
    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2 pa-1">실시간 시세 대기 중...</MudText>
}

@code {
    // Fix 5: lock 제거 - ConcurrentDictionary로 thread-safe 업데이트 구현
    // OnPriceUpdate는 백그라운드 스레드에서 호출될 수 있으므로 lock 없이 안전한 컬렉션 사용
    private readonly ConcurrentDictionary<string, PriceUpdate> _prices =
        new(StringComparer.OrdinalIgnoreCase);
    private DateTime _lastRender = DateTime.MinValue;
    private Timer? _throttleTimer;
    private volatile bool _pendingUpdate;

    protected override void OnInitialized()
    {
        NotificationService.OnPriceUpdate += OnPriceUpdate;
        _throttleTimer = new Timer(ThrottleCallback, null, 500, 500);
    }

    private void OnPriceUpdate(PriceUpdate update)
    {
        // ConcurrentDictionary.indexer setter는 atomic하므로 별도 lock 불필요
        _prices[update.Symbol] = update;
        _pendingUpdate = true;
    }

    private void ThrottleCallback(object? state)
    {
        if (!_pendingUpdate) return;
        _pendingUpdate = false;

        _ = InvokeAsync(() =>
        {
            try { StateHasChanged(); }
            catch (ObjectDisposedException) { }
        });
    }

    public void Dispose()
    {
        NotificationService.OnPriceUpdate -= OnPriceUpdate;
        _throttleTimer?.Dispose();
    }
}
