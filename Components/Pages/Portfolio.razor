@page "/portfolio"
@rendermode InteractiveServer
@using StockTrader.Models
@using StockTrader.Models.Enums
@using StockTrader.Data.Repositories
@using StockTrader.Services.Account
@inject ITradeRepository TradeRepo
@inject IPatternStatsRepository StatsRepo
@inject IAccountManager AccountManager
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@implements IDisposable

<PageTitle>포트폴리오 분석 - 주식 트레이더</PageTitle>

<div class="page-header">
    <MudText Typo="Typo.h5">포트폴리오 분석</MudText>
    <MudIconButton Icon="@Icons.Material.Filled.HelpOutline" Size="Size.Small" Color="Color.Default" OnClick="@(() => _showHelp = true)" title="도움말" />
</div>
<MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3 page-description">실시간 포트폴리오 현황과 과거 성과를 분석하세요.</MudText>

<MudDialog @bind-Visible="_showHelp">
    <TitleContent><MudText Typo="Typo.h6">포트폴리오 분석 도움말</MudText></TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-2">상단은 현재 보유 중인 포지션, 하단은 과거 성과 분석입니다.</MudText>
        <MudList T="string" Dense="true">
            <MudListItem Icon="@Icons.Material.Filled.Circle" IconSize="Size.Small" IconColor="Color.Primary">
                <strong>실시간 포트폴리오</strong>: 청산 전에도 항상 표시. 미실현 손익 기준
            </MudListItem>
            <MudListItem Icon="@Icons.Material.Filled.Circle" IconSize="Size.Small" IconColor="Color.Primary">
                <strong>수익 곡선</strong>: 누적 손익의 시간 흐름. 우상향이면 양호
            </MudListItem>
            <MudListItem Icon="@Icons.Material.Filled.Circle" IconSize="Size.Small" IconColor="Color.Primary">
                <strong>드로다운</strong>: 최고점 대비 하락폭. -20% 이내면 양호
            </MudListItem>
            <MudListItem Icon="@Icons.Material.Filled.Circle" IconSize="Size.Small" IconColor="Color.Primary">
                <strong>손익비</strong>: 총 수익 / 총 손실. 1.5 이상이면 양호
            </MudListItem>
        </MudList>
    </DialogContent>
    <DialogActions><MudButton OnClick="@(() => _showHelp = false)">닫기</MudButton></DialogActions>
</MudDialog>

@if (_loading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-2" />
}
@if (_error != null)
{
    <MudAlert Severity="Severity.Error" Class="mb-2" ShowCloseIcon="true" CloseIconClicked="() => _error = null">@_error</MudAlert>
}

@* ════════════════════════════════════════════════════
   실시간 포트폴리오 섹션 — 포지션이 없어도 항상 표시
   ════════════════════════════════════════════════════ *@
<MudCard Class="mb-4" Style="border: 1px solid rgba(255,255,255,0.08);">
    <MudCardHeader>
        <CardHeaderContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.AccountBalance" Color="Color.Primary" Size="Size.Small" />
                <MudText Typo="Typo.h6">실시간 포트폴리오</MudText>
                @if (_openPositions.Count > 0)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled"
                             Style="height:20px; font-size:11px; padding:0 8px; min-width:0;">
                        @_openPositions.Count 종목 보유중
                    </MudChip>
                }
                <MudSpacer />
                <MudTooltip Text="포지션 새로고침">
                    <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Small"
                                   Color="Color.Default" OnClick="LoadOpenPositionsAsync" />
                </MudTooltip>
            </MudStack>
        </CardHeaderContent>
    </MudCardHeader>
    <MudCardContent Class="pt-0">

        @{
            var totalPositions  = _openPositions.Count;
            var totalInvested   = _openPositions.Sum(p => p.EntryPrice * p.Quantity);
            var totalUnrealized = _openPositions.Sum(p => p.UnrealizedPnL);
            var unrealizedPct   = totalInvested > 0 ? totalUnrealized / totalInvested : 0m;
            var winningCount    = _openPositions.Count(p => p.UnrealizedPnL >= 0);
            var losingCount     = _openPositions.Count(p => p.UnrealizedPnL < 0);
        }

        @* 포트폴리오 요약 카드 *@
        <MudGrid Class="mb-3">
            <MudItem xs="6" sm="3">
                <MudPaper Class="pa-3 text-center" Style="background: rgba(255,255,255,0.03);" Elevation="0" Outlined="true">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">보유 포지션</MudText>
                    <MudText Typo="Typo.h5" Color="Color.Info">@totalPositions</MudText>
                    @if (totalPositions > 0)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            수익 @winningCount / 손실 @losingCount
                        </MudText>
                    }
                </MudPaper>
            </MudItem>
            <MudItem xs="6" sm="3">
                <MudPaper Class="pa-3 text-center" Style="background: rgba(255,255,255,0.03);" Elevation="0" Outlined="true">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">총 투자금</MudText>
                    <MudText Typo="Typo.h5">@(totalInvested > 0 ? "$" + totalInvested.ToString("N0") : "-")</MudText>
                    @if (totalPositions > 0)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            평균 $@(totalPositions > 0 ? (totalInvested / totalPositions).ToString("N0") : "0")/포지션
                        </MudText>
                    }
                </MudPaper>
            </MudItem>
            <MudItem xs="6" sm="3">
                <MudPaper Class="pa-3 text-center"
                          Style="@($"background: rgba({(totalUnrealized >= 0 ? "46,125,50" : "198,40,40")},0.08);")"
                          Elevation="0" Outlined="true">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">미실현 손익</MudText>
                    <MudText Typo="Typo.h5" Color="@(totalUnrealized >= 0 ? Color.Success : Color.Error)">
                        @(totalUnrealized >= 0 ? "+" : "")$@totalUnrealized.ToString("N2")
                    </MudText>
                    @if (totalPositions > 0)
                    {
                        <MudText Typo="Typo.caption" Color="@(totalUnrealized >= 0 ? Color.Success : Color.Error)">
                            @(unrealizedPct >= 0 ? "+" : "")@unrealizedPct.ToString("P2")
                        </MudText>
                    }
                </MudPaper>
            </MudItem>
            <MudItem xs="6" sm="3">
                <MudPaper Class="pa-3 text-center" Style="background: rgba(255,255,255,0.03);" Elevation="0" Outlined="true">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">포지션 현황</MudText>
                    @if (totalPositions > 0)
                    {
                        <MudStack Row="true" Justify="Justify.Center" Spacing="1" Class="mt-1">
                            @if (winningCount > 0)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled"
                                         Style="height:22px; font-size:11px;">
                                    수익 @winningCount
                                </MudChip>
                            }
                            @if (losingCount > 0)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Filled"
                                         Style="height:22px; font-size:11px;">
                                    손실 @losingCount
                                </MudChip>
                            }
                        </MudStack>
                    }
                    else
                    {
                        <MudText Typo="Typo.h5" Color="Color.Secondary">-</MudText>
                    }
                </MudPaper>
            </MudItem>
        </MudGrid>

        @if (_openPositions.Count > 0)
        {
            @* 포지션 상세 테이블 *@
            <div class="table-scroll-wrapper mb-3">
            <MudTable Items="@_openPositions" Dense="true" Hover="true" Striped="true" SortLabel="정렬"
                      RowStyleFunc="@((StockTrader.Models.Position p, int _) => p.UnrealizedPnL >= 0
                          ? "background: rgba(46,125,50,0.06);"
                          : "background: rgba(198,40,40,0.06);")">
                <HeaderContent>
                    <MudTh><MudTableSortLabel SortBy="new Func<StockTrader.Models.Position, object>(x => x.Symbol)">종목</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortBy="new Func<StockTrader.Models.Position, object>(x => x.PatternType)">패턴</MudTableSortLabel></MudTh>
                    <MudTh>수량</MudTh>
                    <MudTh><MudTableSortLabel SortBy="new Func<StockTrader.Models.Position, object>(x => x.EntryPrice)">진입가</MudTableSortLabel></MudTh>
                    <MudTh>현재가</MudTh>
                    <MudTh><MudTableSortLabel InitialDirection="MudBlazor.SortDirection.Descending" SortBy="new Func<StockTrader.Models.Position, object>(x => x.UnrealizedPnL)">미실현 손익</MudTableSortLabel></MudTh>
                    <MudTh>수익률</MudTh>
                    <MudTh>손절가</MudTh>
                    <MudTh>목표가</MudTh>
                    <MudTh>보유기간</MudTh>
                    <MudTh Style="min-width: 90px;">청산</MudTh>
                </HeaderContent>
                <RowTemplate>
                    @{
                        var pMeta    = PatternMetadataMap.Get(context.PatternType);
                        var holdDays = (DateTime.UtcNow - context.OpenedAt).TotalDays;
                        var pnlPct   = context.EntryPrice > 0
                                       ? (context.CurrentPrice - context.EntryPrice) / context.EntryPrice
                                       : 0m;
                        var isProfit = context.UnrealizedPnL >= 0;
                    }
                    <MudTd>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            <b>@context.Symbol</b>
                            @if (!string.IsNullOrWhiteSpace(context.Sector))
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@context.Sector</MudText>
                            }
                        </MudStack>
                    </MudTd>
                    <MudTd>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            <MudText Typo="Typo.body2" Style="white-space:nowrap;">@pMeta.KoreanName</MudText>
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Filled"
                                     Color="@PatternMetadataMap.GetMudColor(context.PatternType)"
                                     Style="height:18px; font-size:10px; padding:0 6px; min-width:0;">
                                @pMeta.StyleLabel
                            </MudChip>
                        </MudStack>
                    </MudTd>
                    <MudTd>@(context.Quantity)주</MudTd>
                    <MudTd>$@context.EntryPrice.ToString("F2")</MudTd>
                    <MudTd>
                        @if (context.CurrentPrice > 0)
                        {
                            <MudText Color="@(isProfit ? Color.Success : Color.Error)">
                                $@context.CurrentPrice.ToString("F2")
                            </MudText>
                        }
                        else
                        {
                            <MudText Color="Color.Secondary">-</MudText>
                        }
                    </MudTd>
                    <MudTd>
                        <MudText Typo="Typo.body1" Color="@(isProfit ? Color.Success : Color.Error)"
                                 Style="font-weight:600;">
                            @(isProfit ? "+" : "")$@context.UnrealizedPnL.ToString("N2")
                        </MudText>
                    </MudTd>
                    <MudTd>
                        <MudText Color="@(isProfit ? Color.Success : Color.Error)">
                            @(pnlPct >= 0 ? "+" : "")@pnlPct.ToString("P2")
                        </MudText>
                    </MudTd>
                    <MudTd><MudText Color="Color.Error">$@context.StopLossPrice.ToString("F2")</MudText></MudTd>
                    <MudTd><MudText Color="Color.Success">$@context.TargetPrice.ToString("F2")</MudText></MudTd>
                    <MudTd>
                        <MudText Typo="Typo.caption">
                            @(holdDays < 1 ? "당일" : $"{holdDays:F0}일")
                        </MudText>
                    </MudTd>
                    <MudTd>
                        <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.ExitToApp"
                                   Disabled="@(_closingSymbol == context.Symbol)"
                                   OnClick="@(() => ClosePositionAsync(context.Symbol))"
                                   Style="min-width: 72px;">
                            @if (_closingSymbol == context.Symbol)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
                            }
                            청산
                        </MudButton>
                    </MudTd>
                </RowTemplate>
            </MudTable>
            </div>@* /table-scroll-wrapper *@

            @* 섹터별 배분 *@
            @if (_openPositions.Any(p => !string.IsNullOrWhiteSpace(p.Sector)))
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary"
                         Style="font-weight:600; letter-spacing:0.04em; text-transform:uppercase;"
                         Class="mb-2 d-block">
                    섹터별 배분
                </MudText>
                <MudDivider Class="mb-2" />
                <MudGrid Class="mb-2">
                    @foreach (var sg in _openPositions.Where(p => !string.IsNullOrWhiteSpace(p.Sector)).GroupBy(p => p.Sector).OrderByDescending(g => g.Sum(p => p.EntryPrice * p.Quantity)))
                    {
                        var sectorValue  = sg.Sum(p => p.EntryPrice * p.Quantity);
                        var sectorPct    = totalInvested > 0 ? sectorValue / totalInvested : 0m;
                        var sectorPnl    = sg.Sum(p => p.UnrealizedPnL);
                        <MudItem xs="12" sm="6" md="4">
                            <MudPaper Class="pa-2" Elevation="0" Outlined="true"
                                      Style="background: rgba(255,255,255,0.02);">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                    <MudStack Spacing="0">
                                        <MudText Typo="Typo.body2"><b>@sg.Key</b></MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                            @sg.Count()종목 · $@sectorValue.ToString("N0") (@sectorPct.ToString("P0"))
                                        </MudText>
                                    </MudStack>
                                    <MudText Typo="Typo.body2" Color="@(sectorPnl >= 0 ? Color.Success : Color.Error)">
                                        @(sectorPnl >= 0 ? "+" : "")$@sectorPnl.ToString("N2")
                                    </MudText>
                                </MudStack>
                            </MudPaper>
                        </MudItem>
                    }
                </MudGrid>
            }
        }
        else if (!_loading)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Text">
                현재 보유 중인 포지션이 없습니다. 포지션이 열리면 여기서 실시간으로 확인할 수 있습니다.
            </MudAlert>
        }

    </MudCardContent>
</MudCard>

@* ════════════════════════════════════════════════════
   과거 성과 분석 섹션 — 청산된 거래가 있을 때만 표시
   ════════════════════════════════════════════════════ *@
<MudCard Style="border: 1px solid rgba(255,255,255,0.08);">
    <MudCardHeader>
        <CardHeaderContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.Analytics" Color="Color.Secondary" Size="Size.Small" />
                <MudText Typo="Typo.h6">과거 성과 분석</MudText>
                @if (_trades.Count > 0)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined"
                             Style="height:20px; font-size:11px; padding:0 8px; min-width:0;">
                        @_trades.Count 거래
                    </MudChip>
                }
            </MudStack>
        </CardHeaderContent>
    </MudCardHeader>
    <MudCardContent Class="pt-0">

        @* 기간 선택 *@
        <MudStack Row="true" Spacing="2" Class="mb-3" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
            <MudDatePicker @bind-Date="_from" Label="시작일" Variant="Variant.Outlined" Margin="Margin.Dense" />
            <MudDatePicker @bind-Date="_to" Label="종료일" Variant="Variant.Outlined" Margin="Margin.Dense" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="LoadHistoricalAsync" Disabled="_loading">
                @if (_loading)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                }
                분석
            </MudButton>
        </MudStack>

        @if (_trades.Count == 0 && !_loading)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Text">
                청산된 거래 기록이 없습니다. 거래가 종료되면 성과 분석이 여기에 표시됩니다.
            </MudAlert>
        }

        @if (_trades.Count > 0)
        {
            @* 요약 지표 *@
            <MudGrid Class="mb-4">
                <MudItem xs="6" md="2">
                    <MudCard>
                        <MudCardContent Class="text-center py-2">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">총 손익</MudText>
                            <MudText Typo="Typo.h6" Color="@(_totalPnl >= 0 ? Color.Success : Color.Error)">
                                $@_totalPnl.ToString("N2")
                            </MudText>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
                <MudItem xs="6" md="2">
                    <MudCard>
                        <MudCardContent Class="text-center py-2">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">승률</MudText>
                            <MudText Typo="Typo.h6">@_winRate.ToString("P1")</MudText>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
                <MudItem xs="6" md="2">
                    <MudCard>
                        <MudCardContent Class="text-center py-2">
                            <MudTooltip Text="최고점 대비 최대 하락폭. -20% 이내면 양호" Placement="Placement.Top">
                                <MudText Typo="Typo.caption" Color="Color.Secondary" Style="cursor:help">최대 낙폭 ⓘ</MudText>
                            </MudTooltip>
                            <MudText Typo="Typo.h6" Color="Color.Error">@_maxDrawdown.ToString("P2")</MudText>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
                <MudItem xs="6" md="2">
                    <MudCard>
                        <MudCardContent Class="text-center py-2">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">총 거래</MudText>
                            <MudText Typo="Typo.h6">@_trades.Count</MudText>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
                <MudItem xs="6" md="2">
                    <MudCard>
                        <MudCardContent Class="text-center py-2">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">평균 손익</MudText>
                            <MudText Typo="Typo.h6" Color="@(_avgPnl >= 0 ? Color.Success : Color.Error)">
                                $@_avgPnl.ToString("N2")
                            </MudText>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
                <MudItem xs="6" md="2">
                    <MudCard>
                        <MudCardContent Class="text-center py-2">
                            <MudTooltip Text="총 수익 / 총 손실. 1.5 이상이면 양호" Placement="Placement.Top">
                                <MudText Typo="Typo.caption" Color="Color.Secondary" Style="cursor:help">손익비 ⓘ</MudText>
                            </MudTooltip>
                            <MudText Typo="Typo.h6" Color="@(_profitFactor >= 1 ? Color.Success : Color.Error)">
                                @_profitFactor.ToString("F2")
                            </MudText>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            </MudGrid>

            @* 리스크 지표 *@
            <MudGrid Class="mb-4">
                <MudItem xs="6" md="3">
                    <MudCard>
                        <MudCardContent Class="text-center py-2">
                            <MudTooltip Text="위험 조정 수익률. 1.0 이상이면 양호, 2.0 이상이면 매우 우수" Placement="Placement.Top">
                                <MudText Typo="Typo.caption" Color="Color.Secondary" Style="cursor:help">Sharpe Ratio ⓘ</MudText>
                            </MudTooltip>
                            <MudText Typo="Typo.h6" Color="@(_sharpeRatio >= 1 ? Color.Success : _sharpeRatio >= 0 ? Color.Warning : Color.Error)">
                                @_sharpeRatio.ToString("F2")
                            </MudText>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
                <MudItem xs="6" md="3">
                    <MudCard>
                        <MudCardContent Class="text-center py-2">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">최대 연승</MudText>
                            <MudText Typo="Typo.h6" Color="Color.Success">@_maxConsecutiveWins</MudText>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
                <MudItem xs="6" md="3">
                    <MudCard>
                        <MudCardContent Class="text-center py-2">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">최대 연패</MudText>
                            <MudText Typo="Typo.h6" Color="Color.Error">@_maxConsecutiveLosses</MudText>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
                <MudItem xs="6" md="3">
                    <MudCard>
                        <MudCardContent Class="text-center py-2">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">평균 보유기간</MudText>
                            <MudText Typo="Typo.h6">@_avgHoldingDays.ToString("F1")일</MudText>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            </MudGrid>

            @* 수익 곡선 *@
            <MudCard Class="mb-4">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">수익 곡선</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent Class="pa-3 pt-0">
                <ApexCharts.ApexChart TItem="EquityDataPoint" Options="_equityOpts" Height="@(IsMobile ? 180 : 300)">
                    <ApexCharts.ApexPointSeries TItem="EquityDataPoint"
                        Items="_equityCurve"
                        SeriesType="ApexCharts.SeriesType.Area"
                        XValue="@(e => e.Date.ToString("yyyy-MM-dd"))"
                        YAggregate="@(e => e.Last().Value)"
                        Name="누적 손익" />
                </ApexCharts.ApexChart>
                </MudCardContent>
            </MudCard>

            @* 드로다운 *@
            <MudCard Class="mb-4">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">드로다운</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent Class="pa-3 pt-0">
                <ApexCharts.ApexChart TItem="EquityDataPoint" Options="_drawdownOpts" Height="@(IsMobile ? 160 : 250)">
                    <ApexCharts.ApexPointSeries TItem="EquityDataPoint"
                        Items="_drawdownCurve"
                        SeriesType="ApexCharts.SeriesType.Area"
                        XValue="@(e => e.Date.ToString("yyyy-MM-dd"))"
                        YAggregate="@(e => e.Last().Value)"
                        Name="드로다운 %" />
                </ApexCharts.ApexChart>
                </MudCardContent>
            </MudCard>

            @* 패턴별 성과 *@
            @if (_patternPerf.Count > 0)
            {
                <MudText Typo="Typo.h6" Class="mb-2">패턴별 성과 비교</MudText>
                <MudGrid Class="mb-4">
                    <MudItem xs="12" md="6">
                        <MudCard Class="pa-3">
                            <MudText Typo="Typo.subtitle2" Class="mb-2">패턴별 총 손익</MudText>
                            <ApexCharts.ApexChart TItem="PatternPerfItem" Options="_barOpts" Height="@(IsMobile ? 180 : 300)">
                                <ApexCharts.ApexPointSeries TItem="PatternPerfItem"
                                    Items="_patternPerf"
                                    SeriesType="ApexCharts.SeriesType.Bar"
                                    XValue="@(p => p.Name)"
                                    YAggregate="@(p => p.First().TotalPnl)"
                                    Name="총 손익 ($)" />
                            </ApexCharts.ApexChart>
                        </MudCard>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudCard Class="pa-3">
                            <MudText Typo="Typo.subtitle2" Class="mb-2">패턴별 승률</MudText>
                            <ApexCharts.ApexChart TItem="PatternPerfItem" Options="_winRateOpts" Height="@(IsMobile ? 180 : 300)">
                                <ApexCharts.ApexPointSeries TItem="PatternPerfItem"
                                    Items="_patternPerf"
                                    SeriesType="ApexCharts.SeriesType.Bar"
                                    XValue="@(p => p.Name)"
                                    YAggregate="@(p => p.First().WinRatePct)"
                                    Name="승률 (%)" />
                            </ApexCharts.ApexChart>
                        </MudCard>
                    </MudItem>
                </MudGrid>

                <div class="table-scroll-wrapper">
                <MudTable Items="_patternPerf" Dense="true" Hover="true" Striped="true" Class="mb-4">
                    <HeaderContent>
                        <MudTh>패턴</MudTh>
                        <MudTh>거래수</MudTh>
                        <MudTh>승률</MudTh>
                        <MudTh>총 손익</MudTh>
                        <MudTh>평균 손익</MudTh>
                        <MudTh>최대 수익</MudTh>
                        <MudTh>최대 손실</MudTh>
                        <MudTh>손익비</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                @if (Enum.TryParse<PatternType>(context.Name, out var pt))
                                {
                                    <MudChip T="string" Size="Size.Small"
                                             Color="@PatternMetadataMap.GetMudColor(pt)"
                                             Variant="Variant.Filled"
                                             Style="height:20px; font-size:10px; padding:0 6px; min-width:0;">
                                        @PatternMetadataMap.GetKoreanName(pt)
                                    </MudChip>
                                }
                                else
                                {
                                    <b>@context.Name</b>
                                }
                            </MudStack>
                        </MudTd>
                        <MudTd>@context.TradeCount</MudTd>
                        <MudTd>@context.WinRatePct.ToString("F1")%</MudTd>
                        <MudTd>
                            <MudText Color="@(context.TotalPnl >= 0 ? Color.Success : Color.Error)">
                                $@context.TotalPnl.ToString("N2")
                            </MudText>
                        </MudTd>
                        <MudTd>
                            <MudText Color="@(context.AvgPnl >= 0 ? Color.Success : Color.Error)">
                                $@context.AvgPnl.ToString("N2")
                            </MudText>
                        </MudTd>
                        <MudTd><MudText Color="Color.Success">$@context.MaxWin.ToString("N2")</MudText></MudTd>
                        <MudTd><MudText Color="Color.Error">$@context.MaxLoss.ToString("N2")</MudText></MudTd>
                        <MudTd>
                            <MudText Color="@(context.ProfitFactor >= 1 ? Color.Success : Color.Error)">
                                @context.ProfitFactor.ToString("F2")
                            </MudText>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
                </div>@* /table-scroll-wrapper *@
            }

            @* 월별 손익 + 종목별 손익 *@
            <MudGrid Class="mb-4">
                <MudItem xs="12" md="6">
                    <MudCard>
                        <MudCardHeader>
                            <CardHeaderContent>
                                <MudText Typo="Typo.h6">월별 손익</MudText>
                            </CardHeaderContent>
                        </MudCardHeader>
                        <MudCardContent Class="pa-3 pt-0">
                        <ApexCharts.ApexChart TItem="EquityDataPoint" Options="_monthlyOpts" Height="@(IsMobile ? 160 : 250)">
                            <ApexCharts.ApexPointSeries TItem="EquityDataPoint"
                                Items="_monthlyPnl"
                                SeriesType="ApexCharts.SeriesType.Bar"
                                XValue="@(e => e.Date.ToString("yyyy-MM"))"
                                YAggregate="@(e => e.Sum(x => x.Value))"
                                Name="월별 손익 ($)" />
                        </ApexCharts.ApexChart>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudCard>
                        <MudCardHeader>
                            <CardHeaderContent>
                                <MudText Typo="Typo.h6">종목별 손익 (상위 10)</MudText>
                            </CardHeaderContent>
                        </MudCardHeader>
                        <MudCardContent Class="pa-3 pt-0">
                        <ApexCharts.ApexChart TItem="PatternPerfItem" Options="_symbolOpts" Height="@(IsMobile ? 160 : 250)">
                            <ApexCharts.ApexPointSeries TItem="PatternPerfItem"
                                Items="_topSymbols"
                                SeriesType="ApexCharts.SeriesType.Bar"
                                XValue="@(s => s.Name)"
                                YAggregate="@(s => s.First().TotalPnl)"
                                Name="손익 ($)" />
                        </ApexCharts.ApexChart>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            </MudGrid>
        }

    </MudCardContent>
</MudCard>

@code {
    [CascadingParameter(Name = "IsMobile")] public bool IsMobile { get; set; }

    private bool _showHelp;
    private System.Threading.Timer? _refreshTimer;

    // 청산 중인 종목 심볼 (로딩 표시 + 중복 클릭 방지)
    private string? _closingSymbol;

    // Open positions (live section)
    private List<StockTrader.Models.Position> _openPositions = new();

    // DB 정리는 첫 로드 시 한 번만 수행 (타이머 갱신 시 반복 방지)
    private bool _positionsInitialized;

    // Closed trades (historical section)
    private List<TradeRecord> _trades = new();
    private List<EquityDataPoint> _equityCurve = new();
    private List<EquityDataPoint> _drawdownCurve = new();
    private List<EquityDataPoint> _monthlyPnl = new();
    private List<PatternPerfItem> _patternPerf = new();
    private List<PatternPerfItem> _topSymbols = new();
    private DateTime? _from = DateTime.Today.AddYears(-1);
    private DateTime? _to = DateTime.Today;
    private bool _loading;
    private string? _error;
    private decimal _totalPnl, _avgPnl, _winRate, _maxDrawdown, _profitFactor;
    private decimal _sharpeRatio;
    private int _maxConsecutiveWins, _maxConsecutiveLosses;
    private decimal _avgHoldingDays;

    // Chart options
    private static readonly ApexCharts.ApexChartOptions<EquityDataPoint> _equityOpts = new()
    {
        Chart = new ApexCharts.Chart { Background = "transparent", ForeColor = "#9E9E9E" },
        Theme = new ApexCharts.Theme { Mode = ApexCharts.Mode.Dark },
        Stroke = new ApexCharts.Stroke { Curve = ApexCharts.Curve.Smooth, Width = 2 },
        Fill = new ApexCharts.Fill { Type = new List<ApexCharts.FillType> { ApexCharts.FillType.Gradient }, Opacity = new List<double> { 0.3 } },
        Yaxis = [new ApexCharts.YAxis { Labels = new ApexCharts.YAxisLabels { Formatter = @"function(v) { return '$' + v.toFixed(0) }" } }]
    };

    private static readonly ApexCharts.ApexChartOptions<EquityDataPoint> _drawdownOpts = new()
    {
        Chart = new ApexCharts.Chart { Background = "transparent", ForeColor = "#9E9E9E" },
        Theme = new ApexCharts.Theme { Mode = ApexCharts.Mode.Dark },
        Stroke = new ApexCharts.Stroke { Curve = ApexCharts.Curve.Stepline, Width = 2 },
        Colors = new List<string> { "#C62828" },
        Fill = new ApexCharts.Fill { Type = new List<ApexCharts.FillType> { ApexCharts.FillType.Gradient }, Opacity = new List<double> { 0.3 } },
        Yaxis = [new ApexCharts.YAxis { Labels = new ApexCharts.YAxisLabels { Formatter = @"function(v) { return v.toFixed(1) + '%' }" } }]
    };

    private static readonly ApexCharts.ApexChartOptions<PatternPerfItem> _barOpts = new()
    {
        Chart = new ApexCharts.Chart { Background = "transparent", ForeColor = "#9E9E9E" },
        Theme = new ApexCharts.Theme { Mode = ApexCharts.Mode.Dark },
        PlotOptions = new ApexCharts.PlotOptions { Bar = new ApexCharts.PlotOptionsBar { Horizontal = false } }
    };

    private static readonly ApexCharts.ApexChartOptions<PatternPerfItem> _winRateOpts = new()
    {
        Chart = new ApexCharts.Chart { Background = "transparent", ForeColor = "#9E9E9E" },
        Theme = new ApexCharts.Theme { Mode = ApexCharts.Mode.Dark },
        PlotOptions = new ApexCharts.PlotOptions { Bar = new ApexCharts.PlotOptionsBar { Horizontal = false } },
        Yaxis = [new ApexCharts.YAxis { Max = 100, Labels = new ApexCharts.YAxisLabels { Formatter = @"function(v) { return v.toFixed(0) + '%' }" } }]
    };

    private static readonly ApexCharts.ApexChartOptions<EquityDataPoint> _monthlyOpts = new()
    {
        Chart = new ApexCharts.Chart { Background = "transparent", ForeColor = "#9E9E9E" },
        Theme = new ApexCharts.Theme { Mode = ApexCharts.Mode.Dark },
        PlotOptions = new ApexCharts.PlotOptions { Bar = new ApexCharts.PlotOptionsBar { Horizontal = false } }
    };

    private static readonly ApexCharts.ApexChartOptions<PatternPerfItem> _symbolOpts = new()
    {
        Chart = new ApexCharts.Chart { Background = "transparent", ForeColor = "#9E9E9E" },
        Theme = new ApexCharts.Theme { Mode = ApexCharts.Mode.Dark },
        PlotOptions = new ApexCharts.PlotOptions { Bar = new ApexCharts.PlotOptionsBar { Horizontal = true } }
    };

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(
            LoadOpenPositionsAsync(),
            LoadHistoricalAsync()
        );

        // 30초마다 미실현 손익 자동 갱신
        _refreshTimer = new System.Threading.Timer(
            async _ =>
            {
                await LoadOpenPositionsAsync();
                await InvokeAsync(StateHasChanged);
            },
            state: null,
            dueTime: TimeSpan.FromSeconds(30),
            period: TimeSpan.FromSeconds(30));
    }

    public void Dispose()
    {
        _refreshTimer?.Dispose();
    }

    private async Task LoadOpenPositionsAsync()
    {
        try
        {
            // 1. 브로커에서 실시간 포지션 가져오기 시도
            var broker = await AccountManager.GetActiveBrokerServiceAsync();
            if (broker != null)
            {
                var brokerPositions = await broker.GetPositionsAsync();

                if (brokerPositions.Count > 0)
                {
                    // DB에서 추가 메타데이터(PatternType, StopLoss, Target 등) 보충
                    var dbPositions = await TradeRepo.GetOpenPositionsAsync();
                    foreach (var bp in brokerPositions)
                    {
                        var dbMatch = dbPositions.FirstOrDefault(d =>
                            d.Symbol.Equals(bp.Symbol, StringComparison.OrdinalIgnoreCase));
                        if (dbMatch != null)
                        {
                            bp.PatternType = dbMatch.PatternType;
                            bp.StopLossPrice = dbMatch.StopLossPrice;
                            bp.TargetPrice = dbMatch.TargetPrice;
                            bp.Sector = dbMatch.Sector;
                            bp.OpenedAt = dbMatch.OpenedAt;
                        }
                    }
                    _openPositions = brokerPositions;

                    // DB 정리: 첫 로드 시에만 수행 (타이머 30초 갱신 시 반복 방지)
                    if (!_positionsInitialized)
                    {
                        _positionsInitialized = true;
                        var dbPositions2 = await TradeRepo.GetOpenPositionsAsync();
                        foreach (var dbPos in dbPositions2)
                        {
                            if (!brokerPositions.Any(b =>
                                b.Symbol.Equals(dbPos.Symbol, StringComparison.OrdinalIgnoreCase)))
                            {
                                // DB에만 있고 브로커에 없음 → 이미 청산됨
                                var trackedPos = await TradeRepo.GetPositionAsync(dbPos.Id);
                                if (trackedPos != null && trackedPos.ClosedAt == null)
                                {
                                    trackedPos.ClosedAt = DateTime.UtcNow;
                                    await TradeRepo.SavePositionAsync(trackedPos);
                                }
                            }
                        }
                    }
                }
                else
                {
                    // 브로커에 포지션 0개 → 첫 로드 시 DB의 열린 포지션도 모두 정리
                    if (!_positionsInitialized)
                    {
                        _positionsInitialized = true;
                        var dbPositions = await TradeRepo.GetOpenPositionsAsync();
                        foreach (var dbPos in dbPositions)
                        {
                            var trackedPos = await TradeRepo.GetPositionAsync(dbPos.Id);
                            if (trackedPos != null && trackedPos.ClosedAt == null)
                            {
                                trackedPos.ClosedAt = DateTime.UtcNow;
                                await TradeRepo.SavePositionAsync(trackedPos);
                            }
                        }
                    }
                    _openPositions = new List<StockTrader.Models.Position>();
                }
                return;
            }

            // 2. 브로커 없으면 DB 폴백
            _openPositions = await TradeRepo.GetOpenPositionsAsync();
        }
        catch (Exception ex)
        {
            // 브로커 API 실패 시 DB 폴백
            try
            {
                _openPositions = await TradeRepo.GetOpenPositionsAsync();
            }
            catch { }
            _error = $"포지션 로드 실패: {ex.Message}";
        }
    }

    private async Task ClosePositionAsync(string symbol)
    {
        // 확인 대화상자 — 실수로 청산하는 사고 방지
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { x => x.Title, "포지션 청산" },
            { x => x.Message, $"{symbol} 포지션을 전량 청산하시겠습니까?" },
            { x => x.ConfirmText, "청산" },
            { x => x.ConfirmColor, Color.Error }
        };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>("포지션 청산", parameters);
        var result = await dialog.Result;
        if (result is null || result.Canceled) return;

        _closingSymbol = symbol;
        StateHasChanged();
        try
        {
            var broker = await AccountManager.GetActiveBrokerServiceAsync();
            if (broker == null)
            {
                Snackbar.Add("활성 계좌가 없습니다. 설정에서 계좌를 추가하세요.", Severity.Warning);
                return;
            }

            var success = await broker.ClosePositionAsync(symbol);
            if (success)
            {
                Snackbar.Add($"✓ {symbol} 청산 완료", Severity.Success);
                // DB 포지션 ClosedAt 마킹 — PositionExitManagerService 재청산 시도 방지
                var dbPositions = await TradeRepo.GetOpenPositionsAsync();
                foreach (var dbPos in dbPositions.Where(p =>
                    p.Symbol.Equals(symbol, StringComparison.OrdinalIgnoreCase)))
                {
                    var tracked = await TradeRepo.GetPositionAsync(dbPos.Id);
                    if (tracked != null && tracked.ClosedAt == null)
                    {
                        tracked.ClosedAt = DateTime.UtcNow;
                        await TradeRepo.SavePositionAsync(tracked);
                    }
                }
                // 브로커 응답을 기다리지 않고 즉시 UI에서 제거
                _openPositions.RemoveAll(p => p.Symbol == symbol);
            }
            else
            {
                Snackbar.Add($"{symbol} 청산 실패: 브로커에서 거부됨", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{symbol} 청산 실패: {ex.Message}", Severity.Error);
        }
        finally
        {
            _closingSymbol = null;
            StateHasChanged();
        }
    }

    private async Task LoadHistoricalAsync()
    {
        _loading = true;
        _error = null;
        StateHasChanged();

        try
        {
            _trades = await TradeRepo.GetTradesAsync(from: _from, to: _to);
            if (_trades.Count == 0)
            {
                _totalPnl = 0; _avgPnl = 0; _winRate = 0; _maxDrawdown = 0; _profitFactor = 0;
                _sharpeRatio = 0; _maxConsecutiveWins = 0; _maxConsecutiveLosses = 0; _avgHoldingDays = 0;
                _equityCurve = new(); _drawdownCurve = new();
                _monthlyPnl = new(); _patternPerf = new(); _topSymbols = new();
                return;
            }

            _trades = _trades.OrderBy(t => t.ExitTime).ToList();
            ComputeMetrics();
            ComputeEquityCurve();
            ComputePatternPerformance();
            ComputeMonthlyPnl();
            ComputeTopSymbols();
            ComputeRiskMetrics();
        }
        catch (Exception ex)
        {
            _error = $"포트폴리오 데이터 로드 실패: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private void ComputeMetrics()
    {
        var localCount = _trades.Count;
        if (localCount == 0) return;

        _totalPnl = _trades.Sum(t => t.PnL);
        _avgPnl = _totalPnl / localCount;
        _winRate = (decimal)_trades.Count(t => t.IsWin) / localCount;

        var totalWins = _trades.Where(t => t.IsWin).Sum(t => t.PnL);
        var totalLosses = Math.Abs(_trades.Where(t => !t.IsWin).Sum(t => t.PnL));
        _profitFactor = totalLosses > 0 ? totalWins / totalLosses : totalWins > 0 ? 999 : 0;
    }

    private void ComputeEquityCurve()
    {
        _equityCurve = new();
        _drawdownCurve = new();

        var cumPnl = 0m;
        // 드로다운 기준점: 초기 자본을 0으로 보고, 누적 PnL의 고점에서 현재까지의 낙폭을 추적한다.
        // 기존 코드의 `peak > 0` 조건은 거래 전부 손실인 경우 peak=0 유지 → 드로다운 항상 0%
        // 버그를 유발했다. 초기 기준점(0)도 peak의 시작값으로 취급하여 손실 구간을 올바르게 표시한다.
        // peak 초기값은 0 (초기 자본 기준점)이므로 누적 손실 발생 시 dd > 0이 된다.
        var peak = 0m; // 초기 기준점 = 0 (손실만 있으면 peak는 0에 머물고 dd는 양수)
        _maxDrawdown = 0;

        foreach (var trade in _trades)
        {
            cumPnl += trade.PnL;
            if (cumPnl > peak) peak = cumPnl;
            // peak == 0이고 cumPnl < 0인 경우(초기 손실 구간)에도 드로다운을 올바르게 계산한다.
            // 분모가 0이 될 수 없도록: peak != 0이면 % 기준, peak == 0이면 절대 손실 금액을 사용한다.
            // 단, 차트 y축이 통일된 단위(%/금액 혼용 방지)를 위해 peak=0 구간도 금액 절댓값으로 일관 처리.
            var dd = peak != 0
                ? (peak - cumPnl) / Math.Abs(peak) * 100
                : cumPnl < 0 ? Math.Abs(cumPnl) : 0m;
            if (dd / 100 > _maxDrawdown) _maxDrawdown = dd / 100;

            _equityCurve.Add(new EquityDataPoint(trade.ExitTime, cumPnl));
            _drawdownCurve.Add(new EquityDataPoint(trade.ExitTime, -dd));
        }
    }

    private void ComputePatternPerformance()
    {
        _patternPerf = _trades
            .GroupBy(t => t.PatternType)
            .Select(g =>
            {
                var all = g.ToList();
                var wins = all.Where(t => t.IsWin).ToList();
                var losses = all.Where(t => !t.IsWin).ToList();
                var totalWin = wins.Sum(t => t.PnL);
                var totalLoss = Math.Abs(losses.Sum(t => t.PnL));
                return new PatternPerfItem
                {
                    Name = PatternMetadataMap.GetKoreanName(g.Key),
                    TradeCount = all.Count,
                    WinRatePct = all.Count > 0 ? (decimal)wins.Count / all.Count * 100 : 0,
                    TotalPnl = all.Sum(t => t.PnL),
                    AvgPnl = all.Average(t => t.PnL),
                    MaxWin = all.Max(t => t.PnL),
                    MaxLoss = all.Min(t => t.PnL),
                    ProfitFactor = totalLoss > 0 ? totalWin / totalLoss : totalWin > 0 ? 999 : 0
                };
            })
            .OrderByDescending(p => p.TotalPnl)
            .ToList();
    }

    private void ComputeMonthlyPnl()
    {
        _monthlyPnl = _trades
            .GroupBy(t => new DateTime(t.ExitTime.Year, t.ExitTime.Month, 1))
            .OrderBy(g => g.Key)
            .Select(g => new EquityDataPoint(g.Key, g.Sum(t => t.PnL)))
            .ToList();
    }

    private void ComputeTopSymbols()
    {
        _topSymbols = _trades
            .GroupBy(t => t.Symbol)
            .Select(g => new PatternPerfItem
            {
                Name = g.Key,
                TradeCount = g.Count(),
                TotalPnl = g.Sum(t => t.PnL),
                AvgPnl = g.Average(t => t.PnL),
                WinRatePct = g.Count() > 0 ? (decimal)g.Count(t => t.IsWin) / g.Count() * 100 : 0,
                MaxWin = g.Max(t => t.PnL),
                MaxLoss = g.Min(t => t.PnL),
                ProfitFactor = 0
            })
            .OrderByDescending(s => Math.Abs(s.TotalPnl))
            .Take(10)
            .ToList();
    }

    private void ComputeRiskMetrics()
    {
        if (_trades.Count > 1)
        {
            var returns = _trades.Select(t => (double)t.PnLPercent).ToArray();
            var avgReturn = returns.Average();
            var variance = returns.Select(r => Math.Pow(r - avgReturn, 2)).Sum() / (returns.Length - 1);
            var stdDev = Math.Sqrt(variance);
            var avgHoldingDays = Math.Max(1.0, _trades.Average(t => (t.ExitTime - t.EntryTime).TotalDays));
            var tradesPerYear = Math.Min(252.0, 252.0 / avgHoldingDays);
            var rawSharpe = stdDev > 0
                ? avgReturn / stdDev * Math.Sqrt(tradesPerYear)
                : 0.0;
            _sharpeRatio = (decimal)Math.Clamp(rawSharpe, -10.0, 10.0);
        }

        int curWins = 0, curLosses = 0;
        _maxConsecutiveWins = 0;
        _maxConsecutiveLosses = 0;
        foreach (var t in _trades)
        {
            if (t.IsWin) { curWins++; curLosses = 0; }
            else { curLosses++; curWins = 0; }
            _maxConsecutiveWins = Math.Max(_maxConsecutiveWins, curWins);
            _maxConsecutiveLosses = Math.Max(_maxConsecutiveLosses, curLosses);
        }

        _avgHoldingDays = (decimal)_trades.Average(t => (t.ExitTime - t.EntryTime).TotalDays);
    }

    public record EquityDataPoint(DateTime Date, decimal Value);

    public class PatternPerfItem
    {
        public string Name { get; set; } = "";
        public int TradeCount { get; set; }
        public decimal WinRatePct { get; set; }
        public decimal TotalPnl { get; set; }
        public decimal AvgPnl { get; set; }
        public decimal MaxWin { get; set; }
        public decimal MaxLoss { get; set; }
        public decimal ProfitFactor { get; set; }
    }
