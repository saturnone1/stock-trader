@page "/patterns"
@rendermode InteractiveServer
@using StockTrader.Models
@using StockTrader.Models.Enums
@using StockTrader.Services.Statistics
@using StockTrader.Data.Repositories
@inject IStatisticsService StatsService
@inject ITradeRepository TradeRepo

<PageTitle>패턴 통계 - 주식 트레이더</PageTitle>

<div class="page-header">
    <MudText Typo="Typo.h5">패턴 통계</MudText>
    <MudIconButton Icon="@Icons.Material.Filled.HelpOutline" Size="Size.Small" Color="Color.Default" OnClick="@(() => _showHelp = true)" title="도움말" />
    <MudTooltip Text="새로고침">
        <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Small"
                       Color="Color.Default" OnClick="@ManualRefreshAsync"
                       Disabled="@_loading" />
    </MudTooltip>
</div>
<MudText Typo="Typo.body2" Color="Color.Secondary">기대값 = 승률 x 평균수익 - (1 - 승률) x 평균손실</MudText>
<MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3 page-description">각 패턴의 과거 성과를 기반으로 한 통계 지표입니다. 기대값이 양수인 패턴이 장기적으로 수익을 낼 가능성이 높습니다.</MudText>

<MudDialog @bind-Visible="_showHelp">
    <TitleContent><MudText Typo="Typo.h6">패턴 통계 도움말</MudText></TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-2">각 매매 패턴의 과거 실적을 수치로 비교합니다.</MudText>
        <MudList T="string" Dense="true">
            <MudListItem Icon="@Icons.Material.Filled.Circle" IconSize="Size.Small" IconColor="Color.Primary">
                <strong>기대값</strong>: 거래 1회당 기대 수익률. 양수여야 수익 가능
            </MudListItem>
            <MudListItem Icon="@Icons.Material.Filled.Circle" IconSize="Size.Small" IconColor="Color.Primary">
                <strong>손익비</strong>: 총 수익 / 총 손실. 1.5 이상이면 양호
            </MudListItem>
            <MudListItem Icon="@Icons.Material.Filled.Circle" IconSize="Size.Small" IconColor="Color.Primary">
                <strong>표본 수</strong>: 거래 횟수. 20개 이상이어야 통계적으로 유의미
            </MudListItem>
            <MudListItem Icon="@Icons.Material.Filled.Circle" IconSize="Size.Small" IconColor="Color.Primary">
                <strong>최대 낙폭</strong>: 해당 패턴으로 겪을 수 있는 최대 손실
            </MudListItem>
            <MudListItem Icon="@Icons.Material.Filled.Circle" IconSize="Size.Small" IconColor="Color.Primary">
                <strong>스타일</strong>: 스캘핑(수시간) / 단타(1~3일) / 스윙(3~10일) / 포지션(5~15일)
            </MudListItem>
        </MudList>
    </DialogContent>
    <DialogActions><MudButton OnClick="@(() => _showHelp = false)">닫기</MudButton></DialogActions>
</MudDialog>

@if (_loading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-2" />
}
@if (_error != null)
{
    <MudAlert Severity="Severity.Error" Class="mb-2" ShowCloseIcon="true" CloseIconClicked="() => _error = null">@_error</MudAlert>
}

@* ── 섹션 1: 패턴 카탈로그 (항상 표시) ── *@
<MudText Typo="Typo.subtitle2" Class="mb-2"
         Style="font-weight:600; letter-spacing:0.04em; text-transform:uppercase; color: var(--mud-palette-text-secondary);">
    패턴 카탈로그
</MudText>
<MudDivider Class="mb-3" />

<div class="table-scroll-wrapper">
<MudTable Items="@_allPatterns" Dense="true" Hover="true" Striped="true" Class="mb-5"
          FixedHeader="true" Height="@(IsMobile ? "350px" : "500px")">
    <HeaderContent>
        <MudTh>패턴명</MudTh>
        <MudTh>스타일</MudTh>
        @if (!IsMobile)
        {
            <MudTh>보유기간</MudTh>
        }
        <MudTh>상태</MudTh>
        @if (!IsMobile)
        {
            <MudTh>설명</MudTh>
        }
    </HeaderContent>
    <RowTemplate>
        @{
            var meta = PatternMetadataMap.Get(context);
            var status = meta.Status;
            var statusColor = PatternMetadataMap.GetStatusColor(status);
        }
        <MudTd>
            <MudTooltip Text="@($"{meta.EnglishName}{(IsMobile ? $" | {meta.HoldingPeriod}" : "")}")">
                <MudText Typo="Typo.body2" Style="white-space: nowrap; font-weight: 500;">
                    @meta.KoreanName
                </MudText>
            </MudTooltip>
        </MudTd>
        <MudTd>
            <MudChip T="string"
                     Color="@PatternMetadataMap.GetMudColor(context)"
                     Size="Size.Small"
                     Variant="Variant.Filled"
                     Style="height:20px; font-size:11px; padding:0 8px; min-width:0;">
                @meta.StyleLabel
            </MudChip>
        </MudTd>
        @if (!IsMobile)
        {
            <MudTd>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Style="white-space:nowrap;">
                    @meta.HoldingPeriod
                </MudText>
            </MudTd>
        }
        <MudTd>
            @if (status == PatternStatus.Verified)
            {
                <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Outlined"
                         Icon="@Icons.Material.Filled.CheckCircle"
                         Style="height:20px; font-size:11px; padding:0 8px; min-width:0;">
                    검증됨
                </MudChip>
            }
            else
            {
                <MudTooltip Text="@(meta.StatusNote ?? "")">
                    <MudChip T="string" Color="@statusColor" Size="Size.Small" Variant="Variant.Outlined"
                             Icon="@PatternMetadataMap.GetStatusIcon(status)"
                             Style="height:20px; font-size:11px; padding:0 8px; min-width:0;">
                        @PatternMetadataMap.GetStatusLabel(status)
                    </MudChip>
                </MudTooltip>
            }
        </MudTd>
        @if (!IsMobile)
        {
            <MudTd>
                <MudTooltip Text="@meta.Description" Placement="Placement.Left">
                    <MudText Typo="Typo.caption" Color="Color.Secondary"
                             Style="max-width:300px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; display:block;">
                        @meta.Description
                    </MudText>
                </MudTooltip>
            </MudTd>
        }
    </RowTemplate>
</MudTable>
</div>@* /table-scroll-wrapper *@

@* ── 섹션 2: 시그널 활동 현황 ── *@
<MudText Typo="Typo.subtitle2" Class="mb-2"
         Style="font-weight:600; letter-spacing:0.04em; text-transform:uppercase; color: var(--mud-palette-text-secondary);">
    시그널 활동
</MudText>
<MudDivider Class="mb-3" />

@if (_signalRows.Count == 0 && _recentRecs.Count == 0)
{
    <MudAlert Severity="Severity.Info" Class="mb-5">
        아직 시그널 기록이 없습니다. 패턴 스캐너가 실행되면 여기에 활동 내역이 표시됩니다.
    </MudAlert>
}
else
{
    <MudGrid Class="mb-3">
        <MudItem xs="6" sm="3">
            <MudPaper Class="pa-3 text-center" Style="border: 1px solid var(--mud-palette-divider);">
                <MudText Typo="Typo.subtitle2" Color="Color.Secondary">총 시그널</MudText>
                <MudText Typo="Typo.h5">@_signalRows.Sum(r => r.Generated)</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" sm="3">
            <MudPaper Class="pa-3 text-center" Style="border: 1px solid var(--mud-palette-divider);">
                <MudText Typo="Typo.subtitle2" Color="Color.Secondary">활성 시그널</MudText>
                <MudText Typo="Typo.h5" Color="Color.Primary">@_activeSignalCount</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" sm="3">
            <MudPaper Class="pa-3 text-center" Style="border: 1px solid var(--mud-palette-divider);">
                <MudText Typo="Typo.subtitle2" Color="Color.Secondary">실행됨</MudText>
                <MudText Typo="Typo.h5" Color="Color.Success">@_signalRows.Sum(r => r.Executed)</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" sm="3">
            <MudPaper Class="pa-3 text-center" Style="border: 1px solid var(--mud-palette-divider);">
                <MudText Typo="Typo.subtitle2" Color="Color.Secondary">실행율</MudText>
                @{
                    var totalGen = _signalRows.Sum(r => r.Generated);
                    var totalExec = _signalRows.Sum(r => r.Executed);
                    var overallRate = totalGen > 0 ? (double)totalExec / totalGen * 100.0 : 0.0;
                }
                <MudText Typo="Typo.h5" Color="@(overallRate >= 50 ? Color.Success : Color.Warning)">
                    @overallRate.ToString("F0")%
                </MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    @if (_signalRows.Count > 0)
    {
        <div class="table-scroll-wrapper">
        <MudTable Items="@_signalRows" Dense="true" Hover="true" Class="mb-5">
            <HeaderContent>
                <MudTh>패턴</MudTh>
                @if (!IsMobile)
                {
                    <MudTh>스타일</MudTh>
                }
                <MudTh Style="text-align:right">생성</MudTh>
                <MudTh Style="text-align:right">실행</MudTh>
                @if (!IsMobile)
                {
                    <MudTh Style="text-align:right">필터됨</MudTh>
                }
                <MudTh Style="text-align:right">실행율</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>
                    <MudTooltip Text="@PatternMetadataMap.GetDescription(context.PatternType)">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            <MudText Typo="Typo.body2" Style="white-space:nowrap; font-weight:500; cursor:help;">
                                @PatternMetadataMap.GetKoreanName(context.PatternType)
                            </MudText>
                            @if (IsMobile)
                            {
                                <MudChip T="string"
                                         Color="@PatternMetadataMap.GetMudColor(context.PatternType)"
                                         Size="Size.Small"
                                         Variant="Variant.Filled"
                                         Style="height:16px; font-size:10px; padding:0 5px; min-width:0;">
                                    @PatternMetadataMap.GetStyleLabel(context.PatternType)
                                </MudChip>
                            }
                        </MudStack>
                    </MudTooltip>
                </MudTd>
                @if (!IsMobile)
                {
                    <MudTd>
                        <MudChip T="string"
                                 Color="@PatternMetadataMap.GetMudColor(context.PatternType)"
                                 Size="Size.Small"
                                 Variant="Variant.Filled"
                                 Style="height:18px; font-size:10px; padding:0 6px; min-width:0;">
                            @PatternMetadataMap.GetStyleLabel(context.PatternType)
                        </MudChip>
                    </MudTd>
                }
                <MudTd Style="text-align:right">@context.Generated</MudTd>
                <MudTd Style="text-align:right">
                    <MudText Color="Color.Success">@context.Executed</MudText>
                </MudTd>
                @if (!IsMobile)
                {
                    <MudTd Style="text-align:right">
                        <MudText Color="@(context.Filtered > 0 ? Color.Warning : Color.Default)">
                            @context.Filtered
                        </MudText>
                    </MudTd>
                }
                <MudTd Style="text-align:right">
                    @{
                        var rate = context.Generated > 0
                            ? (double)context.Executed / context.Generated * 100.0
                            : 0.0;
                    }
                    <MudText Color="@(rate >= 50 ? Color.Success : Color.Default)">
                        @rate.ToString("F0")%
                    </MudText>
                </MudTd>
            </RowTemplate>
        </MudTable>
        </div>@* /table-scroll-wrapper *@
    }
}

@* ── 섹션 3: 과거 성과 통계 (거래 데이터 있을 때만) ── *@
<MudText Typo="Typo.subtitle2" Class="mb-2"
         Style="font-weight:600; letter-spacing:0.04em; text-transform:uppercase; color: var(--mud-palette-text-secondary);">
    과거 성과 통계
</MudText>
<MudDivider Class="mb-3" />

@if (!_loading && _stats.Count == 0)
{
    <MudAlert Severity="Severity.Info" Class="mb-4">
        아직 통계 데이터가 없습니다. 백테스트를 실행하거나 거래 데이터가 쌓일 때까지 기다려 주세요.
    </MudAlert>
}
else if (_stats.Count > 0)
{
    @* ── 기대값 차트 ── *@
    <MudText Typo="Typo.h6" Class="mb-2">패턴별 기대값 비교</MudText>
    <MudCard Class="mb-4 pa-3">
        <ApexCharts.ApexChart TItem="ExpectancyItem" Options="_expectancyOpts" Height="280">
            <ApexCharts.ApexPointSeries TItem="ExpectancyItem"
                Items="_expectancyItems"
                SeriesType="ApexCharts.SeriesType.Bar"
                XValue="@(e => e.Name)"
                YAggregate="@(e => e.First().Value)"
                Name="기대값 (%)" />
        </ApexCharts.ApexChart>
    </MudCard>

    <PatternStatsTable Stats="@_stats" />

    <MudText Typo="Typo.h6" Class="mt-4 mb-2">요약</MudText>
    <MudGrid>
        <MudItem xs="6" sm="4">
            <MudCard>
                <MudCardContent Class="text-center pa-2">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">양의 기대값</MudText>
                    <MudText Typo="@(IsMobile ? Typo.h5 : Typo.h4)" Color="Color.Success">@_stats.Count(s => s.Expectancy > 0)</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">/ @_stats.Count 패턴</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="12" sm="4">
            @{
                var best = _stats.OrderByDescending(s => s.Expectancy).First();
                var bestMeta = PatternMetadataMap.Get(best.PatternType);
            }
            <MudCard>
                <MudCardContent Class="text-center">
                    <MudText Typo="Typo.subtitle2" Color="Color.Secondary">최고 패턴</MudText>
                    <MudText Typo="Typo.h6" Color="Color.Success" Class="mt-1">@bestMeta.KoreanName</MudText>
                    <MudStack Row="true" Justify="Justify.Center" Spacing="1" Class="mt-1">
                        <MudChip T="string"
                                 Color="@PatternMetadataMap.GetMudColor(best.PatternType)"
                                 Size="Size.Small"
                                 Variant="Variant.Filled">
                            @bestMeta.StyleLabel
                        </MudChip>
                        <MudChip T="string"
                                 Color="Color.Default"
                                 Size="Size.Small"
                                 Variant="Variant.Outlined">
                            @bestMeta.HoldingPeriod
                        </MudChip>
                    </MudStack>
                    <MudText Typo="Typo.caption" Color="Color.Success" Class="mt-1">
                        기대값 @best.Expectancy.ToString("P2")
                    </MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="6" sm="4">
            <MudCard>
                <MudCardContent Class="text-center pa-2">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">총 표본 수</MudText>
                    <MudText Typo="@(IsMobile ? Typo.h5 : Typo.h4)">@_stats.Sum(s => s.SampleSize)</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">누적 거래 기록</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>

    @* 스타일별 분류 섹션 *@
    <MudText Typo="Typo.h6" Class="mt-4 mb-2">스타일별 현황</MudText>
    <MudGrid>
        @foreach (var group in _styleGroups)
        {
            <MudItem xs="6" md="3">
                <MudCard>
                    <MudCardContent Class="text-center pa-3">
                        <MudChip T="string"
                                 Color="@group.MudColor"
                                 Size="Size.Small"
                                 Variant="Variant.Filled"
                                 Class="mb-1">
                            @group.StyleLabel
                        </MudChip>
                        <MudText Typo="Typo.h5">@group.Count</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">패턴</MudText>
                        @if (group.AvgExpectancy.HasValue)
                        {
                            <MudText Typo="Typo.caption"
                                     Color="@(group.AvgExpectancy.Value >= 0 ? Color.Success : Color.Error)">
                                평균 기대값 @group.AvgExpectancy.Value.ToString("P2")
                            </MudText>
                        }
                    </MudCardContent>
                </MudCard>
            </MudItem>
        }
    </MudGrid>
}

@code {
    [CascadingParameter(Name = "IsMobile")] private bool IsMobile { get; set; }

    private bool _showHelp;
    private bool _loading;
    private string? _error;
    private List<PatternStats> _stats = new();

    // 시그널 활동
    private List<SignalActivityRow> _signalRows = new();
    private int _activeSignalCount;
    private List<TradeRecommendation> _recentRecs = new();

    // 패턴 카탈로그 — 항상 렌더링 가능한 정적 목록
    private static readonly List<PatternType> _allPatterns =
        Enum.GetValues<PatternType>().ToList();

    private record StyleGroup(
        string StyleLabel,
        MudBlazor.Color MudColor,
        int Count,
        decimal? AvgExpectancy
    );

    private sealed record SignalActivityRow(
        PatternType PatternType,
        int Generated,
        int Executed,
        int Filtered
    );

    private List<StyleGroup> _styleGroups = new();
    private List<ExpectancyItem> _expectancyItems = new();

    private record ExpectancyItem(string Name, decimal Value);

    private static readonly ApexCharts.ApexChartOptions<ExpectancyItem> _expectancyOpts = new()
    {
        Chart = new ApexCharts.Chart { Background = "transparent", ForeColor = "#9E9E9E" },
        Theme = new ApexCharts.Theme { Mode = ApexCharts.Mode.Dark },
        PlotOptions = new ApexCharts.PlotOptions { Bar = new ApexCharts.PlotOptionsBar { Horizontal = true } },
        Yaxis = [new ApexCharts.YAxis { Labels = new ApexCharts.YAxisLabels { Formatter = @"function(v) { return v.toFixed(2) + '%' }" } }]
    };

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        try
        {
            var statsTask   = StatsService.GetAllStatsAsync();
            var signalsTask = TradeRepo.GetActiveSignalsAsync();
            var recsTask    = TradeRepo.GetRecentRecommendationsAsync(200);

            await Task.WhenAll(statsTask, signalsTask, recsTask);

            _stats      = statsTask.Result;
            var activeSignals = signalsTask.Result;
            _recentRecs = recsTask.Result;
            _activeSignalCount = activeSignals.Count;

            BuildSignalActivityRows(activeSignals, _recentRecs);
            BuildStyleGroups();
            BuildExpectancyItems();
        }
        catch (Exception ex)
        {
            _error = $"통계 로드 실패: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ManualRefreshAsync()
    {
        _loading = true;
        StateHasChanged();
        try
        {
            var statsTask   = StatsService.GetAllStatsAsync();
            var signalsTask = TradeRepo.GetActiveSignalsAsync();
            var recsTask    = TradeRepo.GetRecentRecommendationsAsync(200);
            await Task.WhenAll(statsTask, signalsTask, recsTask);
            _stats      = statsTask.Result;
            var activeSignals = signalsTask.Result;
            _recentRecs = recsTask.Result;
            _activeSignalCount = activeSignals.Count;
            BuildSignalActivityRows(activeSignals, _recentRecs);
            BuildStyleGroups();
            BuildExpectancyItems();
        }
        catch (Exception ex)
        {
            _error = $"통계 로드 실패: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private void BuildSignalActivityRows(
        List<PatternSignal> activeSignals,
        List<TradeRecommendation> recs)
    {
        // 추천 목록에서 패턴별 생성/실행 집계
        var recsByPattern = recs
            .GroupBy(r => r.PatternType)
            .ToDictionary(g => g.Key, g => g.ToList());

        // 활성 시그널에서 패턴별 집계
        var activeCounts = activeSignals
            .GroupBy(s => s.PatternType)
            .ToDictionary(g => g.Key, g => g.Count());

        // 두 소스를 합쳐 패턴 목록 구성
        var allPatterns = recsByPattern.Keys
            .Union(activeCounts.Keys)
            .Distinct()
            .OrderBy(p => p);

        _signalRows = allPatterns.Select(pt =>
        {
            var patternRecs  = recsByPattern.TryGetValue(pt, out var r) ? r : new();
            var generated    = patternRecs.Count + (activeCounts.TryGetValue(pt, out var a) ? a : 0);
            var executed     = patternRecs.Count(rec => rec.WasExecuted);
            var filtered     = patternRecs.Count(rec => !rec.WasExecuted);
            return new SignalActivityRow(pt, generated, executed, filtered);
        }).ToList();
    }

    private void BuildExpectancyItems()
    {
        _expectancyItems = _stats
            .OrderByDescending(s => s.Expectancy)
            .Select(s => new ExpectancyItem(
                PatternMetadataMap.GetKoreanName(s.PatternType),
                s.Expectancy * 100))
            .ToList();
    }

    private void BuildStyleGroups()
    {
        _styleGroups = _stats
            .GroupBy(s => PatternMetadataMap.Get(s.PatternType).Style)
            .Select(g =>
            {
                var first = g.First();
                var meta = PatternMetadataMap.Get(first.PatternType);
                var avgExp = g.Any() ? (decimal?)g.Average(s => s.Expectancy) : null;
                return new StyleGroup(
                    meta.StyleLabel,
                    PatternMetadataMap.GetMudColor(g.Key),
                    g.Count(),
                    avgExp
                );
            })
            .OrderBy(g => g.StyleLabel)
            .ToList();
    }
}
