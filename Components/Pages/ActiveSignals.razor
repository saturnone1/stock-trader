@page "/signals"
@rendermode InteractiveServer
@using StockTrader.Models
@using StockTrader.Models.Enums
@using StockTrader.Data.Repositories
@using StockTrader.Services.Notification
@using StockTrader.Services.Order
@inject ITradeRepository TradeRepo
@inject INotificationService NotificationService
@inject IOrderService OrderService
@inject ISnackbar Snackbar
@implements IDisposable

<PageTitle>활성 시그널 - 주식 트레이더</PageTitle>

<div class="page-header">
    <MudText Typo="Typo.h5">활성 시그널</MudText>
    <MudIconButton Icon="@Icons.Material.Filled.HelpOutline" Size="Size.Small" Color="Color.Default" OnClick="@(() => _showHelp = true)" title="도움말" />
    <MudTooltip Text="새로고침">
        <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Small"
                       Color="Color.Default" OnClick="@ManualRefreshAsync"
                       Disabled="@_loading" />
    </MudTooltip>
</div>
<MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3 page-description">패턴 감지 시스템이 실시간으로 발견한 매매 시그널 목록입니다. 패턴 유형이나 종목명으로 필터링할 수 있습니다.</MudText>

<MudDialog @bind-Visible="_showHelp">
    <TitleContent><MudText Typo="Typo.h6">활성 시그널 도움말</MudText></TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-2">패턴 스캐너가 자동 감지한 매매 시그널입니다.</MudText>
        <MudList T="string" Dense="true">
            <MudListItem Icon="@Icons.Material.Filled.Circle" IconSize="Size.Small" IconColor="Color.Primary">
                <strong>시그널 카드 테두리 색</strong>: 초록(신뢰도 70%↑), 노랑(40%↑), 회색(40%↓)
            </MudListItem>
            <MudListItem Icon="@Icons.Material.Filled.Circle" IconSize="Size.Small" IconColor="Color.Primary">
                <strong>진입가</strong>: 권장 매수 가격
            </MudListItem>
            <MudListItem Icon="@Icons.Material.Filled.Circle" IconSize="Size.Small" IconColor="Color.Primary">
                <strong>손절가 (빨강)</strong>: 이 가격 아래로 떨어지면 손실 제한을 위해 자동 매도
            </MudListItem>
            <MudListItem Icon="@Icons.Material.Filled.Circle" IconSize="Size.Small" IconColor="Color.Primary">
                <strong>목표가 (초록)</strong>: 이 가격에 도달하면 수익 실현을 위해 자동 매도
            </MudListItem>
        </MudList>
    </DialogContent>
    <DialogActions><MudButton OnClick="@(() => _showHelp = false)">닫기</MudButton></DialogActions>
</MudDialog>

<!-- 필터 영역 -->
@if (IsMobile)
{
    @* 모바일: 한 줄 검색 + 필터 토글 버튼 *@
    <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Class="mb-2">
        <MudTextField Value="_filterSymbol" ValueChanged="@((string v) => { _filterSymbol = v; RebuildFilteredSignals(); })"
                      Placeholder="종목 검색..." Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                      Style="flex:1;" />
        <MudIconButton Icon="@(_showMobileFilter ? Icons.Material.Filled.FilterListOff : Icons.Material.Filled.FilterList)"
                       Color="@(_showMobileFilter || _filterPattern != "" || _filterStyle != null ? Color.Primary : Color.Default)"
                       Variant="Variant.Outlined" Size="Size.Medium"
                       OnClick="@(() => _showMobileFilter = !_showMobileFilter)"
                       title="필터 열기/닫기"
                       Style="flex-shrink:0; border-radius:4px; border:1px solid rgba(255,255,255,0.23); padding:6px;" />
    </MudStack>
    @if (_showMobileFilter)
    {
        <MudGrid Spacing="2" Class="mb-2">
            <MudItem xs="12">
                <MudSelect T="string" Value="_filterPattern" ValueChanged="@(v => { _filterPattern = v; RebuildFilteredSignals(); })"
                           Label="패턴 필터" Variant="Variant.Outlined" Dense="true">
                    <MudSelectItem T="string" Value="@("")">전체 패턴</MudSelectItem>
                    @foreach (var pattern in Enum.GetValues<PatternType>())
                    {
                        var meta = PatternMetadataMap.Get(pattern);
                        <MudSelectItem T="string" Value="@pattern.ToString()">
                            @meta.KoreanName (@meta.StyleLabel)@(meta.Status != PatternStatus.Verified ? $" ⚠ {PatternMetadataMap.GetStatusLabel(meta.Status)}" : "")
                        </MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12">
                <MudSelect T="string" Value="_sortBy" ValueChanged="@(v => { _sortBy = v; RebuildFilteredSignals(); })"
                           Label="정렬" Variant="Variant.Outlined" Dense="true">
                    <MudSelectItem T="string" Value="@("time-desc")">최신순</MudSelectItem>
                    <MudSelectItem T="string" Value="@("time-asc")">오래된순</MudSelectItem>
                    <MudSelectItem T="string" Value="@("confidence-desc")">신뢰도 높은순</MudSelectItem>
                    <MudSelectItem T="string" Value="@("rr-desc")">R:R 높은순</MudSelectItem>
                </MudSelect>
            </MudItem>
        </MudGrid>
    }
}
else
{
    @* 데스크톱: 기존 3열 필터 *@
    <MudGrid Spacing="3" Class="mb-2">
        <MudItem xs="12" md="5">
            <MudSelect T="string" Value="_filterPattern" ValueChanged="@(v => { _filterPattern = v; RebuildFilteredSignals(); })" Label="패턴 필터" Variant="Variant.Outlined" Dense="true">
                <MudSelectItem T="string" Value="@("")">전체 패턴</MudSelectItem>
                @foreach (var pattern in Enum.GetValues<PatternType>())
                {
                    var meta = PatternMetadataMap.Get(pattern);
                    <MudSelectItem T="string" Value="@pattern.ToString()">
                        @meta.KoreanName (@meta.StyleLabel)@(meta.Status != PatternStatus.Verified ? $" ⚠ {PatternMetadataMap.GetStatusLabel(meta.Status)}" : "")
                    </MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" md="4">
            <MudTextField Value="_filterSymbol" ValueChanged="@((string v) => { _filterSymbol = v; RebuildFilteredSignals(); })" Label="종목 검색" Placeholder="종목 검색..."
                          Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />
        </MudItem>
        <MudItem xs="12" md="3">
            <MudSelect T="string" Value="_sortBy" ValueChanged="@(v => { _sortBy = v; RebuildFilteredSignals(); })" Label="정렬" Variant="Variant.Outlined" Dense="true">
                <MudSelectItem T="string" Value="@("time-desc")">최신순</MudSelectItem>
                <MudSelectItem T="string" Value="@("time-asc")">오래된순</MudSelectItem>
                <MudSelectItem T="string" Value="@("confidence-desc")">신뢰도 높은순</MudSelectItem>
                <MudSelectItem T="string" Value="@("rr-desc")">R:R 높은순</MudSelectItem>
            </MudSelect>
        </MudItem>
    </MudGrid>
}

<!-- 트레이딩 스타일 빠른 필터 -->
<MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="mb-3">
    <MudText Typo="Typo.caption" Color="Color.Secondary" Style="line-height: 32px; margin-right: 4px;">스타일:</MudText>
    <MudChip T="string"
             Color="@(_filterStyle == null ? Color.Primary : Color.Default)"
             Variant="@(_filterStyle == null ? Variant.Filled : Variant.Outlined)"
             Size="Size.Small"
             OnClick="@(() => { _filterStyle = null; RebuildFilteredSignals(); })">
        전체
    </MudChip>
    <MudChip T="string"
             Color="@(_filterStyle == TradingStyle.Scalping ? Color.Error : Color.Default)"
             Variant="@(_filterStyle == TradingStyle.Scalping ? Variant.Filled : Variant.Outlined)"
             Size="Size.Small"
             OnClick="@(() => ToggleStyleFilter(TradingStyle.Scalping))">
        스캘핑
    </MudChip>
    <MudChip T="string"
             Color="@(_filterStyle == TradingStyle.DayTrading ? Color.Warning : Color.Default)"
             Variant="@(_filterStyle == TradingStyle.DayTrading ? Variant.Filled : Variant.Outlined)"
             Size="Size.Small"
             OnClick="@(() => ToggleStyleFilter(TradingStyle.DayTrading))">
        단타
    </MudChip>
    <MudChip T="string"
             Color="@(_filterStyle == TradingStyle.Swing ? Color.Success : Color.Default)"
             Variant="@(_filterStyle == TradingStyle.Swing ? Variant.Filled : Variant.Outlined)"
             Size="Size.Small"
             OnClick="@(() => ToggleStyleFilter(TradingStyle.Swing))">
        스윙
    </MudChip>
    <MudChip T="string"
             Color="@(_filterStyle == TradingStyle.Position ? Color.Info : Color.Default)"
             Variant="@(_filterStyle == TradingStyle.Position ? Variant.Filled : Variant.Outlined)"
             Size="Size.Small"
             OnClick="@(() => ToggleStyleFilter(TradingStyle.Position))">
        포지션
    </MudChip>
    <MudText Typo="Typo.caption" Color="Color.Secondary" Style="line-height: 32px; margin-left: 8px;">
        @(_filteredSignals?.Count ?? 0)개 시그널
    </MudText>
</MudStack>

@if (_loading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-2" />
}
@if (_error != null)
{
    <MudAlert Severity="Severity.Error" Class="mb-2" ShowCloseIcon="true" CloseIconClicked="() => _error = null">@_error</MudAlert>
}

@if (!_loading && _signals.Count == 0)
{
    <MudAlert Severity="Severity.Info">현재 활성 시그널이 없습니다</MudAlert>
}
else if (_filteredSignals.Count == 0)
{
    <MudAlert Severity="Severity.Info">선택한 조건에 맞는 시그널이 없습니다</MudAlert>
}
else
{
    @foreach (var signal in _filteredSignals)
    {
        _recMap.TryGetValue((signal.Symbol, signal.PatternType), out var rec);
        <div class="mb-4">
            <SignalCard Signal="@signal" Recommendation="@rec" />
            @{
                var isStale = (DateTime.UtcNow - signal.DetectedAt).TotalHours > 24;
            }
            <div style="display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 6px 10px; border: 1px solid rgba(255,255,255,0.12); border-top: none; border-radius: 0 0 6px 6px; background: rgba(255,255,255,0.02);">
                <span style="font-size: 0.72rem; min-width: 0; color: var(--mud-palette-@(isStale ? "warning" : "text-secondary"));">
                    @(isStale ? "24시간 초과" : "시장가 주문")
                </span>
                <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.ShoppingCart"
                           Disabled="@(_executingSignalId == signal.Id || isStale)"
                           OnClick="@(() => ExecuteSignalAsync(signal))"
                           Style="min-width: 56px; flex-shrink: 0;">
                    @if (_executingSignalId == signal.Id)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
                    }
                    매수
                </MudButton>
            </div>
        </div>
    }
}

@code {
    [CascadingParameter(Name = "IsMobile")] private bool IsMobile { get; set; }

    private bool _showHelp;
    private bool _showMobileFilter;
    private bool _loading;
    private string? _error;
    private bool _subscribed;
    private System.Threading.Timer? _refreshTimer;
    private List<PatternSignal> _signals = new();
    // Materialized cache — rebuilt once per filter/data change, not on every render pass.
    private List<PatternSignal> _filteredSignals = new();
    private string _filterPattern = "";
    private string _filterSymbol = "";
    private TradingStyle? _filterStyle = null;
    private string _sortBy = "time-desc";

    // 매수 실행 중인 시그널 Id (로딩 표시 + 중복 클릭 방지)
    private long? _executingSignalId;

    // 자동매매 추천 맵: (Symbol, PatternType) → 가장 최근 추천
    private Dictionary<(string Symbol, PatternType Pattern), TradeRecommendation> _recMap = new();

    private void RebuildFilteredSignals()
    {
        var q = _signals
            .Where(s => string.IsNullOrEmpty(_filterPattern)
                || s.PatternType.ToString() == _filterPattern)
            .Where(s => string.IsNullOrEmpty(_filterSymbol)
                || s.Symbol.Contains(_filterSymbol, StringComparison.OrdinalIgnoreCase))
            .Where(s => _filterStyle == null
                || PatternMetadataMap.Get(s.PatternType).Style == _filterStyle);

        _filteredSignals = (_sortBy switch
        {
            "time-asc"         => q.OrderBy(s => s.DetectedAt),
            "confidence-desc"  => q.OrderByDescending(s => s.Confidence),
            "rr-desc"          => q.OrderByDescending(s => CalcRR(s)),
            _                  => q.OrderByDescending(s => s.DetectedAt)
        }).ToList();
    }

    private static decimal CalcRR(PatternSignal s)
    {
        var risk = Math.Abs(s.EntryPrice - s.StopLossPrice);
        return risk > 0 ? Math.Abs(s.TargetPrice - s.EntryPrice) / risk : 0;
    }

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        try
        {
            var signalsTask = TradeRepo.GetActiveSignalsAsync();
            var recsTask    = TradeRepo.GetRecentRecommendationsAsync(200);
            await Task.WhenAll(signalsTask, recsTask);
            _signals = signalsTask.Result;
            _recMap  = recsTask.Result
                .GroupBy(r => (r.Symbol, r.PatternType))
                .ToDictionary(g => g.Key, g => g.OrderByDescending(r => r.GeneratedAt).First());
            RebuildFilteredSignals();
        }
        catch (Exception ex)
        {
            _error = $"시그널 로드 실패: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
        // SignalR 재연결 시 OnInitializedAsync가 재실행될 수 있으므로
        // _subscribed 플래그로 정확히 한 번만 구독되도록 보장
        if (!_subscribed)
        {
            NotificationService.OnNewRecommendation += OnNewRecommendation;
            _subscribed = true;

            // 60초마다 갱신 (만료 배지 + 경과시간 + 시그널 목록 + 추천 재로드)
            _refreshTimer = new System.Threading.Timer(
                async _ =>
                {
                    try
                    {
                        var signalsTask = TradeRepo.GetActiveSignalsAsync();
                        var recsTask    = TradeRepo.GetRecentRecommendationsAsync(200);
                        await Task.WhenAll(signalsTask, recsTask);
                        _signals = signalsTask.Result;
                        _recMap  = recsTask.Result
                            .GroupBy(r => (r.Symbol, r.PatternType))
                            .ToDictionary(g => g.Key, g => g.OrderByDescending(r => r.GeneratedAt).First());
                        RebuildFilteredSignals();
                        await InvokeAsync(StateHasChanged);
                    }
                    catch (ObjectDisposedException) { }
                },
                state: null,
                dueTime: TimeSpan.FromSeconds(60),
                period: TimeSpan.FromSeconds(60));
        }
    }

    private void OnNewRecommendation(TradeRecommendation rec)
    {
        _ = InvokeAsync(async () =>
        {
            try
            {
                var signalsTask = TradeRepo.GetActiveSignalsAsync();
                var recsTask    = TradeRepo.GetRecentRecommendationsAsync(200);
                await Task.WhenAll(signalsTask, recsTask);
                _signals = signalsTask.Result;
                _recMap  = recsTask.Result
                    .GroupBy(r => (r.Symbol, r.PatternType))
                    .ToDictionary(g => g.Key, g => g.OrderByDescending(r => r.GeneratedAt).First());
                RebuildFilteredSignals();
                StateHasChanged();
            }
            catch (ObjectDisposedException) { }
            catch (Exception ex)
            {
                _error = $"시그널 갱신 실패: {ex.Message}";
                StateHasChanged();
            }
        });
    }

    private async Task ManualRefreshAsync()
    {
        _loading = true;
        StateHasChanged();
        try
        {
            var signalsTask = TradeRepo.GetActiveSignalsAsync();
            var recsTask    = TradeRepo.GetRecentRecommendationsAsync(200);
            await Task.WhenAll(signalsTask, recsTask);
            _signals = signalsTask.Result;
            _recMap  = recsTask.Result
                .GroupBy(r => (r.Symbol, r.PatternType))
                .ToDictionary(g => g.Key, g => g.OrderByDescending(r => r.GeneratedAt).First());
            RebuildFilteredSignals();
        }
        catch (Exception ex)
        {
            _error = $"시그널 로드 실패: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private void ToggleStyleFilter(TradingStyle style)
    {
        _filterStyle = _filterStyle == style ? null : style;
        RebuildFilteredSignals();
    }

    private async Task ExecuteSignalAsync(PatternSignal signal)
    {
        _executingSignalId = signal.Id;
        try
        {
            // 수동 매매 전용 메서드 사용 (리스크 체크 + 수량 자동 계산 + 최소 1주 보장)
            var (success, message) = await OrderService.PlaceManualOrderAsync(signal.Id);
            if (success)
            {
                Snackbar.Add($"{signal.Symbol} 매수 주문 실행 완료", Severity.Success);
            }
            else
            {
                Snackbar.Add($"{signal.Symbol} 주문 실패: {message}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"주문 오류: {ex.Message}", Severity.Error);
        }
        finally
        {
            _executingSignalId = null;
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        _refreshTimer?.Dispose();
        NotificationService.OnNewRecommendation -= OnNewRecommendation;
    }
}
