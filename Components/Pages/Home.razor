@page "/"
@rendermode InteractiveServer
@using StockTrader.Models
@using StockTrader.Models.Enums
@using StockTrader.Data.Repositories
@using StockTrader.Services.Risk
@using StockTrader.Services.Notification
@using StockTrader.Services.Broker
@using StockTrader.Services.Analysis
@using TimeZoneConverter
@inject ITradeRepository TradeRepo
@inject ISettingsRepository SettingsRepo
@inject IRiskManagementService RiskService
@inject INotificationService NotificationService
@inject IBrokerServiceFactory BrokerFactory
@inject IStockAnalysisService AnalysisService
@implements IDisposable

<PageTitle>대시보드 - 주식 트레이더</PageTitle>

<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2">
    <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
        <MudText Typo="Typo.h5">대시보드</MudText>
        <MudIconButton Icon="@Icons.Material.Filled.HelpOutline" Size="Size.Small" Color="Color.Default" OnClick="@(() => _showHelp = true)" title="도움말" />
        <MudTooltip Text="새로고침">
            <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Small"
                           Color="Color.Default" OnClick="@LoadDataAsync"
                           Disabled="@_loading" />
        </MudTooltip>
    </MudStack>
    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
        @{
            var (statusLabel, statusColor, statusIcon) = GetMarketStatus();
        }
        <MudChip T="string" Color="@statusColor" Variant="Variant.Filled" Size="Size.Small"
                 Icon="@statusIcon">
            @statusLabel
        </MudChip>
        <MarketRegimeBadge Regime="@_regime" />
        <ModeToggle OnModeChanged="OnModeChanged" />
    </MudStack>
</MudStack>
<MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">실시간 시장 현황과 포트폴리오 요약을 한눈에 확인하세요.</MudText>

<MudDialog @bind-Visible="_showHelp">
    <TitleContent><MudText Typo="Typo.h6">대시보드 도움말</MudText></TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-2">앱의 메인 화면으로, 현재 상태를 한눈에 파악할 수 있습니다.</MudText>
        <MudList T="string" Dense="true">
            <MudListItem Icon="@Icons.Material.Filled.Circle" IconSize="Size.Small" IconColor="Color.Primary">
                <strong>시장 레짐</strong>: SPY 기준 현재 시장 상태 (상승/하락/횡보)
            </MudListItem>
            <MudListItem Icon="@Icons.Material.Filled.Circle" IconSize="Size.Small" IconColor="Color.Primary">
                <strong>거래 모드</strong>: 알림 전용 / 자동 주문 전환
            </MudListItem>
            <MudListItem Icon="@Icons.Material.Filled.Circle" IconSize="Size.Small" IconColor="Color.Primary">
                <strong>가격 티커</strong>: 관심 종목의 실시간 가격 변동
            </MudListItem>
            <MudListItem Icon="@Icons.Material.Filled.Circle" IconSize="Size.Small" IconColor="Color.Primary">
                <strong>리스크 게이지</strong>: 일일 손실 한도(-3%) 대비 현재 상태
            </MudListItem>
        </MudList>
    </DialogContent>
    <DialogActions><MudButton OnClick="@(() => _showHelp = false)">닫기</MudButton></DialogActions>
</MudDialog>

@if (_loading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-2" />
}
@if (_error != null)
{
    <MudAlert Severity="Severity.Error" Class="mb-2" ShowCloseIcon="true" CloseIconClicked="() => _error = null">@_error</MudAlert>
}

<PriceTicker />

@* ── 계좌 요약 ── *@
@if (_account != null)
{
    var totalPnL = _account.TotalEquity - _accountSize;
    var totalPnLPercent = _accountSize > 0 ? totalPnL / _accountSize * 100 : 0;
    <MudGrid Class="mb-2">
        <MudItem xs="6" sm="3">
            <MudCard>
                <MudCardContent Class="text-center pa-3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">총 자산</MudText>
                    <MudText Typo="Typo.h5" Class="mt-1">$@_account.TotalEquity.ToString("N0")</MudText>
                    <MudText Typo="Typo.caption"
                             Color="@(totalPnL >= 0 ? Color.Success : Color.Error)">
                        원금 $@_accountSize.ToString("N0") 대비 @(totalPnL >= 0 ? "+" : "")@totalPnL.ToString("N0") (@(totalPnL >= 0 ? "+" : "")@totalPnLPercent.ToString("F2")%)
                    </MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="6" sm="3">
            <MudCard>
                <MudCardContent Class="text-center pa-3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">현금</MudText>
                    <MudText Typo="Typo.h5" Class="mt-1">$@_account.Cash.ToString("N0")</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="6" sm="3">
            <MudCard>
                <MudCardContent Class="text-center pa-3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">매수 여력</MudText>
                    <MudText Typo="Typo.h5" Class="mt-1">$@_account.BuyingPower.ToString("N0")</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="6" sm="3">
            <MudCard>
                <MudCardContent Class="text-center pa-3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">미실현 손익</MudText>
                    <MudText Typo="Typo.h5" Class="mt-1"
                             Color="@(_account.UnrealizedPnL >= 0 ? Color.Success : Color.Error)">
                        @(_account.UnrealizedPnL >= 0 ? "+" : "")$@_account.UnrealizedPnL.ToString("N2")
                    </MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>
}

@* ── 트레이딩 현황 ── *@
<MudGrid Class="mb-4">
    <MudItem xs="6" sm="3">
        <MudCard>
            <MudCardContent Class="text-center pa-3">
                <MudText Typo="Typo.caption" Color="Color.Secondary">보유 포지션</MudText>
                <MudText Typo="Typo.h4" Class="mt-1">@_openPositions.Count</MudText>
            </MudCardContent>
        </MudCard>
    </MudItem>
    <MudItem xs="6" sm="3">
        <MudCard>
            <MudCardContent Class="text-center pa-3">
                <MudText Typo="Typo.caption" Color="Color.Secondary">활성 시그널</MudText>
                <MudText Typo="Typo.h4" Class="mt-1">@_activeSignals.Count</MudText>
            </MudCardContent>
        </MudCard>
    </MudItem>
    <MudItem xs="6" sm="3">
        <MudCard>
            <MudCardContent Class="text-center pa-3">
                <MudText Typo="Typo.caption" Color="Color.Secondary">일일 손익</MudText>
                <MudText Typo="Typo.h4" Class="mt-1"
                         Color="@(_riskState.DailyPnL >= 0 ? Color.Success : Color.Error)">
                    @(_riskState.DailyPnL >= 0 ? "+" : "")$@_riskState.DailyPnL.ToString("N2")
                </MudText>
            </MudCardContent>
        </MudCard>
    </MudItem>
    <MudItem xs="6" sm="3">
        <RiskGauge State="@_riskState" />
    </MudItem>
</MudGrid>

<MudGrid>
    <MudItem xs="12" md="6">
        <MudCard>
            <MudCardHeader Class="pb-0">
                <CardHeaderContent>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <MudIcon Icon="@Icons.Material.Filled.Notifications" Size="Size.Small" Color="Color.Primary" />
                        <MudText Typo="Typo.h6">최근 시그널</MudText>
                        @if (_activeSignals.Count > 0)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled"
                                     Style="height:20px; font-size:11px; padding:0 8px; min-width:0;">
                                @_activeSignals.Count
                            </MudChip>
                        }
                    </MudStack>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent Class="pt-2">
                @if (_activeSignals.Count == 0)
                {
                    <MudAlert Severity="Severity.Info" Dense="true">활성 시그널이 없습니다</MudAlert>
                }
                else
                {
                    @foreach (var signal in _activeSignals.Take(5))
                    {
                        _recMap.TryGetValue((signal.Symbol, signal.PatternType), out var rec);
                        <SignalCard Signal="@signal" Recommendation="@rec" />
                    }
                    @if (_activeSignals.Count > 5)
                    {
                        <MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-1">
                            <MudLink Href="/signals" Typo="Typo.body2" Color="Color.Primary">
                                더 보기 (@(_activeSignals.Count)개 전체) →
                            </MudLink>
                        </MudStack>
                    }
                }
            </MudCardContent>
        </MudCard>
    </MudItem>
    <MudItem xs="12" md="6">
        <MudCard>
            <MudCardHeader Class="pb-0">
                <CardHeaderContent>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <MudIcon Icon="@Icons.Material.Filled.AccountBalance" Size="Size.Small" Color="Color.Success" />
                        <MudText Typo="Typo.h6">보유 포지션</MudText>
                        @if (_openPositions.Count > 0)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled"
                                     Style="height:20px; font-size:11px; padding:0 8px; min-width:0;">
                                @_openPositions.Count
            </MudChip>
                        }
                    </MudStack>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent Class="pt-2">
                @if (_openPositions.Count == 0)
                {
                    <MudAlert Severity="Severity.Info" Dense="true">보유 포지션이 없습니다</MudAlert>
                }
                else
                {
                    <div class="table-scroll-wrapper">
                        <MudTable Items="@_openPositions" Dense="true" Hover="true" Striped="true">
                            <HeaderContent>
                                <MudTh>종목</MudTh>
                                <MudTh>수량</MudTh>
                                <MudTh>진입가</MudTh>
                                <MudTh>현재가</MudTh>
                                <MudTh>손익</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd><MudText Typo="Typo.body2"><b>@context.Symbol</b></MudText></MudTd>
                                <MudTd>@context.Quantity</MudTd>
                                <MudTd>$@context.EntryPrice.ToString("F2")</MudTd>
                                <MudTd>$@context.CurrentPrice.ToString("F2")</MudTd>
                                <MudTd>
                                    <MudText Color="@(context.UnrealizedPnL >= 0 ? Color.Success : Color.Error)">
                                        @(context.UnrealizedPnL >= 0 ? "+" : "")$@context.UnrealizedPnL.ToString("N2")
                                    </MudText>
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    </div>
                }
            </MudCardContent>
        </MudCard>
    </MudItem>
</MudGrid>

@code {
    private bool _showHelp;
    private bool _loading;
    private string? _error;
    private List<PatternSignal> _activeSignals = new();
    private Dictionary<(string Symbol, PatternType Pattern), TradeRecommendation> _recMap = new();
    private List<StockTrader.Models.Position> _openPositions = new();
    private RiskState _riskState = new();
    private MarketRegime? _regime = new() { RegimeLabel = "로딩 중..." };
    private BrokerAccount? _account;
    private decimal _accountSize = 100_000m;

    // 리스크 상태 주기적 갱신용 타이머 (30초마다)
    private Timer? _riskRefreshTimer;
    private static readonly TimeSpan RiskRefreshInterval = TimeSpan.FromSeconds(30);

    // Fix 3: 에러 쓰로틀링 - 마지막 에러 발생 시각 추적
    private DateTime _lastErrorTime = DateTime.MinValue;

    private static readonly TimeZoneInfo EasternTz =
        TZConvert.GetTimeZoneInfo("America/New_York");

    protected override async Task OnInitializedAsync()
    {
        // Fix 1: 이벤트 핸들러를 LoadDataAsync 이전에 등록한다.
        // 데이터 로드 중 도착하는 시그널/가격 업데이트를 누락하지 않기 위한 경쟁 조건 방지.
        NotificationService.OnNewRecommendation += OnNewRecommendation;
        NotificationService.OnPriceUpdate += OnPriceUpdate;

        await LoadDataAsync();

        // 리스크 상태를 30초마다 갱신한다.
        // OnPriceUpdate는 이제 포지션 가격만 in-memory 업데이트하므로
        // DailyPnL 등은 별도 타이머로 주기적으로 새로고침한다.
        _riskRefreshTimer = new Timer(
            _ => _ = InvokeAsync(RefreshRiskStateAsync),
            null,
            RiskRefreshInterval,
            RiskRefreshInterval);
    }

    private async Task LoadDataAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var signalsTask = TradeRepo.GetActiveSignalsAsync();
            var recsTask = TradeRepo.GetRecentRecommendationsAsync(200);
            var positionsTask = TradeRepo.GetOpenPositionsAsync();
            var riskTask = RiskService.GetCurrentRiskStateAsync();

            // regime loading: fire-and-forget, failure does not affect dashboard
            _ = LoadRegimeAsync();

            // Fix 2: 브로커 서비스 null 체크 - 초기화 실패 시 의미있는 오류 메시지 표시
            var broker = BrokerFactory.GetDefaultService();
            if (broker == null)
            {
                _error = "브로커 서비스를 초기화할 수 없습니다.";
                await Task.WhenAll(signalsTask, recsTask, positionsTask, riskTask);
                _activeSignals = signalsTask.Result;
                _recMap = recsTask.Result
                    .GroupBy(r => (r.Symbol, r.PatternType))
                    .ToDictionary(g => g.Key, g => g.OrderByDescending(r => r.GeneratedAt).First());
                _openPositions = positionsTask.Result;
                _riskState = riskTask.Result;
                return;
            }

            var accountTask = broker.GetAccountAsync();
            var settingsTask = SettingsRepo.GetAsync();
            await Task.WhenAll(signalsTask, recsTask, positionsTask, riskTask, accountTask, settingsTask);
            _accountSize = settingsTask.Result.AccountSize;

            _activeSignals = signalsTask.Result;
            _recMap = recsTask.Result
                .GroupBy(r => (r.Symbol, r.PatternType))
                .ToDictionary(g => g.Key, g => g.OrderByDescending(r => r.GeneratedAt).First());
            _openPositions = positionsTask.Result;
            _riskState = riskTask.Result;
            _account = accountTask.Result;
        }
        catch (Exception ex)
        {
            _error = $"데이터 로드 실패: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>
    /// 리스크 상태와 포지션 현재가를 갱신한다.
    /// 장중에는 WebSocket 스트리밍(OnPriceUpdate)이 즉시 업데이트하지만,
    /// 프리마켓/애프터마켓/장외 시간에는 이 타이머가 REST API 폴링으로 보완한다.
    /// </summary>
    private async Task RefreshRiskStateAsync()
    {
        try
        {
            var broker = BrokerFactory.GetDefaultService();
            if (broker == null) return;
            var riskTask = RiskService.GetCurrentRiskStateAsync();
            var brokerPositionsTask = broker.GetPositionsAsync();
            var accountTask = broker.GetAccountAsync();

            await Task.WhenAll(riskTask, brokerPositionsTask, accountTask);

            _riskState = riskTask.Result;

            // 브로커에서 받은 최신 가격으로 in-memory 포지션 현재가를 갱신한다.
            // 장중에는 WebSocket 업데이트가 더 빠르지만, 이 폴링이 중복 적용되어도 무해하다.
            var brokerPositions = brokerPositionsTask.Result;
            if (brokerPositions.Count > 0)
            {
                var priceMap = brokerPositions.ToDictionary(p => p.Symbol, p => p.CurrentPrice);
                foreach (var position in _openPositions)
                {
                    if (priceMap.TryGetValue(position.Symbol, out var latestPrice) && latestPrice > 0)
                        position.CurrentPrice = latestPrice;
                }
            }

            // 계좌 요약(총 자산, 미실현 손익 등)도 함께 갱신한다.
            if (accountTask.Result != null)
                _account = accountTask.Result;

            StateHasChanged();
        }
        catch (ObjectDisposedException) { }
        catch (Exception ex)
        {
            // Fix 3: 에러 쓰로틀링 - 30초 타이머가 에러를 반복 표시하지 않도록
            // 마지막 에러로부터 60초 이상 경과한 경우에만 에러 메시지를 갱신한다.
            var now = DateTime.UtcNow;
            if ((now - _lastErrorTime).TotalSeconds >= 60)
            {
                _lastErrorTime = now;
                _error = $"상태 갱신 실패: {ex.Message}";
                StateHasChanged();
            }
        }
    }

    private (string Label, Color Color, string Icon) GetMarketStatus()
    {
        var now = TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, EasternTz);
        if (now.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday)
            return ("휴장", Color.Default, Icons.Material.Filled.DarkMode);

        var time = now.TimeOfDay;
        if (time >= new TimeSpan(9, 30, 0) && time < new TimeSpan(16, 0, 0))
            return ("장중", Color.Success, Icons.Material.Filled.PlayCircle);
        if (time >= new TimeSpan(4, 0, 0) && time < new TimeSpan(9, 30, 0))
            return ("프리마켓", Color.Warning, Icons.Material.Filled.WbTwilight);
        if (time >= new TimeSpan(16, 0, 0) && time < new TimeSpan(20, 0, 0))
            return ("애프터마켓", Color.Info, Icons.Material.Filled.NightsStay);

        return ("휴장", Color.Default, Icons.Material.Filled.DarkMode);
    }

    private void OnNewRecommendation(TradeRecommendation rec)
    {
        _ = InvokeAsync(async () =>
        {
            try { await LoadDataAsync(); StateHasChanged(); }
            catch (ObjectDisposedException) { }
            catch (Exception ex) { _error = ex.Message; StateHasChanged(); }
        });
    }

    /// <summary>
    /// 스트리밍 가격 업데이트를 받아 in-memory 포지션 목록의 CurrentPrice를 즉시 반영한다.
    /// DB를 거치지 않으므로 장 중/장 외 모두 가격이 최신 상태를 유지한다.
    /// </summary>
    private void OnPriceUpdate(PriceUpdate update)
    {
        _ = InvokeAsync(() =>
        {
            try
            {
                bool changed = false;
                foreach (var position in _openPositions)
                {
                    if (position.Symbol == update.Symbol)
                    {
                        position.CurrentPrice = update.Price;
                        changed = true;
                    }
                }
                if (changed)
                    StateHasChanged();
            }
            catch (ObjectDisposedException) { }
        });
    }

    private async Task OnModeChanged(OrderMode mode)
    {
        await LoadDataAsync();
    }

    /// <summary>
    /// Loads SPY market regime asynchronously. Failure does not affect other dashboard data.
    /// </summary>
    private async Task LoadRegimeAsync()
    {
        try
        {
            _regime = await AnalysisService.GetMarketRegimeAsync();
            await InvokeAsync(StateHasChanged);
        }
        catch
        {
            _regime = new MarketRegime { RegimeLabel = "알 수 없음" };
            await InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose()
    {
        _riskRefreshTimer?.Dispose();
        NotificationService.OnNewRecommendation -= OnNewRecommendation;
        NotificationService.OnPriceUpdate -= OnPriceUpdate;
    }
}
