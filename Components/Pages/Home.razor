@page "/"
@rendermode InteractiveServer
@using StockTrader.Models
@using StockTrader.Models.Enums
@using StockTrader.Data.Repositories
@using StockTrader.Services.Risk
@using StockTrader.Services.Notification
@using StockTrader.Services.Broker
@using TimeZoneConverter
@inject ITradeRepository TradeRepo
@inject ISettingsRepository SettingsRepo
@inject IRiskManagementService RiskService
@inject INotificationService NotificationService
@inject IBrokerServiceFactory BrokerFactory
@implements IDisposable

<PageTitle>대시보드 - 주식 트레이더</PageTitle>

<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2">
    <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
        <MudText Typo="Typo.h5">대시보드</MudText>
        <MudIconButton Icon="@Icons.Material.Filled.HelpOutline" Size="Size.Small" Color="Color.Default" OnClick="@(() => _showHelp = true)" title="도움말" />
    </MudStack>
    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
        @{
            var (statusLabel, statusColor, statusIcon) = GetMarketStatus();
        }
        <MudChip T="string" Color="@statusColor" Variant="Variant.Filled" Size="Size.Small"
                 Icon="@statusIcon">
            @statusLabel
        </MudChip>
        <MarketRegimeBadge Regime="@_regime" />
        <ModeToggle OnModeChanged="OnModeChanged" />
    </MudStack>
</MudStack>
<MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">실시간 시장 현황과 포트폴리오 요약을 한눈에 확인하세요.</MudText>

<MudDialog @bind-Visible="_showHelp">
    <TitleContent><MudText Typo="Typo.h6">대시보드 도움말</MudText></TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-2">앱의 메인 화면으로, 현재 상태를 한눈에 파악할 수 있습니다.</MudText>
        <MudList T="string" Dense="true">
            <MudListItem Icon="@Icons.Material.Filled.Circle" IconSize="Size.Small" IconColor="Color.Primary">
                <strong>시장 레짐</strong>: SPY 기준 현재 시장 상태 (상승/하락/횡보)
            </MudListItem>
            <MudListItem Icon="@Icons.Material.Filled.Circle" IconSize="Size.Small" IconColor="Color.Primary">
                <strong>거래 모드</strong>: 알림 전용 / 자동 주문 전환
            </MudListItem>
            <MudListItem Icon="@Icons.Material.Filled.Circle" IconSize="Size.Small" IconColor="Color.Primary">
                <strong>가격 티커</strong>: 관심 종목의 실시간 가격 변동
            </MudListItem>
            <MudListItem Icon="@Icons.Material.Filled.Circle" IconSize="Size.Small" IconColor="Color.Primary">
                <strong>리스크 게이지</strong>: 일일 손실 한도(-3%) 대비 현재 상태
            </MudListItem>
        </MudList>
    </DialogContent>
    <DialogActions><MudButton OnClick="@(() => _showHelp = false)">닫기</MudButton></DialogActions>
</MudDialog>

@if (_loading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-2" />
}
@if (_error != null)
{
    <MudAlert Severity="Severity.Error" Class="mb-2" ShowCloseIcon="true" CloseIconClicked="() => _error = null">@_error</MudAlert>
}

<PriceTicker />

@* ── 계좌 요약 ── *@
@if (_account != null)
{
    <MudGrid Class="mb-2">
        <MudItem xs="6" sm="3">
            <MudCard Style="min-height: 80px;">
                <MudCardContent Class="text-center pa-3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">총 자산</MudText>
                    <MudText Typo="Typo.h5" Class="mt-1">$@_account.TotalEquity.ToString("N0")</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="6" sm="3">
            <MudCard Style="min-height: 80px;">
                <MudCardContent Class="text-center pa-3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">현금</MudText>
                    <MudText Typo="Typo.h5" Class="mt-1">$@_account.Cash.ToString("N0")</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="6" sm="3">
            <MudCard Style="min-height: 80px;">
                <MudCardContent Class="text-center pa-3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">매수 여력</MudText>
                    <MudText Typo="Typo.h5" Class="mt-1">$@_account.BuyingPower.ToString("N0")</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="6" sm="3">
            <MudCard Style="min-height: 80px;">
                <MudCardContent Class="text-center pa-3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">미실현 손익</MudText>
                    <MudText Typo="Typo.h5" Class="mt-1"
                             Color="@(_account.UnrealizedPnL >= 0 ? Color.Success : Color.Error)">
                        @(_account.UnrealizedPnL >= 0 ? "+" : "")$@_account.UnrealizedPnL.ToString("N2")
                    </MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>
}

@* ── 트레이딩 현황 ── *@
<MudGrid Class="mb-4">
    <MudItem xs="6" sm="3">
        <MudCard Style="min-height: 96px;">
            <MudCardContent Class="text-center pa-3">
                <MudText Typo="Typo.caption" Color="Color.Secondary">보유 포지션</MudText>
                <MudText Typo="Typo.h4" Class="mt-1">@_openPositions.Count</MudText>
            </MudCardContent>
        </MudCard>
    </MudItem>
    <MudItem xs="6" sm="3">
        <MudCard Style="min-height: 96px;">
            <MudCardContent Class="text-center pa-3">
                <MudText Typo="Typo.caption" Color="Color.Secondary">활성 시그널</MudText>
                <MudText Typo="Typo.h4" Class="mt-1">@_activeSignals.Count</MudText>
            </MudCardContent>
        </MudCard>
    </MudItem>
    <MudItem xs="6" sm="3">
        <MudCard Style="min-height: 96px;">
            <MudCardContent Class="text-center pa-3">
                <MudText Typo="Typo.caption" Color="Color.Secondary">일일 손익</MudText>
                <MudText Typo="Typo.h4" Class="mt-1"
                         Color="@(_riskState.DailyPnL >= 0 ? Color.Success : Color.Error)">
                    @(_riskState.DailyPnL >= 0 ? "+" : "")$@_riskState.DailyPnL.ToString("N2")
                </MudText>
            </MudCardContent>
        </MudCard>
    </MudItem>
    <MudItem xs="6" sm="3">
        <RiskGauge State="@_riskState" />
    </MudItem>
</MudGrid>

<MudGrid>
    <MudItem xs="12" md="6">
        <MudCard>
            <MudCardHeader Class="pb-0">
                <CardHeaderContent>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <MudIcon Icon="@Icons.Material.Filled.Notifications" Size="Size.Small" Color="Color.Primary" />
                        <MudText Typo="Typo.h6">최근 시그널</MudText>
                        @if (_activeSignals.Count > 0)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled"
                                     Style="height:20px; font-size:11px; padding:0 8px; min-width:0;">
                                @_activeSignals.Count
                            </MudChip>
                        }
                    </MudStack>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent Class="pt-2">
                @if (_activeSignals.Count == 0)
                {
                    <MudAlert Severity="Severity.Info" Dense="true">활성 시그널이 없습니다</MudAlert>
                }
                else
                {
                    @foreach (var signal in _activeSignals.Take(10))
                    {
                        <SignalCard Signal="@signal" />
                    }
                }
            </MudCardContent>
        </MudCard>
    </MudItem>
    <MudItem xs="12" md="6">
        <MudCard>
            <MudCardHeader Class="pb-0">
                <CardHeaderContent>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <MudIcon Icon="@Icons.Material.Filled.AccountBalance" Size="Size.Small" Color="Color.Success" />
                        <MudText Typo="Typo.h6">보유 포지션</MudText>
                        @if (_openPositions.Count > 0)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled"
                                     Style="height:20px; font-size:11px; padding:0 8px; min-width:0;">
                                @_openPositions.Count
            </MudChip>
                        }
                    </MudStack>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent Class="pt-2">
                @if (_openPositions.Count == 0)
                {
                    <MudAlert Severity="Severity.Info" Dense="true">보유 포지션이 없습니다</MudAlert>
                }
                else
                {
                    <MudTable Items="@_openPositions" Dense="true" Hover="true" Striped="true">
                        <HeaderContent>
                            <MudTh>종목</MudTh>
                            <MudTh>수량</MudTh>
                            <MudTh>진입가</MudTh>
                            <MudTh>현재가</MudTh>
                            <MudTh>손익</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd><MudText Typo="Typo.body2"><b>@context.Symbol</b></MudText></MudTd>
                            <MudTd>@context.Quantity</MudTd>
                            <MudTd>$@context.EntryPrice.ToString("F2")</MudTd>
                            <MudTd>$@context.CurrentPrice.ToString("F2")</MudTd>
                            <MudTd>
                                <MudText Color="@(context.UnrealizedPnL >= 0 ? Color.Success : Color.Error)">
                                    @(context.UnrealizedPnL >= 0 ? "+" : "")$@context.UnrealizedPnL.ToString("N2")
                                </MudText>
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                }
            </MudCardContent>
        </MudCard>
    </MudItem>
</MudGrid>

@code {
    private bool _showHelp;
    private bool _loading;
    private string? _error;
    private List<PatternSignal> _activeSignals = new();
    private List<StockTrader.Models.Position> _openPositions = new();
    private RiskState _riskState = new();
    private MarketRegime? _regime = new() { RegimeLabel = "로딩 중..." };
    private BrokerAccount? _account;
    // Interlocked으로 원자적 읽기/쓰기하여 다중 이벤트 동시 진입 시 스로틀 무력화 방지
    private long _lastPositionRefreshTicks = 0;
    private static readonly long PositionRefreshThrottleTicks = TimeSpan.FromSeconds(5).Ticks;

    private static readonly TimeZoneInfo EasternTz =
        TZConvert.GetTimeZoneInfo("America/New_York");

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
        NotificationService.OnNewRecommendation += OnNewRecommendation;
        NotificationService.OnPriceUpdate += OnPriceUpdate;
    }

    private async Task LoadDataAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var signalsTask = TradeRepo.GetActiveSignalsAsync();
            var positionsTask = TradeRepo.GetOpenPositionsAsync();
            var riskTask = RiskService.GetCurrentRiskStateAsync();
            var accountTask = BrokerFactory.GetDefaultService().GetAccountAsync();

            await Task.WhenAll(signalsTask, positionsTask, riskTask, accountTask);

            _activeSignals = signalsTask.Result;
            _openPositions = positionsTask.Result;
            _riskState = riskTask.Result;
            _account = accountTask.Result;
        }
        catch (Exception ex)
        {
            _error = $"데이터 로드 실패: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private (string Label, Color Color, string Icon) GetMarketStatus()
    {
        var now = TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, EasternTz);
        if (now.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday)
            return ("휴장", Color.Default, Icons.Material.Filled.DarkMode);

        var time = now.TimeOfDay;
        if (time >= new TimeSpan(9, 30, 0) && time < new TimeSpan(16, 0, 0))
            return ("장중", Color.Success, Icons.Material.Filled.PlayCircle);
        if (time >= new TimeSpan(4, 0, 0) && time < new TimeSpan(9, 30, 0))
            return ("프리마켓", Color.Warning, Icons.Material.Filled.WbTwilight);
        if (time >= new TimeSpan(16, 0, 0) && time < new TimeSpan(20, 0, 0))
            return ("애프터마켓", Color.Info, Icons.Material.Filled.NightsStay);

        return ("휴장", Color.Default, Icons.Material.Filled.DarkMode);
    }

    private void OnNewRecommendation(TradeRecommendation rec)
    {
        _ = InvokeAsync(async () =>
        {
            try { await LoadDataAsync(); StateHasChanged(); }
            catch (ObjectDisposedException) { }
            catch (Exception ex) { _error = ex.Message; StateHasChanged(); }
        });
    }

    private void OnPriceUpdate(PriceUpdate update)
    {
        var now = DateTime.UtcNow.Ticks;
        var last = Interlocked.Read(ref _lastPositionRefreshTicks);
        if (now - last < PositionRefreshThrottleTicks) return;
        // 스왑 성공한 스레드만 실제 갱신을 수행하여 중복 호출 방지
        if (Interlocked.CompareExchange(ref _lastPositionRefreshTicks, now, last) != last) return;

        _ = InvokeAsync(async () =>
        {
            try { await LoadDataAsync(); StateHasChanged(); }
            catch (ObjectDisposedException) { }
            catch (Exception ex) { _error = ex.Message; StateHasChanged(); }
        });
    }

    private async Task OnModeChanged(OrderMode mode)
    {
        await LoadDataAsync();
    }

    public void Dispose()
    {
        NotificationService.OnNewRecommendation -= OnNewRecommendation;
        NotificationService.OnPriceUpdate -= OnPriceUpdate;
    }
}
