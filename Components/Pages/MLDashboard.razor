@page "/ml"
@rendermode InteractiveServer
@using StockTrader.Services.ML
@inject IMLModelTrainingService MlTrainingService
@inject IMarketRegimeClassifier RegimeClassifier
@inject ISignalScorer SignalScorer
@inject ILogger<MLDashboard> Logger
@implements IDisposable

<PageTitle>ML 분석 대시보드 - 주식 트레이더</PageTitle>

<MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Class="mb-1">
    <MudText Typo="Typo.h5">ML 분석 대시보드</MudText>
    <MudIconButton Icon="@Icons.Material.Filled.HelpOutline" Size="Size.Small" Color="Color.Default" OnClick="@(() => _showHelp = true)" title="도움말" />
    <MudTooltip Text="새로고침">
        <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Small"
                       Color="Color.Default" OnClick="@(() => RefreshStatus())"
                       Disabled="@_isLoading" />
    </MudTooltip>
</MudStack>
<MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4 page-description">머신러닝 모델 상태 및 시장 레짐 분석</MudText>

<MudDialog @bind-Visible="_showHelp">
    <TitleContent><MudText Typo="Typo.h6">ML 분석 대시보드 도움말</MudText></TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-2">머신러닝 모델을 학습하고 상태를 확인할 수 있습니다.</MudText>
        <MudList T="string" Dense="true">
            <MudListItem Icon="@Icons.Material.Filled.Circle" IconSize="Size.Small" IconColor="Color.Primary">
                <strong>모델 학습</strong>: 백테스트 거래 내역으로 시그널 스코어러와 레짐 분류기를 학습합니다
            </MudListItem>
            <MudListItem Icon="@Icons.Material.Filled.Circle" IconSize="Size.Small" IconColor="Color.Primary">
                <strong>시장 레짐</strong>: K-Means 클러스터링으로 현재 시장 상태(강세/약세/횡보)를 분류합니다
            </MudListItem>
            <MudListItem Icon="@Icons.Material.Filled.Circle" IconSize="Size.Small" IconColor="Color.Primary">
                <strong>시그널 스코어러</strong>: FastTree로 패턴 시그널의 성공 확률을 예측합니다
            </MudListItem>
            <MudListItem Icon="@Icons.Material.Filled.Circle" IconSize="Size.Small" IconColor="Color.Primary">
                <strong>피처 중요도</strong>: 예측에 가장 영향을 주는 요소를 시각화합니다
            </MudListItem>
        </MudList>
    </DialogContent>
    <DialogActions><MudButton OnClick="@(() => _showHelp = false)">닫기</MudButton></DialogActions>
</MudDialog>

<MudGrid Spacing="3">

        <!-- 모델 학습 카드 -->
        <MudItem xs="12" sm="12" md="4">
            <MudCard Class="h-100">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">모델 학습</MudText>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">
                            백테스트 거래 내역 + SPY 데이터로 ML 모델을 학습합니다
                        </MudText>
                    </CardHeaderContent>
                    <CardHeaderActions>
                        <MudIcon Icon="@Icons.Material.Filled.Psychology" Color="Color.Primary" />
                    </CardHeaderActions>
                </MudCardHeader>
                <MudCardContent>
                    @if (_status.IsTraining)
                    {
                        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-3" />
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">
                            @_status.TrainingStatus
                        </MudText>
                    }
                    else if (_lastTrainResult != null)
                    {
                        <MudAlert Severity="@(_lastTrainResult.Success ? Severity.Success : Severity.Warning)"
                                  Dense="true" Class="mb-3">
                            @_lastTrainResult.Message
                        </MudAlert>

                        @if (_lastTrainResult.Success)
                        {
                            <MudText Typo="Typo.body2">
                                소요 시간: @_lastTrainResult.TrainingDuration.TotalSeconds.ToString("F1")초
                            </MudText>
                            @if (_lastTrainResult.SignalSamples > 0)
                            {
                                <MudText Typo="Typo.body2">
                                    스코어러 정확도: @(_lastTrainResult.SignalScorerAccuracy.ToString("P1"))
                                </MudText>
                                <MudText Typo="Typo.body2">
                                    AUC-ROC: @(_lastTrainResult.SignalScorerAuc.ToString("F3"))
                                </MudText>
                            }
                        }
                    }
                    else
                    {
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">
                            아직 학습이 실행되지 않았습니다.
                            백테스트를 먼저 실행하여 학습 데이터를 생성하세요.
                        </MudText>
                    }
                </MudCardContent>
                <MudCardActions>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.School"
                               OnClick="TrainModelsAsync"
                               Disabled="_status.IsTraining || _isLoading">
                        @(_status.IsTraining ? "학습 중..." : "모델 학습")
                    </MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>

        <!-- 레짐 분류기 상태 카드 -->
        <MudItem xs="12" sm="6" md="4">
            <MudCard Class="h-100">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">시장 레짐 분류기</MudText>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">
                            K-Means 클러스터링 (비지도학습)
                        </MudText>
                    </CardHeaderContent>
                    <CardHeaderActions>
                        <MudIcon Icon="@Icons.Material.Filled.Radar"
                                 Color="@(_status.IsRegimeModelLoaded ? Color.Success : Color.Default)" />
                    </CardHeaderActions>
                </MudCardHeader>
                <MudCardContent>
                    <MudStack Spacing="2">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudIcon Icon="@(_status.IsRegimeModelLoaded
                                ? Icons.Material.Filled.CheckCircle
                                : Icons.Material.Filled.Cancel)"
                                     Color="@(_status.IsRegimeModelLoaded ? Color.Success : Color.Error)"
                                     Size="Size.Small" />
                            <MudText Typo="Typo.body2">
                                @(_status.IsRegimeModelLoaded ? "모델 로드됨" : "모델 없음")
                            </MudText>
                        </MudStack>

                        @if (_status.IsRegimeModelLoaded)
                        {
                            <MudText Typo="Typo.body2">
                                학습일: @(_status.RegimeModelTrainedAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "-")
                            </MudText>
                            <MudText Typo="Typo.body2">
                                학습 샘플: @_status.RegimeTrainingSamples.ToString("N0")개 (SPY 바)
                            </MudText>

                            <!-- 클러스터 레이블 표시 -->
                            @if (RegimeClassifier.ClusterLabels.Count > 0)
                            {
                                <MudDivider />
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">클러스터 맵</MudText>
                                @foreach (var (clusterId, label) in RegimeClassifier.ClusterLabels.OrderBy(kv => kv.Key))
                                {
                                    <MudChip T="string" Size="Size.Small"
                                             Color="@GetRegimeChipColor(label)">
                                        C@(clusterId): @label
                                    </MudChip>
                                }
                            }
                        }

                        <!-- 현재 레짐 게이지 -->
                        <MudDivider />
                        <MudText Typo="Typo.subtitle2">현재 시장 레짐</MudText>
                        <MudPaper Elevation="0" Class="pa-3 rounded"
                                  Style="@GetRegimeBgStyle(_currentRegimeLabel)">
                            <MudText Typo="Typo.h5" Align="Align.Center">
                                @GetRegimeIcon(_currentRegimeLabel) @_currentRegimeLabel
                            </MudText>
                        </MudPaper>
                    </MudStack>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <!-- 시그널 스코어러 상태 카드 -->
        <MudItem xs="12" sm="6" md="4">
            <MudCard Class="h-100">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">시그널 스코어러</MudText>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">
                            FastTree Binary Classification
                        </MudText>
                    </CardHeaderContent>
                    <CardHeaderActions>
                        <MudIcon Icon="@Icons.Material.Filled.ModelTraining"
                                 Color="@(_status.IsSignalScorerLoaded ? Color.Success : Color.Default)" />
                    </CardHeaderActions>
                </MudCardHeader>
                <MudCardContent>
                    <MudStack Spacing="2">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudIcon Icon="@(_status.IsSignalScorerLoaded
                                ? Icons.Material.Filled.CheckCircle
                                : Icons.Material.Filled.Cancel)"
                                     Color="@(_status.IsSignalScorerLoaded ? Color.Success : Color.Error)"
                                     Size="Size.Small" />
                            <MudText Typo="Typo.body2">
                                @(_status.IsSignalScorerLoaded ? "모델 로드됨" : "모델 없음")
                            </MudText>
                        </MudStack>

                        @if (_status.IsSignalScorerLoaded)
                        {
                            <MudText Typo="Typo.body2">
                                학습일: @(_status.SignalScorerTrainedAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "-")
                            </MudText>
                            <MudText Typo="Typo.body2">
                                학습 샘플: @_status.SignalScorerTrainingSamples.ToString("N0")개 (거래)
                            </MudText>
                            <MudText Typo="Typo.body2">
                                정확도: @_status.SignalScorerAccuracy.ToString("P1")
                            </MudText>
                        }
                    </MudStack>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <!-- 피처 중요도 차트 (항상 표시, 미학습 시 빈 상태 메시지) -->
        <MudItem xs="12" sm="6" md="6">
            <MudCard>
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">피처 중요도</MudText>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">
                            시그널 성공 예측에 가장 영향을 주는 요소
                        </MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    @if (!_status.IsSignalScorerLoaded || _status.SignalScorerFeatureImportances.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            모델이 아직 학습되지 않았습니다. 학습 후 피처 중요도가 표시됩니다.
                        </MudText>
                    }
                    else
                    {
                        @foreach (var feature in _status.SignalScorerFeatureImportances)
                        {
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
                                <MudText Typo="Typo.body2" Style="width: 100px; min-width: 80px; flex-shrink: 0; font-size: 0.75rem;">
                                    @feature.FeatureName
                                </MudText>
                                <MudProgressLinear Value="@(feature.Importance * 100)"
                                                   Max="100"
                                                   Color="Color.Primary"
                                                   Rounded="true"
                                                   Style="flex: 1;" />
                                <MudText Typo="Typo.caption" Style="width: 45px; text-align: right;">
                                    @feature.Importance.ToString("P0")
                                </MudText>
                            </MudStack>
                        }
                    }
                </MudCardContent>
            </MudCard>
        </MudItem>

        <!-- ML 개요 / 도움말 -->
        <MudItem xs="12" sm="6" md="6">
            <MudCard>
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">ML 파이프라인 개요</MudText>
                    </CardHeaderContent>
                    <CardHeaderActions>
                        <MudIcon Icon="@Icons.Material.Filled.Info" Color="Color.Info" />
                    </CardHeaderActions>
                </MudCardHeader>
                <MudCardContent>
                    <MudTimeline TimelineAlign="TimelineAlign.Start">
                        <MudTimelineItem Color="Color.Primary" Size="Size.Small">
                            <ItemContent>
                                <MudText Typo="Typo.subtitle2">1. 백테스트 실행</MudText>
                                <MudText Typo="Typo.body2" Class="mud-text-secondary">
                                    백테스트 거래 내역이 ML 학습 데이터로 사용됩니다 (최소 50건 필요).
                                </MudText>
                            </ItemContent>
                        </MudTimelineItem>
                        <MudTimelineItem Color="Color.Secondary" Size="Size.Small">
                            <ItemContent>
                                <MudText Typo="Typo.subtitle2">2. 모델 학습</MudText>
                                <MudText Typo="Typo.body2" Class="mud-text-secondary">
                                    "모델 학습" 버튼으로 K-Means 레짐 분류기 + FastTree 시그널 스코어러를 학습합니다.
                                    모델은 ml_models/ 폴더에 .zip으로 저장됩니다.
                                </MudText>
                            </ItemContent>
                        </MudTimelineItem>
                        <MudTimelineItem Color="Color.Tertiary" Size="Size.Small">
                            <ItemContent>
                                <MudText Typo="Typo.subtitle2">3. 실시간 적용</MudText>
                                <MudText Typo="Typo.body2" Class="mud-text-secondary">
                                    패턴 감지 시 ML이 자동으로 신뢰도를 보정합니다.
                                    모델이 없으면 기존 로직으로 동작합니다 (graceful degradation).
                                </MudText>
                            </ItemContent>
                        </MudTimelineItem>
                        <MudTimelineItem Color="Color.Success" Size="Size.Small">
                            <ItemContent>
                                <MudText Typo="Typo.subtitle2">4. 지속적 개선</MudText>
                                <MudText Typo="Typo.body2" Class="mud-text-secondary">
                                    더 많은 백테스트를 실행할수록 모델 성능이 향상됩니다.
                                    주기적으로 "모델 학습"을 재실행하세요.
                                </MudText>
                            </ItemContent>
                        </MudTimelineItem>
                    </MudTimeline>
                </MudCardContent>
            </MudCard>
        </MudItem>

    </MudGrid>

@code {
    [CascadingParameter(Name = "IsMobile")] private bool IsMobile { get; set; }

    private MlModelStatus _status = new();
    private MlTrainingResult? _lastTrainResult;
    private bool _isLoading;
    private bool _showHelp;
    private string _currentRegimeLabel = "알 수 없음";
    private System.Threading.Timer? _refreshTimer;

    protected override void OnInitialized()
    {
        RefreshStatus();

        // 30초마다 ML 모델 상태 갱신 (백그라운드 재학습 반영)
        _refreshTimer = new System.Threading.Timer(
            async _ =>
            {
                try
                {
                    RefreshStatus();
                    await InvokeAsync(StateHasChanged);
                }
                catch (ObjectDisposedException) { }
            },
            state: null,
            dueTime: TimeSpan.FromSeconds(30),
            period: TimeSpan.FromSeconds(30));
    }

    public void Dispose()
    {
        _refreshTimer?.Dispose();
    }

    private void RefreshStatus()
    {
        _status = MlTrainingService.GetStatus();

        // 현재 레짐 레이블 결정
        if (RegimeClassifier.ClusterLabels.Count > 0 && _status.CurrentRegimeClusterId >= 0)
        {
            _currentRegimeLabel = _status.CurrentRegimeLabel;
        }
        else if (_status.IsRegimeModelLoaded)
        {
            _currentRegimeLabel = "분류 대기";
        }
        else
        {
            _currentRegimeLabel = "모델 미학습";
        }
    }

    private async Task TrainModelsAsync()
    {
        _isLoading = true;
        _lastTrainResult = null;
        StateHasChanged();

        try
        {
            _lastTrainResult = await MlTrainingService.TrainAllAsync();
            RefreshStatus();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "ML 학습 중 UI 오류");
            _lastTrainResult = new MlTrainingResult
            {
                Success = false,
                Message = $"오류: {ex.Message}"
            };
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private static Color GetRegimeChipColor(string label) => label switch
    {
        "강세장" => Color.Success,
        "약세장" => Color.Error,
        "횡보장" => Color.Warning,
        "고변동장" => Color.Secondary,
        _ => Color.Default
    };

    private static string GetRegimeBgStyle(string label) => label switch
    {
        "강세장"   => "background: rgba(76,175,80,0.15); border: 1px solid rgba(76,175,80,0.4);",
        "약세장"   => "background: rgba(244,67,54,0.15); border: 1px solid rgba(244,67,54,0.4);",
        "횡보장"   => "background: rgba(255,193,7,0.15); border: 1px solid rgba(255,193,7,0.4);",
        "고변동장" => "background: rgba(156,39,176,0.15); border: 1px solid rgba(156,39,176,0.4);",
        _          => "background: rgba(128,128,128,0.1); border: 1px solid rgba(128,128,128,0.3);"
    };

    private static string GetRegimeIcon(string label) => label switch
    {
        "강세장"   => "▲",
        "약세장"   => "▼",
        "횡보장"   => "↔",
        "고변동장" => "⚡",
        _          => "?"
    };
}
