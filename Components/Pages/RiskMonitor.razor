@page "/risk"
@rendermode InteractiveServer
@using StockTrader.Models
@using StockTrader.Data.Repositories
@using StockTrader.Services.Risk
@using StockTrader.Services.Notification
@inject IRiskManagementService RiskService
@inject ITradeRepository TradeRepo
@inject INotificationService NotificationService
@implements IDisposable

<PageTitle>리스크 모니터 - 주식 트레이더</PageTitle>

<MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Class="mb-1">
    <MudText Typo="Typo.h5">리스크 모니터</MudText>
    <MudIconButton Icon="@Icons.Material.Filled.HelpOutline" Size="Size.Small" Color="Color.Default" OnClick="@(() => _showHelp = true)" title="도움말" />
</MudStack>
<MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">포트폴리오의 리스크 상태를 실시간으로 모니터링합니다. 일일 손실 한도(-3%)를 초과하면 자동으로 거래가 중단됩니다.</MudText>

<MudDialog @bind-Visible="_showHelp">
    <TitleContent><MudText Typo="Typo.h6">리스크 모니터 도움말</MudText></TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-2">과도한 손실을 방지하기 위한 실시간 안전장치입니다.</MudText>
        <MudList T="string" Dense="true">
            <MudListItem Icon="@Icons.Material.Filled.Circle" IconSize="Size.Small" IconColor="Color.Primary">
                <strong>일일 손실 한도 -3%</strong>: 하루 손실이 계좌의 3%에 도달하면 자동으로 신규 거래 중단
            </MudListItem>
            <MudListItem Icon="@Icons.Material.Filled.Circle" IconSize="Size.Small" IconColor="Color.Primary">
                <strong>섹터 집중 한도 2개</strong>: 같은 섹터에 최대 2개 포지션까지만 허용
            </MudListItem>
            <MudListItem Icon="@Icons.Material.Filled.Circle" IconSize="Size.Small" IconColor="Color.Primary">
                <strong>손절 거리</strong>: 현재가와 손절가의 거리(%). 가까울수록 위험
            </MudListItem>
            <MudListItem Icon="@Icons.Material.Filled.Circle" IconSize="Size.Small" IconColor="Color.Primary">
                <strong>거래 중단 후</strong>: 다음 거래일에 자동 재개됩니다
            </MudListItem>
        </MudList>
    </DialogContent>
    <DialogActions><MudButton OnClick="@(() => _showHelp = false)">닫기</MudButton></DialogActions>
</MudDialog>

@if (_loading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-2" />
}
@if (_error != null)
{
    <MudAlert Severity="Severity.Error" Class="mb-2" ShowCloseIcon="true" CloseIconClicked="() => _error = null">@_error</MudAlert>
}

<MudGrid Class="mb-4">
    <MudItem xs="12" md="6">
        <RiskGauge State="@_riskState" />
    </MudItem>
    <MudItem xs="12" md="3">
        <MudCard>
            <MudCardContent Class="text-center">
                <MudText Typo="Typo.subtitle2" Color="Color.Secondary">보유 포지션</MudText>
                <MudText Typo="Typo.h4">@_riskState.OpenPositionCount</MudText>
            </MudCardContent>
        </MudCard>
    </MudItem>
    <MudItem xs="12" md="3">
        <MudCard>
            <MudCardContent Class="text-center">
                <MudText Typo="Typo.subtitle2" Color="Color.Secondary">상태</MudText>
                @if (_riskState.IsTradingHalted)
                {
                    <MudText Typo="Typo.h5" Color="Color.Error">중단됨</MudText>
                }
                else
                {
                    <MudText Typo="Typo.h5" Color="Color.Success">활성</MudText>
                }
            </MudCardContent>
        </MudCard>
    </MudItem>
</MudGrid>

<MudGrid>
    <MudItem xs="12" md="6">
        <MudText Typo="Typo.h6" Class="mb-2">섹터별 포지션</MudText>
        @if (_riskState.PositionsPerSector.Count == 0)
        {
            <MudAlert Severity="Severity.Info">보유 포지션이 없습니다</MudAlert>
        }
        else
        {
            <MudTable Items="@_riskState.PositionsPerSector" Dense="true" Hover="true"
                      RowStyleFunc="@((KeyValuePair<string, int> kv, int _) => kv.Value >= 2 ? "background: rgba(245,127,23,0.15);" : "")">
                <HeaderContent>
                    <MudTh>섹터</MudTh>
                    <MudTh>포지션</MudTh>
                    <MudTh>한도</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.Key</MudTd>
                    <MudTd>@context.Value</MudTd>
                    <MudTd>2</MudTd>
                </RowTemplate>
            </MudTable>
        }
    </MudItem>
    <MudItem xs="12" md="6">
        <MudText Typo="Typo.h6" Class="mb-2">보유 포지션</MudText>
        @if (_openPositions.Count == 0)
        {
            <MudAlert Severity="Severity.Info">보유 포지션이 없습니다</MudAlert>
        }
        else
        {
            <MudTable Items="@_openPositions" Dense="true" Hover="true" Striped="true">
                <HeaderContent>
                    <MudTh>종목</MudTh>
                    <MudTh>섹터</MudTh>
                    <MudTh>손익</MudTh>
                    <MudTh>손절 거리</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd><b>@context.Symbol</b></MudTd>
                    <MudTd>@context.Sector</MudTd>
                    <MudTd>
                        <MudText Color="@(context.UnrealizedPnL >= 0 ? Color.Success : Color.Error)">
                            $@context.UnrealizedPnL.ToString("N2")
                        </MudText>
                    </MudTd>
                    <MudTd>
                        @{
                            // Fix 6: Infinity/NaN 방어 - EntryPrice가 0이거나 계산 결과가 유효하지 않으면 "N/A" 표시
                            string stopDistText;
                            if (context.EntryPrice == 0)
                            {
                                stopDistText = "N/A";
                            }
                            else
                            {
                                var stopDist = (double)(context.CurrentPrice - context.StopLossPrice) / (double)context.EntryPrice;
                                stopDistText = (double.IsInfinity(stopDist) || double.IsNaN(stopDist))
                                    ? "N/A"
                                    : stopDist.ToString("P1");
                            }
                        }
                        @stopDistText
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
    </MudItem>
</MudGrid>

@code {
    private bool _showHelp;
    private bool _loading;
    private string? _error;
    private RiskState _riskState = new();
    private List<StockTrader.Models.Position> _openPositions = new();

    // Throttle: allow at most one full refresh per 30 seconds.
    private long _lastRefreshTicks;
    private static readonly long RefreshThrottleTicks = TimeSpan.FromSeconds(30).Ticks;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
        // Unsubscribe first to guard against SignalR reconnect re-invocations.
        NotificationService.OnPriceUpdate -= OnPriceUpdate;
        NotificationService.OnPriceUpdate += OnPriceUpdate;
    }

    private async Task LoadDataAsync()
    {
        _loading = true;
        try
        {
            var riskTask      = RiskService.GetCurrentRiskStateAsync();
            var positionsTask = TradeRepo.GetOpenPositionsAsync();
            await Task.WhenAll(riskTask, positionsTask);
            _riskState     = riskTask.Result;
            _openPositions = positionsTask.Result;
        }
        catch (Exception ex)
        {
            _error = $"리스크 데이터 로드 실패: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    // Refresh risk data at most every 30 seconds whenever a price update arrives.
    private void OnPriceUpdate(PriceUpdate update)
    {
        var now  = DateTime.UtcNow.Ticks;
        var last = Interlocked.Read(ref _lastRefreshTicks);
        if (now - last < RefreshThrottleTicks) return;
        if (Interlocked.CompareExchange(ref _lastRefreshTicks, now, last) != last) return;

        _ = InvokeAsync(async () =>
        {
            try { await LoadDataAsync(); StateHasChanged(); }
            catch (ObjectDisposedException) { }
            catch (Exception ex) { _error = ex.Message; StateHasChanged(); }
        });
    }

    public void Dispose()
    {
        NotificationService.OnPriceUpdate -= OnPriceUpdate;
    }
}
