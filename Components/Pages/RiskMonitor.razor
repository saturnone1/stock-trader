@page "/risk"
@rendermode InteractiveServer
@using StockTrader.Models
@using StockTrader.Data.Repositories
@using StockTrader.Services.Risk
@using StockTrader.Services.Notification
@inject IRiskManagementService RiskService
@inject ITradeRepository TradeRepo
@inject ISettingsRepository SettingsRepo
@inject INotificationService NotificationService
@implements IDisposable

<PageTitle>리스크 모니터 - 주식 트레이더</PageTitle>

<div class="page-header">
    <MudText Typo="Typo.h5">리스크 모니터</MudText>
    <MudIconButton Icon="@Icons.Material.Filled.HelpOutline" Size="Size.Small" Color="Color.Default" OnClick="@(() => _showHelp = true)" title="도움말" />
    <MudTooltip Text="새로고침">
        <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Small"
                       Color="Color.Default" OnClick="@LoadDataAsync"
                       Disabled="@_loading" />
    </MudTooltip>
</div>
<MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3 page-description">리스크 규칙 준수 현황을 실시간으로 모니터링합니다. 규칙을 초과하면 신규 진입이 자동으로 차단됩니다.</MudText>

<MudDialog @bind-Visible="_showHelp">
    <TitleContent><MudText Typo="Typo.h6">리스크 모니터 도움말</MudText></TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-2">과도한 손실을 방지하기 위한 실시간 안전장치입니다.</MudText>
        <MudList T="string" Dense="true">
            <MudListItem Icon="@Icons.Material.Filled.Circle" IconSize="Size.Small" IconColor="Color.Primary">
                <strong>일일 손실 한도</strong>: 하루 손실이 설정 한도에 도달하면 신규 거래 자동 중단, 다음 거래일 재개
            </MudListItem>
            <MudListItem Icon="@Icons.Material.Filled.Circle" IconSize="Size.Small" IconColor="Color.Primary">
                <strong>최대 포지션</strong>: 동시 보유 포지션 수를 제한하여 집중 리스크 방지
            </MudListItem>
            <MudListItem Icon="@Icons.Material.Filled.Circle" IconSize="Size.Small" IconColor="Color.Primary">
                <strong>섹터 집중</strong>: 동일 섹터 내 허용 포지션 수를 제한하여 섹터 리스크 분산
            </MudListItem>
            <MudListItem Icon="@Icons.Material.Filled.Circle" IconSize="Size.Small" IconColor="Color.Primary">
                <strong>R배수</strong>: 현재 손익 / 초기 리스크. +1R = 리스크 금액만큼 수익 중
            </MudListItem>
            <MudListItem Icon="@Icons.Material.Filled.Circle" IconSize="Size.Small" IconColor="Color.Primary">
                <strong>달러 리스크</strong>: (진입가 - 손절가) × 수량. 해당 포지션 최대 손실액
            </MudListItem>
        </MudList>
    </DialogContent>
    <DialogActions><MudButton OnClick="@(() => _showHelp = false)">닫기</MudButton></DialogActions>
</MudDialog>

@if (_loading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-2" />
}
@if (_error != null)
{
    <MudAlert Severity="Severity.Error" Class="mb-2" ShowCloseIcon="true" CloseIconClicked="() => _error = null">@_error</MudAlert>
}

@* ── 섹션 1: 일일 손익 게이지 + 거래 상태 ── *@
<MudGrid Class="mb-4" Spacing="3">
    <MudItem xs="12" md="7">
        <RiskGauge State="@_riskState" DailyLossLimitPercent="@(_settings?.DailyLossLimitPercent ?? 0.03m)" />
    </MudItem>
    <MudItem xs="12" md="5">
        <MudCard Style="height:100%;">
            <MudCardContent>
                <MudStack Spacing="2">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                        <MudText Typo="Typo.subtitle2" Color="Color.Secondary">거래 상태</MudText>
                        @if (_riskState.IsTradingHalted)
                        {
                            <MudChip T="string" Color="Color.Error" Size="Size.Small"
                                     Icon="@Icons.Material.Filled.Block" Variant="Variant.Filled"
                                     Style="height:24px;">중단됨</MudChip>
                        }
                        else
                        {
                            <MudChip T="string" Color="Color.Success" Size="Size.Small"
                                     Icon="@Icons.Material.Filled.CheckCircle" Variant="Variant.Filled"
                                     Style="height:24px;">활성</MudChip>
                        }
                    </MudStack>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                        <MudText Typo="Typo.subtitle2" Color="Color.Secondary">오늘 손익</MudText>
                        <MudText Typo="Typo.body1"
                                 Color="@(_riskState.DailyPnL >= 0 ? Color.Success : Color.Error)"
                                 Style="font-weight:600;">
                            @(_riskState.DailyPnL >= 0 ? "+" : "")$@_riskState.DailyPnL.ToString("N2")
                            <MudText Typo="Typo.caption" Color="@(_riskState.DailyPnLPercent >= 0 ? Color.Success : Color.Error)"
                                     Style="display:inline; margin-left:4px;">
                                (@(_riskState.DailyPnLPercent >= 0 ? "+" : "")@_riskState.DailyPnLPercent.ToString("P2"))
                            </MudText>
                        </MudText>
                    </MudStack>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                        <MudText Typo="Typo.subtitle2" Color="Color.Secondary">마지막 갱신</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @_riskState.LastUpdated.ToLocalTime().ToString("HH:mm:ss")
                        </MudText>
                    </MudStack>
                </MudStack>
            </MudCardContent>
        </MudCard>
    </MudItem>
</MudGrid>

@* ── 섹션 2: 리스크 규칙 현황 ── *@
<MudText Typo="Typo.subtitle2" Class="section-label mb-2">
    리스크 규칙 현황
</MudText>
<MudDivider Class="mb-3" />

<MudGrid Class="mb-5" Spacing="3">

    @* 규칙 1: 일일 손실 한도 *@
    @{
        var dailyLimit    = _settings?.DailyLossLimitPercent ?? 0.03m;
        var dailyUsed     = Math.Abs(_riskState.DailyPnLPercent);
        var dailyPct      = dailyLimit > 0 ? (double)(dailyUsed / dailyLimit * 100m) : 0.0;
        var dailyStatus   = _riskState.IsTradingHalted ? RuleStatus.Exceeded
                            : dailyPct >= 80.0 ? RuleStatus.Warning
                            : RuleStatus.Ok;
    }
    <MudItem xs="12" sm="6" lg="3">
        <MudPaper Class="pa-3" Style="@GetRuleCardStyle(dailyStatus)" Elevation="1">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-1">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                    <MudIcon Icon="@Icons.Material.Filled.TrendingDown" Size="Size.Small" Color="@GetRuleIconColor(dailyStatus)" />
                    <MudText Typo="Typo.subtitle2">일일 손실 한도</MudText>
                </MudStack>
                <MudChip T="string" Size="Size.Small" Variant="Variant.Filled"
                         Color="@GetRuleChipColor(dailyStatus)"
                         Style="height:20px; font-size:10px; padding:0 8px; min-width:0;">
                    @GetRuleStatusLabel(dailyStatus)
                </MudChip>
            </MudStack>
            <MudProgressLinear Color="@GetProgressColor(dailyStatus)"
                               Value="@Math.Min(100.0, dailyPct)"
                               Rounded="true" Size="Size.Medium" Class="mb-1" />
            <MudStack Row="true" Justify="Justify.SpaceBetween">
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    현재: @dailyUsed.ToString("P2")
                </MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    한도: @dailyLimit.ToString("P0")
                </MudText>
            </MudStack>
        </MudPaper>
    </MudItem>

    @* 규칙 2: 최대 포지션 수 *@
    @{
        var maxPos    = _settings?.MaxTotalPositions ?? 7;
        var curPos    = _riskState.OpenPositionCount;
        var posPct    = maxPos > 0 ? (double)curPos / maxPos * 100.0 : 0.0;
        var posStatus = curPos >= maxPos ? RuleStatus.Exceeded
                        : posPct >= 80.0 ? RuleStatus.Warning
                        : RuleStatus.Ok;
    }
    <MudItem xs="12" sm="6" lg="3">
        <MudPaper Class="pa-3" Style="@GetRuleCardStyle(posStatus)" Elevation="1">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-1">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                    <MudIcon Icon="@Icons.Material.Filled.AccountTree" Size="Size.Small" Color="@GetRuleIconColor(posStatus)" />
                    <MudText Typo="Typo.subtitle2">최대 동시 포지션</MudText>
                </MudStack>
                <MudChip T="string" Size="Size.Small" Variant="Variant.Filled"
                         Color="@GetRuleChipColor(posStatus)"
                         Style="height:20px; font-size:10px; padding:0 8px; min-width:0;">
                    @GetRuleStatusLabel(posStatus)
                </MudChip>
            </MudStack>
            <MudProgressLinear Color="@GetProgressColor(posStatus)"
                               Value="@Math.Min(100.0, posPct)"
                               Rounded="true" Size="Size.Medium" Class="mb-1" />
            <MudStack Row="true" Justify="Justify.SpaceBetween">
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    현재: @(curPos)개
                </MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    한도: @(maxPos)개
                </MudText>
            </MudStack>
        </MudPaper>
    </MudItem>

    @* 규칙 3: 섹터 집중도 *@
    @{
        var maxSector    = _settings?.MaxPositionsPerSector ?? 2;
        var maxInSector  = _riskState.PositionsPerSector.Values.DefaultIfEmpty(0).Max();
        var sectorPct    = maxSector > 0 ? (double)maxInSector / maxSector * 100.0 : 0.0;
        var sectorStatus = maxInSector >= maxSector ? RuleStatus.Exceeded
                           : sectorPct >= 80.0 ? RuleStatus.Warning
                           : RuleStatus.Ok;
        var hotSector    = _riskState.PositionsPerSector
                               .OrderByDescending(kv => kv.Value)
                               .Select(kv => kv.Key)
                               .FirstOrDefault() ?? "-";
    }
    <MudItem xs="12" sm="6" lg="3">
        <MudPaper Class="pa-3" Style="@GetRuleCardStyle(sectorStatus)" Elevation="1">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-1">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                    <MudIcon Icon="@Icons.Material.Filled.DonutSmall" Size="Size.Small" Color="@GetRuleIconColor(sectorStatus)" />
                    <MudText Typo="Typo.subtitle2">섹터 집중도</MudText>
                </MudStack>
                <MudChip T="string" Size="Size.Small" Variant="Variant.Filled"
                         Color="@GetRuleChipColor(sectorStatus)"
                         Style="height:20px; font-size:10px; padding:0 8px; min-width:0;">
                    @GetRuleStatusLabel(sectorStatus)
                </MudChip>
            </MudStack>
            <MudProgressLinear Color="@GetProgressColor(sectorStatus)"
                               Value="@Math.Min(100.0, sectorPct)"
                               Rounded="true" Size="Size.Medium" Class="mb-1" />
            <MudStack Row="true" Justify="Justify.SpaceBetween">
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    최다: @hotSector (@(maxInSector)개)
                </MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    한도: @(maxSector)개
                </MudText>
            </MudStack>
        </MudPaper>
    </MudItem>

    @* 규칙 4: 포지션당 리스크 한도 *@
    @{
        var riskPer      = _settings?.RiskPerTradePercent ?? 0.01m;
        var accountSize  = _settings?.AccountSize ?? 100_000m;
        var maxRiskDollar = accountSize * riskPer;
        var totalDollarRisk = _openPositions
            .Sum(p => p.EntryPrice > 0
                      ? Math.Abs(p.EntryPrice - p.StopLossPrice) * p.Quantity
                      : 0m);
        var riskCapacity  = accountSize * dailyLimit;
        var riskUsedPct   = riskCapacity > 0 ? (double)(totalDollarRisk / riskCapacity * 100m) : 0.0;
        var riskStatus    = riskUsedPct >= 100.0 ? RuleStatus.Exceeded
                            : riskUsedPct >= 80.0 ? RuleStatus.Warning
                            : RuleStatus.Ok;
    }
    <MudItem xs="12" sm="6" lg="3">
        <MudPaper Class="pa-3" Style="@GetRuleCardStyle(riskStatus)" Elevation="1">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-1">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                    <MudIcon Icon="@Icons.Material.Filled.AttachMoney" Size="Size.Small" Color="@GetRuleIconColor(riskStatus)" />
                    <MudText Typo="Typo.subtitle2">총 달러 리스크</MudText>
                </MudStack>
                <MudChip T="string" Size="Size.Small" Variant="Variant.Filled"
                         Color="@GetRuleChipColor(riskStatus)"
                         Style="height:20px; font-size:10px; padding:0 8px; min-width:0;">
                    @GetRuleStatusLabel(riskStatus)
                </MudChip>
            </MudStack>
            <MudProgressLinear Color="@GetProgressColor(riskStatus)"
                               Value="@Math.Min(100.0, riskUsedPct)"
                               Rounded="true" Size="Size.Medium" Class="mb-1" />
            <MudStack Row="true" Justify="Justify.SpaceBetween">
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    현재: $@totalDollarRisk.ToString("N0")
                </MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    용량: $@riskCapacity.ToString("N0")
                </MudText>
            </MudStack>
        </MudPaper>
    </MudItem>

</MudGrid>

@* ── 섹션 3: 섹터별 포지션 ── *@
<MudText Typo="Typo.subtitle2" Class="section-label mb-2">
    섹터별 포지션
</MudText>
<MudDivider Class="mb-3" />

@if (_riskState.PositionsPerSector.Count == 0)
{
    <MudAlert Severity="Severity.Info" Class="mb-5">보유 포지션이 없습니다</MudAlert>
}
else
{
    <MudGrid Class="mb-5" Spacing="2">
        @foreach (var kv in _riskState.PositionsPerSector.OrderByDescending(x => x.Value))
        {
            var sectorMaxPos = _settings?.MaxPositionsPerSector ?? 2;
            var fillPct = sectorMaxPos > 0 ? (double)kv.Value / sectorMaxPos * 100.0 : 0.0;
            var sectorOver = kv.Value >= sectorMaxPos;
            <MudItem xs="12" sm="6" md="4">
                <MudPaper Class="pa-3"
                          Style="@(sectorOver ? "border: 1px solid rgba(244,67,54,0.5); background: rgba(244,67,54,0.05);" : "border: 1px solid var(--mud-palette-divider);")"
                          Elevation="1">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-1">
                        <MudText Typo="Typo.body2" Style="font-weight:500;">@kv.Key</MudText>
                        <MudText Typo="Typo.body2">
                            <span style="font-weight:700; color: @(sectorOver ? "var(--mud-palette-error)" : "var(--mud-palette-text-primary)")">@kv.Value</span>
                            <span style="color: var(--mud-palette-text-secondary)"> / @sectorMaxPos</span>
                        </MudText>
                    </MudStack>
                    <MudProgressLinear Color="@(sectorOver ? Color.Error : Color.Info)"
                                       Value="@Math.Min(100.0, fillPct)"
                                       Rounded="true" Size="Size.Small" />
                </MudPaper>
            </MudItem>
        }
    </MudGrid>
}

@* ── 섹션 4: 포지션별 리스크 상세 ── *@
<MudText Typo="Typo.subtitle2" Class="section-label mb-2">
    포지션별 리스크 상세
</MudText>
<MudDivider Class="mb-3" />

@if (_openPositions.Count == 0)
{
    <MudAlert Severity="Severity.Info">보유 포지션이 없습니다</MudAlert>
}
else
{
    <div class="table-scroll-wrapper">
    <MudTable Items="@_openPositions" Dense="true" Hover="true" Striped="true"
              RowStyleFunc="@((StockTrader.Models.Position p, int _) => p.UnrealizedPnL < 0 && p.StopLossPrice > 0 && p.CurrentPrice <= p.StopLossPrice * 1.02m ? "background: rgba(244,67,54,0.06);" : "")">
        <HeaderContent>
            <MudTh>종목</MudTh>
            <MudTh Class="col-hide-sm">섹터</MudTh>
            <MudTh Class="col-hide-sm">패턴</MudTh>
            <MudTh Style="text-align:right" Class="col-hide-md">보유일</MudTh>
            <MudTh Style="text-align:right">손익</MudTh>
            <MudTh Style="text-align:right" Class="col-hide-sm">달러 리스크</MudTh>
            <MudTh Style="text-align:right">R배수</MudTh>
            <MudTh Style="text-align:right" Class="col-hide-md">손절 거리</MudTh>
        </HeaderContent>
        <RowTemplate>
            @{
                // 보유일
                var daysHeld = (DateTime.UtcNow - context.OpenedAt).TotalDays;
                var daysHeldStr = daysHeld < 1.0
                    ? "오늘"
                    : $"{(int)daysHeld}일";

                // 달러 리스크 = (진입가 - 손절가) × 수량
                decimal dollarRisk = 0m;
                if (context.EntryPrice > 0 && context.StopLossPrice > 0)
                    dollarRisk = Math.Abs(context.EntryPrice - context.StopLossPrice) * context.Quantity;

                // R배수 = 현재 손익 / 초기 달러 리스크
                string rMultStr;
                if (dollarRisk > 0)
                {
                    var rMult = context.UnrealizedPnL / dollarRisk;
                    rMultStr = (rMult >= 0 ? "+" : "") + rMult.ToString("F2") + "R";
                }
                else
                {
                    rMultStr = "N/A";
                }

                // 손절 거리
                string stopDistText;
                if (context.EntryPrice == 0)
                {
                    stopDistText = "N/A";
                }
                else
                {
                    var stopDist = (double)(context.CurrentPrice - context.StopLossPrice) / (double)context.EntryPrice;
                    stopDistText = (double.IsInfinity(stopDist) || double.IsNaN(stopDist))
                        ? "N/A"
                        : stopDist.ToString("P1");
                }

                // R배수 색상
                MudBlazor.Color rColor = MudBlazor.Color.Default;
                if (dollarRisk > 0)
                {
                    var rv = context.UnrealizedPnL / dollarRisk;
                    rColor = rv >= 1m ? MudBlazor.Color.Success
                           : rv >= 0m ? MudBlazor.Color.Default
                           : MudBlazor.Color.Error;
                }
            }
            <MudTd>
                <MudText Typo="Typo.body2" Style="font-weight:700;">@context.Symbol</MudText>
            </MudTd>
            <MudTd Class="col-hide-sm">
                <MudText Typo="Typo.body2" Color="Color.Secondary">@context.Sector</MudText>
            </MudTd>
            <MudTd Class="col-hide-sm">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                    <MudText Typo="Typo.caption" Style="white-space:nowrap;">
                        @PatternMetadataMap.GetKoreanName(context.PatternType)
                    </MudText>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Filled"
                             Color="@PatternMetadataMap.GetMudColor(context.PatternType)"
                             Style="height:16px; font-size:9px; padding:0 5px; min-width:0;">
                        @PatternMetadataMap.GetStyleLabel(context.PatternType)
                    </MudChip>
                </MudStack>
            </MudTd>
            <MudTd Style="text-align:right" Class="col-hide-md">
                <MudText Typo="Typo.body2" Color="@(daysHeld > 10.0 ? Color.Warning : Color.Default)">
                    @daysHeldStr
                </MudText>
            </MudTd>
            <MudTd Style="text-align:right">
                <MudText Typo="Typo.body2"
                         Color="@(context.UnrealizedPnL >= 0 ? Color.Success : Color.Error)"
                         Style="font-weight:500;">
                    @(context.UnrealizedPnL >= 0 ? "+" : "")$@context.UnrealizedPnL.ToString("N2")
                </MudText>
            </MudTd>
            <MudTd Style="text-align:right" Class="col-hide-sm">
                <MudText Typo="Typo.body2" Color="@(dollarRisk > maxRiskDollar ? Color.Warning : Color.Default)">
                    $@dollarRisk.ToString("N0")
                </MudText>
            </MudTd>
            <MudTd Style="text-align:right">
                <MudText Typo="Typo.body2" Color="@rColor" Style="font-weight:500; font-family:monospace;">
                    @rMultStr
                </MudText>
            </MudTd>
            <MudTd Style="text-align:right" Class="col-hide-md">
                <MudText Typo="Typo.body2">@stopDistText</MudText>
            </MudTd>
        </RowTemplate>
    </MudTable>
    </div>@* /table-scroll-wrapper *@
}

@code {
    [CascadingParameter(Name = "IsMobile")] private bool IsMobile { get; set; }

    private bool _showHelp;
    private bool _loading;
    private string? _error;
    private RiskState _riskState = new();
    private List<StockTrader.Models.Position> _openPositions = new();
    private UserSettings? _settings;

    // 리스크 규칙 상태 열거형
    private enum RuleStatus { Ok, Warning, Exceeded }

    // 규칙 UI 헬퍼 메서드
    private static string GetRuleCardStyle(RuleStatus s) => s switch
    {
        RuleStatus.Exceeded => "border: 1px solid rgba(244,67,54,0.5); background: rgba(244,67,54,0.05);",
        RuleStatus.Warning  => "border: 1px solid rgba(255,152,0,0.5); background: rgba(255,152,0,0.04);",
        _                   => "border: 1px solid rgba(76,175,80,0.4); background: rgba(76,175,80,0.03);"
    };

    private static MudBlazor.Color GetRuleChipColor(RuleStatus s) => s switch
    {
        RuleStatus.Exceeded => MudBlazor.Color.Error,
        RuleStatus.Warning  => MudBlazor.Color.Warning,
        _                   => MudBlazor.Color.Success
    };

    private static MudBlazor.Color GetRuleIconColor(RuleStatus s) => s switch
    {
        RuleStatus.Exceeded => MudBlazor.Color.Error,
        RuleStatus.Warning  => MudBlazor.Color.Warning,
        _                   => MudBlazor.Color.Success
    };

    private static MudBlazor.Color GetProgressColor(RuleStatus s) => s switch
    {
        RuleStatus.Exceeded => MudBlazor.Color.Error,
        RuleStatus.Warning  => MudBlazor.Color.Warning,
        _                   => MudBlazor.Color.Success
    };

    private static string GetRuleStatusLabel(RuleStatus s) => s switch
    {
        RuleStatus.Exceeded => "초과",
        RuleStatus.Warning  => "경고",
        _                   => "정상"
    };

    // 포지션당 최대 리스크 달러 (규칙 카드에서 계산 후 테이블에서 참조)
    private decimal maxRiskDollar =>
        (_settings?.AccountSize ?? 100_000m) * (_settings?.RiskPerTradePercent ?? 0.01m);

    // Throttle: allow at most one full refresh per 30 seconds.
    private long _lastRefreshTicks;
    private static readonly long RefreshThrottleTicks = TimeSpan.FromSeconds(30).Ticks;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
        NotificationService.OnPriceUpdate -= OnPriceUpdate;
        NotificationService.OnPriceUpdate += OnPriceUpdate;
    }

    private async Task LoadDataAsync()
    {
        _loading = true;
        try
        {
            var riskTask      = RiskService.GetCurrentRiskStateAsync();
            var positionsTask = TradeRepo.GetOpenPositionsAsync();
            var settingsTask  = SettingsRepo.GetAsync();

            await Task.WhenAll(riskTask, positionsTask, settingsTask);

            _riskState     = riskTask.Result;
            _openPositions = positionsTask.Result;
            _settings      = settingsTask.Result;
        }
        catch (Exception ex)
        {
            _error = $"리스크 데이터 로드 실패: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private void OnPriceUpdate(PriceUpdate update)
    {
        var now  = DateTime.UtcNow.Ticks;
        var last = Interlocked.Read(ref _lastRefreshTicks);
        if (now - last < RefreshThrottleTicks) return;
        if (Interlocked.CompareExchange(ref _lastRefreshTicks, now, last) != last) return;

        _ = InvokeAsync(async () =>
        {
            try { await LoadDataAsync(); StateHasChanged(); }
            catch (ObjectDisposedException) { }
            catch (Exception ex) { _error = ex.Message; StateHasChanged(); }
        });
    }

    public void Dispose()
    {
        NotificationService.OnPriceUpdate -= OnPriceUpdate;
    }
}
