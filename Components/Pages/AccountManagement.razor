@page "/accounts"
@rendermode InteractiveServer
@using StockTrader.Models
@using StockTrader.Models.Enums
@using StockTrader.Services.Account
@inject IAccountManager AccountManager
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@implements IDisposable

<PageTitle>계좌 관리 - 주식 트레이더</PageTitle>

<MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
    <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
        <MudText Typo="Typo.h5">계좌 관리</MudText>
        <MudIconButton Icon="@Icons.Material.Filled.HelpOutline" Size="Size.Small"
                       Color="Color.Default" OnClick="@(() => _showHelp = true)" title="도움말" />
    </MudStack>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
               StartIcon="@Icons.Material.Filled.Add"
               OnClick="OpenAddDialogAsync">
        계좌 추가
    </MudButton>
</MudStack>

<MudDialog @bind-Visible="_showHelp">
    <TitleContent><MudText Typo="Typo.h6">계좌 관리 도움말</MudText></TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-2">여러 브로커 계좌를 등록하고 전환할 수 있습니다.</MudText>
        <MudList T="string" Dense="true">
            <MudListItem Icon="@Icons.Material.Filled.Circle" IconSize="Size.Small" IconColor="Color.Primary">
                <strong>활성 계좌</strong>: 현재 매매에 사용되는 계좌. 한 번에 1개만 활성화 가능.
            </MudListItem>
            <MudListItem Icon="@Icons.Material.Filled.Circle" IconSize="Size.Small" IconColor="Color.Primary">
                <strong>연결 테스트</strong>: API 키로 브로커 접속 및 잔고 조회를 확인합니다.
            </MudListItem>
            <MudListItem Icon="@Icons.Material.Filled.Circle" IconSize="Size.Small" IconColor="Color.Primary">
                <strong>API 키 보안</strong>: 키는 로컬 SQLite DB에 저장됩니다. 공용 PC에서는 주의하세요.
            </MudListItem>
        </MudList>
    </DialogContent>
    <DialogActions><MudButton OnClick="@(() => _showHelp = false)">닫기</MudButton></DialogActions>
</MudDialog>

@* ── 계좌 없을 때 안내 ───────────────────────────────── *@
@if (_accounts.Count == 0 && !_loading)
{
    <MudPaper Class="pa-8 text-center" Elevation="0" Outlined="true">
        <MudIcon Icon="@Icons.Material.Filled.AccountBalance" Size="Size.Large"
                 Color="Color.Secondary" Class="mb-3" Style="font-size: 3rem;" />
        <MudText Typo="Typo.h6" Color="Color.Secondary" Class="mb-2">등록된 계좌가 없습니다</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
            계좌를 추가하면 브로커 API를 통해 자동매매가 가능합니다.<br />
            계좌가 없어도 시그널 감지 및 알림 기능은 정상 동작합니다.
        </MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="OpenAddDialogAsync">
            첫 번째 계좌 추가
        </MudButton>
    </MudPaper>
}

@* ── 포트폴리오 요약 ─────────────────────────────────── *@
@if (_accounts.Count > 0)
{
    <MudGrid Class="mb-4">
        <MudItem xs="12" sm="4">
            <MudCard>
                <MudCardContent Class="text-center pa-3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">등록 계좌</MudText>
                    <MudText Typo="Typo.h5">@_accounts.Count</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudCard>
                <MudCardContent Class="text-center pa-3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">총 자산 (연결된 계좌)</MudText>
                    <MudText Typo="Typo.h5">
                        $@_connectionStatuses.Where(s => s.IsConnected).Sum(s => s.TotalEquity).ToString("N0")
                    </MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudCard>
                <MudCardContent Class="text-center pa-3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">연결 상태</MudText>
                    <MudText Typo="Typo.h5"
                             Color="@(_connectionStatuses.Any(s => s.IsConnected) ? Color.Success : Color.Error)">
                        @_connectionStatuses.Count(s => s.IsConnected) / @_connectionStatuses.Count 연결됨
                    </MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>
}

@* ── 계좌 카드 목록 ──────────────────────────────────── *@
@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-3" />
}

<MudGrid>
    @foreach (var account in _accounts)
    {
        var status = _connectionStatuses.FirstOrDefault(s => s.AccountId == account.Id);
        var isActive = account.IsActive;
        var isConnected = status?.IsConnected ?? false;

        <MudItem xs="12" md="6" lg="4">
            <MudCard Outlined="@(!isActive)"
                     Style="@(isActive ? "border: 2px solid var(--mud-palette-primary); box-shadow: 0 0 12px rgba(21,101,192,0.3);" : "")">
                <MudCardHeader>
                    <CardHeaderAvatar>
                        <MudAvatar Color="@GetBrokerColor(account.BrokerType)" Rounded="true" Size="Size.Medium">
                            <MudIcon Icon="@GetBrokerIcon(account.BrokerType)" />
                        </MudAvatar>
                    </CardHeaderAvatar>
                    <CardHeaderContent>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            <MudText Typo="Typo.subtitle1" Style="font-weight:600;">@account.AccountName</MudText>
                            @if (isActive)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Primary"
                                         Variant="Variant.Filled" Class="ml-1">활성</MudChip>
                            }
                        </MudStack>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @account.BrokerType.ToString()
                            @if (!string.IsNullOrEmpty(account.Environment))
                            {
                                <span> · @account.Environment</span>
                            }
                        </MudText>
                    </CardHeaderContent>
                    <CardHeaderActions>
                        <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Dense="true">
                            @if (!isActive)
                            {
                                <MudMenuItem Icon="@Icons.Material.Filled.RadioButtonChecked"
                                             OnClick="@(() => SetActiveAsync(account.Id))">
                                    활성 계좌로 전환
                                </MudMenuItem>
                            }
                            <MudMenuItem Icon="@Icons.Material.Filled.Edit"
                                         OnClick="@(() => OpenEditDialogAsync(account))">
                                수정
                            </MudMenuItem>
                            <MudMenuItem Icon="@Icons.Material.Filled.Delete"
                                         Style="color: var(--mud-palette-error);"
                                         OnClick="@(() => DeleteAccountAsync(account))">
                                삭제
                            </MudMenuItem>
                        </MudMenu>
                    </CardHeaderActions>
                </MudCardHeader>

                <MudCardContent Class="pt-0">
                    @* API 키 표시 (마스킹) *@
                    <MudStack Spacing="1" Class="mb-3">
                        <MudStack Row="true" Spacing="1">
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Style="min-width:70px;">API Key</MudText>
                            <MudText Typo="Typo.caption"><code>@MaskApiKey(account.ApiKey)</code></MudText>
                        </MudStack>
                        @if (!string.IsNullOrWhiteSpace(account.Notes))
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@account.Notes</MudText>
                        }
                    </MudStack>

                    @* 연결 상태 *@
                    @if (status != null)
                    {
                        <MudPaper Outlined="true" Class="pa-2"
                                  Style="@GetStatusPaperStyle(isConnected)">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Wrap="Wrap.Wrap">
                                <MudIcon Icon="@(isConnected ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Cancel)"
                                         Size="Size.Small"
                                         Color="@(isConnected ? Color.Success : Color.Error)" />
                                <MudText Typo="Typo.caption" Style="font-weight:600;">
                                    @(isConnected ? "연결됨" : "연결 실패")
                                </MudText>
                                @if (isConnected)
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        · 자산: <strong>$@status.TotalEquity.ToString("N0")</strong>
                                        · 가용: <strong>$@status.BuyingPower.ToString("N0")</strong>
                                        · 포지션: <strong>@status.OpenPositionCount</strong>개
                                    </MudText>
                                }
                                else
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Error">@status.StatusMessage</MudText>
                                }
                            </MudStack>
                        </MudPaper>
                    }
                    else
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">연결 상태 확인 중...</MudText>
                    }

                    @* 마지막 연결 시각 *@
                    @if (account.LastConnectedAt.HasValue)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Tertiary" Class="mt-1">
                            마지막 연결: @account.LastConnectedAt.Value.ToLocalTime().ToString("MM/dd HH:mm")
                        </MudText>
                    }
                </MudCardContent>

                <MudCardActions>
                    <MudButton Size="Size.Small" StartIcon="@Icons.Material.Filled.Refresh"
                               OnClick="@(() => RefreshConnectionStatusAsync(account.Id))"
                               Disabled="@_checkingConnections.Contains(account.Id)">
                        @if (_checkingConnections.Contains(account.Id))
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
                        }
                        연결 테스트
                    </MudButton>
                    @if (!isActive)
                    {
                        <MudButton Size="Size.Small" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.RadioButtonChecked"
                                   OnClick="@(() => SetActiveAsync(account.Id))">
                            활성화
                        </MudButton>
                    }
                </MudCardActions>
            </MudCard>
        </MudItem>
    }
</MudGrid>

@* ── 계좌 추가/수정 다이얼로그 ──────────────────────── *@
<MudDialog @bind-Visible="_showAccountDialog" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">
            @(_editingAccount?.Id > 0 ? "계좌 수정" : "계좌 추가")
        </MudText>
    </TitleContent>
    <DialogContent>
        @if (_editingAccount != null)
        {
            <MudForm @ref="_form" @bind-IsValid="_formValid">
                <MudStack Spacing="3">
                    <MudTextField @bind-Value="_editingAccount.AccountName"
                                  Label="계좌 별칭"
                                  Placeholder="예: Alpaca Paper #1"
                                  Variant="Variant.Outlined"
                                  Required="true"
                                  RequiredError="계좌 별칭을 입력하세요."
                                  MaxLength="100" />

                    <MudSelect T="BrokerType" @bind-Value="_editingAccount.BrokerType"
                               Label="브로커"
                               Variant="Variant.Outlined"
                               Required="true">
                        @foreach (var bt in Enum.GetValues<BrokerType>())
                        {
                            <MudSelectItem T="BrokerType" Value="@bt">
                                @GetBrokerDisplayName(bt)
                            </MudSelectItem>
                        }
                    </MudSelect>

                    @if (_editingAccount.BrokerType == BrokerType.Alpaca)
                    {
                        <MudSelect T="string" @bind-Value="_editingAccount.Environment"
                                   Label="환경"
                                   Variant="Variant.Outlined">
                            <MudSelectItem T="string" Value="@("Paper")">Paper (모의투자)</MudSelectItem>
                            <MudSelectItem T="string" Value="@("Live")">Live (실거래)</MudSelectItem>
                        </MudSelect>
                    }

                    <MudTextField @bind-Value="_editingAccount.ApiKey"
                                  Label="API Key"
                                  Placeholder="브로커 API 키"
                                  Variant="Variant.Outlined"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@(_showApiKey ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)"
                                  OnAdornmentClick="@(() => _showApiKey = !_showApiKey)"
                                  InputType="@(_showApiKey ? InputType.Text : InputType.Password)" />

                    <MudTextField @bind-Value="_editingAccount.ApiSecret"
                                  Label="API Secret"
                                  Placeholder="브로커 API 시크릿"
                                  Variant="Variant.Outlined"
                                  InputType="@(_showApiSecret ? InputType.Text : InputType.Password)"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@(_showApiSecret ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)"
                                  OnAdornmentClick="@(() => _showApiSecret = !_showApiSecret)" />

                    <MudTextField @bind-Value="_editingAccount.Notes"
                                  Label="메모 (선택)"
                                  Placeholder="계좌에 대한 메모를 입력하세요"
                                  Variant="Variant.Outlined"
                                  Lines="2"
                                  MaxLength="500" />

                    @if (_editingAccount.BrokerType != BrokerType.Alpaca)
                    {
                        <MudAlert Severity="Severity.Warning">
                            @GetBrokerDisplayName(_editingAccount.BrokerType) 브로커는 현재 구현 예정 상태입니다.
                            계좌 등록은 가능하지만 실제 주문 실행은 지원되지 않습니다.
                        </MudAlert>
                    }

                    <MudPaper Outlined="true" Class="pa-2" Style="border-color:rgba(255,193,7,0.3);background:rgba(255,193,7,0.04);">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            <MudIcon Icon="@Icons.Material.Filled.Security" Size="Size.Small" Color="Color.Warning" />
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                API 키는 로컬 SQLite DB에 저장됩니다. 공용 PC에서는 사용 후 계좌를 삭제하세요.
                            </MudText>
                        </MudStack>
                    </MudPaper>
                </MudStack>
            </MudForm>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _showAccountDialog = false)" Color="Color.Default">취소</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   Disabled="@(!_formValid || _savingAccount)"
                   OnClick="SaveAccountAsync">
            @if (_savingAccount)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
            }
            저장
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private bool _showHelp;
    private bool _loading = true;
    private List<TradingAccount> _accounts = new();
    private List<AccountConnectionStatus> _connectionStatuses = new();
    private HashSet<int> _checkingConnections = new();

    // 다이얼로그 상태
    private bool _showAccountDialog;
    private TradingAccount? _editingAccount;
    private MudForm? _form;
    private bool _formValid;
    private bool _savingAccount;
    private bool _showApiKey;
    private bool _showApiSecret;

    private readonly DialogOptions _dialogOptions = new()
    {
        MaxWidth = MaxWidth.Small,
        FullWidth = true,
        CloseOnEscapeKey = true
    };

    protected override async Task OnInitializedAsync()
    {
        AccountManager.OnAccountsChanged += OnAccountsChanged;
        await LoadAccountsAsync();
    }

    private string? _error;

    private async Task LoadAccountsAsync()
    {
        _loading = true;
        _error = null;

        try
        {
            _accounts = await AccountManager.GetAllAccountsAsync();

            // 연결 상태 병렬 조회 (백그라운드, 타임아웃 5초)
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(5));
            try
            {
                _connectionStatuses = await AccountManager.GetAllConnectionStatusAsync(cts.Token);
            }
            catch (OperationCanceledException)
            {
                _connectionStatuses = _accounts.Select(a => new AccountConnectionStatus
                {
                    AccountId = a.Id,
                    StatusMessage = "응답 시간 초과"
                }).ToList();
            }
        }
        catch (Exception ex)
        {
            _error = $"계좌 로드 실패: {ex.Message}";
            _accounts = new();
        }
        finally
        {
            _loading = false;
        }
    }

    private async void OnAccountsChanged()
    {
        try
        {
            await InvokeAsync(async () =>
            {
                await LoadAccountsAsync();
                StateHasChanged();
            });
        }
        catch (ObjectDisposedException) { }
    }

    private void OpenAddDialogAsync()
    {
        _editingAccount = new TradingAccount
        {
            BrokerType = BrokerType.Alpaca,
            Environment = "Paper",
            IsEnabled = true
        };
        _showApiKey = false;
        _showApiSecret = false;
        _showAccountDialog = true;
    }

    private void OpenEditDialogAsync(TradingAccount account)
    {
        // 편집용 복사본 생성 (원본 직접 수정 방지)
        _editingAccount = new TradingAccount
        {
            Id = account.Id,
            AccountName = account.AccountName,
            BrokerType = account.BrokerType,
            ApiKey = account.ApiKey,
            ApiSecret = account.ApiSecret,
            Environment = account.Environment,
            IsActive = account.IsActive,
            IsEnabled = account.IsEnabled,
            Notes = account.Notes,
            CreatedAt = account.CreatedAt
        };
        _showApiKey = false;
        _showApiSecret = false;
        _showAccountDialog = true;
    }

    private async Task SaveAccountAsync()
    {
        if (_editingAccount == null) return;
        await _form!.Validate();
        if (!_formValid) return;

        _savingAccount = true;
        try
        {
            if (_editingAccount.Id == 0)
            {
                await AccountManager.AddAccountAsync(_editingAccount);
                Snackbar.Add("계좌가 추가되었습니다.", Severity.Success);
            }
            else
            {
                await AccountManager.UpdateAccountAsync(_editingAccount);
                Snackbar.Add("계좌가 수정되었습니다.", Severity.Success);
            }
            _showAccountDialog = false;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"저장 실패: {ex.Message}", Severity.Error);
        }
        finally
        {
            _savingAccount = false;
        }
    }

    private async Task SetActiveAsync(int accountId)
    {
        try
        {
            await AccountManager.SetActiveAccountAsync(accountId);
            Snackbar.Add("활성 계좌가 전환되었습니다.", Severity.Success);
            await LoadAccountsAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"전환 실패: {ex.Message}", Severity.Error);
        }
    }

    private async Task DeleteAccountAsync(TradingAccount account)
    {
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { x => x.Title, "계좌 삭제" },
            { x => x.Message, $"[{account.AccountName}] 계좌를 삭제하시겠습니까? 이 작업은 되돌릴 수 없습니다." },
            { x => x.ConfirmText, "삭제" },
            { x => x.ConfirmColor, Color.Error }
        };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>("계좌 삭제", parameters);
        var result = await dialog.Result;
        if (result is null || result.Canceled) return;

        try
        {
            await AccountManager.DeleteAccountAsync(account.Id);
            Snackbar.Add("계좌가 삭제되었습니다.", Severity.Info);
            await LoadAccountsAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"삭제 실패: {ex.Message}", Severity.Error);
        }
    }

    private async Task RefreshConnectionStatusAsync(int accountId)
    {
        _checkingConnections.Add(accountId);
        StateHasChanged();

        try
        {
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(10));
            var status = await AccountManager.GetConnectionStatusAsync(accountId, cts.Token);

            var existing = _connectionStatuses.FirstOrDefault(s => s.AccountId == accountId);
            if (existing != null)
                _connectionStatuses.Remove(existing);
            _connectionStatuses.Add(status);

            if (status.IsConnected)
                Snackbar.Add($"연결 성공 — 자산: ${status.TotalEquity:N0}", Severity.Success);
            else
                Snackbar.Add($"연결 실패: {status.StatusMessage}", Severity.Warning);

            // 계좌 목록 갱신 (LastConnectedAt 업데이트 반영)
            _accounts = await AccountManager.GetAllAccountsAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"연결 확인 오류: {ex.Message}", Severity.Error);
        }
        finally
        {
            _checkingConnections.Remove(accountId);
            StateHasChanged();
        }
    }

    // ── 헬퍼 메서드 ──────────────────────────────────────────────────────

    private static string MaskApiKey(string? key)
    {
        if (string.IsNullOrWhiteSpace(key)) return "(미설정)";
        if (key.Length <= 8) return new string('*', key.Length);
        return key[..4] + new string('*', key.Length - 8) + key[^4..];
    }

    private static Color GetBrokerColor(BrokerType brokerType) => brokerType switch
    {
        BrokerType.Alpaca => Color.Primary,
        BrokerType.KoreaInvestment => Color.Warning,
        BrokerType.Kiwoom => Color.Success,
        _ => Color.Default
    };

    private static string GetBrokerIcon(BrokerType brokerType) => brokerType switch
    {
        BrokerType.Alpaca => Icons.Material.Filled.TrendingUp,
        BrokerType.KoreaInvestment => Icons.Material.Filled.AccountBalance,
        BrokerType.Kiwoom => Icons.Material.Filled.AccountBalance,
        _ => Icons.Material.Filled.Business
    };

    private static string GetBrokerDisplayName(BrokerType brokerType) => brokerType switch
    {
        BrokerType.Alpaca => "Alpaca Markets",
        BrokerType.KoreaInvestment => "한국투자증권",
        BrokerType.Kiwoom => "키움증권",
        _ => brokerType.ToString()
    };

    private static string GetStatusPaperStyle(bool isConnected) => isConnected
        ? "border-color: rgba(76,175,80,0.4); background: rgba(76,175,80,0.06);"
        : "border-color: rgba(198,40,40,0.4); background: rgba(198,40,40,0.06);";

    public void Dispose()
    {
        AccountManager.OnAccountsChanged -= OnAccountsChanged;
    }
}
