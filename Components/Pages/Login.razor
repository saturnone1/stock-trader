@page "/login"
@layout EmptyLayout
@using System.Text.Json
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>로그인 — 주식 트레이더</PageTitle>

<MudThemeProvider IsDarkMode="true" />

<div style="min-height: 100vh; display: flex; align-items: center; justify-content: center;
            background: #121212;">
    <MudContainer MaxWidth="MaxWidth.ExtraSmall">
        <MudStack Spacing="4" AlignItems="AlignItems.Center">

            @* 로고 영역 *@
            <MudStack Row="false" AlignItems="AlignItems.Center" Spacing="1">
                <MudIcon Icon="@Icons.Material.Filled.ShowChart"
                         Style="font-size: 3rem; color: #1565C0;" />
                <MudText Typo="Typo.h5" Style="font-weight: 700; letter-spacing: 0.02em;">
                    주식 트레이더
                </MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    자동매매 관리 시스템
                </MudText>
            </MudStack>

            @* 로그인 카드 *@
            <MudPaper Elevation="4" Class="pa-6" Style="width: 100%; border-radius: 12px;
                      background: #1E1E1E; border: 1px solid rgba(255,255,255,0.07);">
                <MudStack Spacing="4">

                    <MudText Typo="Typo.h6" Style="font-weight: 600;">로그인</MudText>

                    @if (_isLocked)
                    {
                        <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-0"
                                  Icon="@Icons.Material.Filled.LockClock">
                            계정이 잠겼습니다. 잠시 후 재시도하세요.
                        </MudAlert>
                    }
                    else if (!string.IsNullOrEmpty(_errorMessage))
                    {
                        <MudAlert Severity="Severity.Error" Dense="true" Class="mb-0"
                                  Icon="@Icons.Material.Filled.Lock">
                            @_errorMessage
                        </MudAlert>
                    }

                    <MudTextField @bind-Value="_username"
                                  Label="아이디"
                                  Variant="Variant.Outlined"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Person"
                                  Disabled="@(_isLoading || _isLocked)"
                                  Immediate="true"
                                  OnKeyDown="@OnKeyDown"
                                  autocomplete="username" />

                    <MudTextField @bind-Value="_password"
                                  Label="비밀번호"
                                  Variant="Variant.Outlined"
                                  InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@(_showPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                                  OnAdornmentClick="@(() => _showPassword = !_showPassword)"
                                  Disabled="@(_isLoading || _isLocked)"
                                  Immediate="true"
                                  OnKeyDown="@OnKeyDown"
                                  autocomplete="current-password" />

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               FullWidth="true"
                               Size="Size.Large"
                               OnClick="@LoginAsync"
                               Disabled="@(_isLoading || _isLocked || string.IsNullOrWhiteSpace(_username) || string.IsNullOrWhiteSpace(_password))"
                               Style="height: 48px; font-size: 1rem; font-weight: 600;">
                        @if (_isLoading)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                            <span>로그인 중...</span>
                        }
                        else
                        {
                            <span>로그인</span>
                        }
                    </MudButton>

                </MudStack>
            </MudPaper>

            <MudText Typo="Typo.caption" Color="Color.Secondary">
                StockTrader v1.0 &mdash; 24시간 자동매매
            </MudText>

        </MudStack>
    </MudContainer>
</div>

@code {
    private string _username = string.Empty;
    private string _password = string.Empty;
    private bool _showPassword;
    private bool _isLoading;
    private bool _isLocked;
    private string _errorMessage = string.Empty;

    private IJSObjectReference? _jsModule;

    protected override void OnInitialized()
    {
        // 이미 인증된 상태면 대시보드로 이동 (prerender 단계에서 HttpContext 사용)
        var isAuthenticated = HttpContextAccessor.HttpContext?.User?.Identity?.IsAuthenticated == true;
        if (isAuthenticated)
        {
            Navigation.NavigateTo("/", forceLoad: true);
        }
    }

    private async Task<IJSObjectReference> GetJsModuleAsync()
    {
        _jsModule ??= await JS.InvokeAsync<IJSObjectReference>(
            "import", "./js/auth.js");
        return _jsModule;
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !_isLoading && !_isLocked
            && !string.IsNullOrWhiteSpace(_username)
            && !string.IsNullOrWhiteSpace(_password))
        {
            await LoginAsync();
        }
    }

    private async Task LoginAsync()
    {
        _errorMessage = string.Empty;
        _isLoading = true;
        StateHasChanged();

        try
        {
            var module = await GetJsModuleAsync();
            var result = await module.InvokeAsync<AuthResult>(
                "authFetch", "/api/auth/login", "POST",
                new { username = _username, password = _password });

            if (result.Ok)
            {
                Navigation.NavigateTo("/", forceLoad: true);
                return;
            }

            if (result.Status == 429)
            {
                _isLocked = true;
                _errorMessage = string.Empty;
            }
            else if (result.Status == 401)
            {
                var errorMsg = TryGetErrorMessage(result.Data);
                _errorMessage = errorMsg ?? "아이디 또는 비밀번호가 올바르지 않습니다.";
            }
            else
            {
                _errorMessage = $"로그인 실패 ({result.Status}). 잠시 후 다시 시도하세요.";
            }
        }
        catch
        {
            _errorMessage = "서버에 연결할 수 없습니다.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private static string? TryGetErrorMessage(object? data)
    {
        if (data is JsonElement el && el.ValueKind == JsonValueKind.Object
            && el.TryGetProperty("error", out var errProp))
            return errProp.GetString();
        return null;
    }

    private sealed class AuthResult
    {
        public bool Ok { get; set; }
        public int Status { get; set; }
        public object? Data { get; set; }
    }
}
