@page "/backtest/tqqq"
@rendermode InteractiveServer
@using StockTrader.Models
@using StockTrader.Models.Enums
@using StockTrader.Services.Backtest
@inject TqqqWeightBacktester TqqqBacktester
@inject ISnackbar Snackbar

<PageTitle>TQQQ 비중 백테스트 - 주식 트레이더</PageTitle>

<MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Class="mb-1">
    <MudText Typo="Typo.h5">TQQQ 비중 백테스트</MudText>
    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined"
             Style="height:20px; font-size:11px; padding:0 8px;">200일선 변형매매</MudChip>
</MudStack>
<MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
    fmkorea "200일 티큐 변형매매법" 기반. TQQQ/SPY 200일선 대비 비중을 매일 0~100%로 조절하는 포지션 관리 전략입니다.
</MudText>

@* 설정 카드 *@
<MudCard Class="mb-4">
    <MudCardContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mb-3">
            <MudIcon Icon="@Icons.Material.Filled.Settings" Size="Size.Small" Color="Color.Default" />
            <MudText Typo="Typo.h6">설정</MudText>
        </MudStack>

        <MudText Typo="Typo.caption" Color="Color.Tertiary" Class="mb-1"
                 Style="font-weight:600; letter-spacing:0.04em; text-transform:uppercase;">기본 설정</MudText>
        <MudGrid>
            <MudItem xs="12" md="3">
                <MudDatePicker @bind-Date="_from" Label="시작일"
                               Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" md="3">
                <MudDatePicker @bind-Date="_to" Label="종료일"
                               Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" md="2">
                <MudNumericField @bind-Value="_capital" Label="초기 자본금"
                                 Variant="Variant.Outlined" Margin="Margin.Dense" Format="N0"
                                 HelperText="USD" />
            </MudItem>
            <MudItem xs="12" md="2">
                <MudSelect T="DataSource?" @bind-Value="_dataSource" Label="데이터 소스"
                           Variant="Variant.Outlined" Margin="Margin.Dense">
                    <MudSelectItem T="DataSource?" Value="@((DataSource?)null)">기본 설정</MudSelectItem>
                    <MudSelectItem T="DataSource?" Value="DataSource.Alpaca">Alpaca</MudSelectItem>
                    <MudSelectItem T="DataSource?" Value="DataSource.Yahoo">Yahoo Finance</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="2" Class="d-flex align-end">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                           OnClick="RunTqqqBacktestAsync" Disabled="@_isRunning">
                    @if (_isRunning)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    }
                    백테스트 실행
                </MudButton>
            </MudItem>
        </MudGrid>

        @* 전략 파라미터 (접힌 상태) *@
        <MudExpansionPanels Class="mt-3" MultiExpansion="true">
            <MudExpansionPanel Text="전략 파라미터 (고급)" Expanded="false">
                <MudText Typo="Typo.caption" Color="Color.Tertiary" Class="mb-2"
                         Style="font-weight:600; letter-spacing:0.04em; text-transform:uppercase;">기본 스위치</MudText>
                <MudGrid Spacing="2">
                    <MudItem xs="12" sm="6" md="4" lg="3">
                        <MudSwitch @bind-Value="_params.UseSpyFilter" Label="SPY 필터 사용"
                                   Color="Color.Primary" />
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4" lg="3">
                        <MudSwitch @bind-Value="_params.UseOverheatSplit" Label="과열 감량 사용"
                                   Color="Color.Warning" />
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4" lg="3">
                        <MudSwitch @bind-Value="_params.UsePrincipalStop" Label="원금보호 손절 사용"
                                   Color="Color.Error" />
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4" lg="3">
                        <MudSwitch @bind-Value="_params.UseTp10" Label="TP10 사용"
                                   Color="Color.Success" />
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4" lg="3">
                        <MudSwitch @bind-Value="_params.UseSlopeBoost" Label="기울기 부스트 사용"
                                   Color="Color.Info" />
                    </MudItem>
                </MudGrid>

                <MudDivider Class="my-3" />

                <MudText Typo="Typo.caption" Color="Color.Tertiary" Class="mb-2"
                         Style="font-weight:600; letter-spacing:0.04em; text-transform:uppercase;">수치 파라미터</MudText>
                <MudGrid Spacing="2">
                    <MudItem xs="12" sm="6" md="4">
                        <MudNumericField @bind-Value="_params.VolThreshold" Label="변동성 임계값"
                                         Variant="Variant.Outlined" Margin="Margin.Dense"
                                         Format="F3" Step="0.001m"
                                         HelperText="기본 0.059 (20일 변동성 락 기준)" />
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4">
                        <MudNumericField @bind-Value="_params.Dist200Enter" Label="200일선 진입 이격도 (%)"
                                         Variant="Variant.Outlined" Margin="Margin.Dense"
                                         Format="F2" Step="0.5m"
                                         HelperText="기본 101.0 — TQQQ/MA200 × 100 이상이면 진입" />
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4">
                        <MudNumericField @bind-Value="_params.Dist200Exit" Label="200일선 퇴장 이격도 (%)"
                                         Variant="Variant.Outlined" Margin="Margin.Dense"
                                         Format="F2" Step="0.5m"
                                         HelperText="기본 100.0 — TQQQ/MA200 × 100 이하이면 퇴장" />
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4">
                        <MudNumericField @bind-Value="_params.PrincipalStopPct" Label="원금보호 손절 비율"
                                         Variant="Variant.Outlined" Margin="Margin.Dense"
                                         Format="F3" Step="0.001m"
                                         HelperText="기본 0.941 — 진입가 대비 이 비율 이하 시 청산" />
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4">
                        <MudNumericField @bind-Value="_params.Tp10Trigger" Label="TP10 트리거 수익률"
                                         Variant="Variant.Outlined" Margin="Margin.Dense"
                                         Format="F2" Step="0.01m"
                                         HelperText="기본 0.10 — 10% 수익 달성 시 95%로 감량" />
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4">
                        <MudNumericField @bind-Value="_params.SlopeThr" Label="기울기 부스트 임계값 (%/일)"
                                         Variant="Variant.Outlined" Margin="Margin.Dense"
                                         Format="F4" Step="0.001m"
                                         HelperText="기본 0.1100 — 45일 기울기 이 이상이면 조기 진입" />
                    </MudItem>
                </MudGrid>
            </MudExpansionPanel>
        </MudExpansionPanels>
    </MudCardContent>
</MudCard>

@* 로딩 *@
@if (_isRunning)
{
    <MudCard Class="mb-4 pa-4">
        <MudStack AlignItems="AlignItems.Center" Spacing="3">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
            <MudText Color="Color.Secondary">TQQQ/QQQ/SPY 일봉 데이터 수신 및 백테스트 실행 중...</MudText>
            <MudText Typo="Typo.caption" Color="Color.Tertiary">초기 실행 시 200일 워밍업 구간 데이터를 추가로 조회합니다.</MudText>
        </MudStack>
    </MudCard>
}

@* 에러 *@
@if (!string.IsNullOrEmpty(_error))
{
    <MudAlert Severity="Severity.Error" Class="mb-4" ShowCloseIcon="true"
              CloseIconClicked="@(() => _error = null)">
        <strong>백테스트 실패:</strong> @_error
    </MudAlert>
}

@* 결과 *@
@if (_tqqqResult != null)
{
    var returnBorderColor = _tqqqResult.TotalReturnPercent >= 0
        ? "var(--mud-palette-success)"
        : "var(--mud-palette-error)";
    var sharpeBorderColor = _tqqqResult.SharpeRatio >= 1
        ? "var(--mud-palette-success)"
        : _tqqqResult.SharpeRatio >= 0
            ? "var(--mud-palette-warning)"
            : "var(--mud-palette-error)";

    @* 요약 카드 4개 *@
    <MudGrid Class="mb-4">
        <MudItem xs="6" sm="3">
            <MudCard Style="@($"border-left: 3px solid {returnBorderColor};")">
                <MudCardContent Class="text-center pa-3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">총수익률</MudText>
                    <MudText Typo="Typo.h5"
                             Color="@(_tqqqResult.TotalReturnPercent >= 0 ? Color.Success : Color.Error)"
                             Style="font-weight:700;">
                        @(_tqqqResult.TotalReturnPercent >= 0 ? "+" : "")@(_tqqqResult.TotalReturnPercent.ToString("F1"))%
                    </MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="6" sm="3">
            <MudCard Style="border-left: 3px solid var(--mud-palette-info);">
                <MudCardContent Class="text-center pa-3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">연평균 수익률 (CAGR)</MudText>
                    <MudText Typo="Typo.h5" Color="Color.Info" Style="font-weight:700;">
                        @(_tqqqResult.Cagr.ToString("F1"))%
                    </MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="6" sm="3">
            <MudCard Style="border-left: 3px solid var(--mud-palette-error);">
                <MudCardContent Class="text-center pa-3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">최대 낙폭 (MDD)</MudText>
                    <MudText Typo="Typo.h5" Color="Color.Error" Style="font-weight:700;">
                        -@(_tqqqResult.MaxDrawdownPercent.ToString("F1"))%
                    </MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="6" sm="3">
            <MudCard Style="@($"border-left: 3px solid {sharpeBorderColor};")">
                <MudCardContent Class="text-center pa-3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">샤프 비율</MudText>
                    <MudText Typo="Typo.h5"
                             Color="@(_tqqqResult.SharpeRatio >= 1 ? Color.Success : _tqqqResult.SharpeRatio >= 0 ? Color.Warning : Color.Error)"
                             Style="font-weight:700;">
                        @(_tqqqResult.SharpeRatio.ToString("F3"))
                    </MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>

    @* 추가 정보 *@
    <MudCard Class="mb-4 pa-3">
        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="4" AlignItems="AlignItems.Center">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                <MudIcon Icon="@Icons.Material.Filled.CalendarToday" Size="Size.Small" Color="Color.Secondary" />
                <MudText Typo="Typo.body2" Color="Color.Secondary">총 거래일:</MudText>
                <MudText Typo="Typo.body2"><strong>@(_tqqqResult.TotalDays.ToString("N0"))</strong>일</MudText>
            </MudStack>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Size="Size.Small" Color="Color.Primary" />
                <MudText Typo="Typo.body2" Color="Color.Secondary">투자 일수:</MudText>
                <MudText Typo="Typo.body2"><strong>@(_tqqqResult.InvestedDays.ToString("N0"))</strong>일</MudText>
            </MudStack>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                <MudIcon Icon="@Icons.Material.Filled.Percent" Size="Size.Small" Color="Color.Info" />
                <MudText Typo="Typo.body2" Color="Color.Secondary">투자 비율:</MudText>
                <MudText Typo="Typo.body2" Color="Color.Info">
                    <strong>@(_tqqqResult.TotalDays > 0 ? ((decimal)_tqqqResult.InvestedDays / _tqqqResult.TotalDays * 100).ToString("F1") : "0.0")%</strong>
                </MudText>
            </MudStack>
        </MudStack>
    </MudCard>

    @* 매매 타점 차트 *@
    @if (_priceChartData.Count > 1)
    {
        <MudText Typo="Typo.h6" Class="mb-2">매매 타점</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">초록 영역 = 투자 구간, 빈 구간 = 현금</MudText>
        <MudCard Class="mb-4 pa-3">
            <ApexCharts.ApexChart TItem="TqqqChartPoint" Options="_priceChartOptions" Height="350">
                <ApexCharts.ApexPointSeries TItem="TqqqChartPoint"
                                 Items="_priceChartData"
                                 SeriesType="ApexCharts.SeriesType.Line"
                                 Name="TQQQ 종가"
                                 XValue="@(p => p.Date.ToString("yyyy-MM-dd"))"
                                 YAggregate="@(p => p.Last().TqqqClose)" />
                <ApexCharts.ApexPointSeries TItem="TqqqChartPoint"
                                 Items="_priceChartData"
                                 SeriesType="ApexCharts.SeriesType.Area"
                                 Name="투자 구간"
                                 XValue="@(p => p.Date.ToString("yyyy-MM-dd"))"
                                 YAggregate="@(p => p.Last().InvestedClose)" />
            </ApexCharts.ApexChart>
        </MudCard>
    }

    @* 자산 추이 차트 *@
    @if (_chartData.Count > 1)
    {
        <MudText Typo="Typo.h6" Class="mb-2">자산 추이</MudText>
        <MudCard Class="mb-4 pa-3">
            <ApexCharts.ApexChart TItem="TqqqDailyRecord" Options="_equityChartOptions" Height="300">
                <ApexCharts.ApexPointSeries TItem="TqqqDailyRecord"
                                 Items="_chartData"
                                 SeriesType="ApexCharts.SeriesType.Area"
                                 XValue="@(e => e.Date.ToString("yyyy-MM-dd"))"
                                 YAggregate="@(e => e.Last().Equity)"
                                 Name="자산" />
            </ApexCharts.ApexChart>
        </MudCard>
    }

    @* 최근 거래 기록 테이블 *@
    @if (_tqqqResult.DailyRecords.Count > 0)
    {
        var recentRecords = _tqqqResult.DailyRecords.TakeLast(50).OrderByDescending(r => r.Date).ToList();

        <MudText Typo="Typo.h6" Class="mb-2">최근 거래 기록 (최근 50일)</MudText>
        <MudTable Items="@recentRecords" Dense="true" Hover="true" Striped="true"
                  FixedHeader="true" Height="400px">
            <HeaderContent>
                <MudTh>날짜</MudTh>
                <MudTh>비중코드</MudTh>
                <MudTh>비중(%)</MudTh>
                <MudTh>TQQQ 종가</MudTh>
                <MudTh>일수익률</MudTh>
                <MudTh>자산</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="날짜">@context.Date.ToString("yy-MM-dd")</MudTd>
                <MudTd DataLabel="비중코드">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                             Color="@GetCodeColor(context.Code)"
                             Style="height:20px; font-size:11px; padding:0 8px; min-width:0;">
                        @GetCodeLabel(context.Code)
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="비중(%)">
                    <MudText Color="@(context.Weight > 0 ? Color.Primary : Color.Secondary)">
                        @((context.Weight * 100).ToString("F0"))%
                    </MudText>
                </MudTd>
                <MudTd DataLabel="TQQQ 종가">$@context.TqqqClose.ToString("N2")</MudTd>
                <MudTd DataLabel="일수익률">
                    <span style="color: @(context.DailyReturn >= 0 ? "var(--mud-palette-success)" : "var(--mud-palette-error)")">
                        @(context.DailyReturn >= 0 ? "+" : "")@((context.DailyReturn * 100).ToString("F2"))%
                    </span>
                </MudTd>
                <MudTd DataLabel="자산">
                    <strong>$@context.Equity.ToString("N0")</strong>
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
}
else if (!_isRunning && string.IsNullOrEmpty(_error))
{
    <MudAlert Severity="Severity.Info">
        매개변수를 설정하고 "백테스트 실행" 버튼을 클릭하여 시작하세요.
        <br />
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">
            TQQQ, QQQ, SPY 3개 종목의 200일 이동평균 데이터가 필요합니다. 기간에 따라 수초 ~ 수십초 소요됩니다.
        </MudText>
    </MudAlert>
}

@code {
    private DateTime? _from = new DateTime(2022, 1, 1);
    private DateTime? _to = DateTime.Today;
    private decimal _capital = 100_000m;
    private DataSource? _dataSource = null;
    private TqqqStrategyParams _params = new();

    private TqqqBacktestResult? _tqqqResult;
    private bool _isRunning;
    private string? _error;

    // 차트용 다운샘플링 (최대 300포인트)
    private List<TqqqDailyRecord> _chartData = new();
    private const int MaxChartPoints = 300;

    // 매매 타점 차트 데이터 (최대 500포인트)
    private List<TqqqChartPoint> _priceChartData = new();
    private const int MaxPriceChartPoints = 500;

    private ApexCharts.ApexChartOptions<TqqqChartPoint> _priceChartOptions = new()
    {
        Chart = new ApexCharts.Chart { Background = "transparent", ForeColor = "#9E9E9E" },
        Theme = new ApexCharts.Theme { Mode = ApexCharts.Mode.Dark },
        Stroke = new ApexCharts.Stroke
        {
            Curve = ApexCharts.Curve.Straight,
            Width = new List<int> { 2, 0 }   // Line=2px, Area=0px (fill만)
        },
        Colors = new List<string> { "#9E9E9E", "#4CAF50" },   // 회색 선, 초록 영역
        Fill = new ApexCharts.Fill
        {
            Opacity = new List<double> { 1.0, 0.3 }   // Line=불투명, Area=반투명
        },
        Xaxis = new ApexCharts.XAxis
        {
            Type = ApexCharts.XAxisType.Category,
            Labels = new ApexCharts.XAxisLabels { Rotate = 0, ShowDuplicates = false }
        },
        Yaxis = [new ApexCharts.YAxis
        {
            Labels = new ApexCharts.YAxisLabels
            {
                Formatter = @"function(v) { return v != null ? '$' + v.toFixed(2) : '' }"
            }
        }],
        Tooltip = new ApexCharts.Tooltip
        {
            Y = new ApexCharts.TooltipY
            {
                Formatter = @"function(v) { return v != null ? '$' + v.toFixed(2) : '현금' }"
            }
        },
        Legend = new ApexCharts.Legend { Position = ApexCharts.LegendPosition.Top }
    };

    private ApexCharts.ApexChartOptions<TqqqDailyRecord> _equityChartOptions = new()
    {
        Chart = new ApexCharts.Chart { Background = "transparent", ForeColor = "#9E9E9E" },
        Theme = new ApexCharts.Theme { Mode = ApexCharts.Mode.Dark },
        Stroke = new ApexCharts.Stroke { Curve = ApexCharts.Curve.Smooth, Width = 2 },
        Fill = new ApexCharts.Fill
        {
            Type = new List<ApexCharts.FillType> { ApexCharts.FillType.Gradient },
            Opacity = new List<double> { 0.3 }
        },
        Yaxis = [new ApexCharts.YAxis
        {
            Labels = new ApexCharts.YAxisLabels
            {
                Formatter = @"function(v) { return '$' + v.toFixed(0) }"
            }
        }],
        Tooltip = new ApexCharts.Tooltip
        {
            Y = new ApexCharts.TooltipY
            {
                Formatter = @"function(v) { return '$' + v.toFixed(2) }"
            }
        }
    };

    private async Task RunTqqqBacktestAsync()
    {
        _isRunning = true;
        _tqqqResult = null;
        _error = null;
        StateHasChanged();

        try
        {
            _tqqqResult = await TqqqBacktester.RunAsync(
                _from ?? new DateTime(2022, 1, 1),
                _to ?? DateTime.Today,
                _capital,
                _dataSource,
                _params,
                default);

            _chartData = DownsampleRecords(_tqqqResult.DailyRecords, MaxChartPoints);

            // 매매 타점 차트 데이터 생성
            var rawPricePoints = _tqqqResult.DailyRecords.Select(r => new TqqqChartPoint
            {
                Date = r.Date,
                TqqqClose = r.TqqqClose,
                InvestedClose = r.Weight > 0 ? r.TqqqClose : (decimal?)null
            }).ToList();
            _priceChartData = DownsamplePricePoints(rawPricePoints, MaxPriceChartPoints);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            Snackbar.Add($"백테스트 실패: {ex.Message}", MudBlazor.Severity.Error);
        }
        finally
        {
            _isRunning = false;
        }
    }

    /// <summary>TqqqChartPoint 리스트를 maxPoints 이하로 균등 다운샘플링 (처음/끝 보존)</summary>
    private static List<TqqqChartPoint> DownsamplePricePoints(List<TqqqChartPoint> source, int maxPoints)
    {
        if (source.Count <= maxPoints) return source;

        var result = new List<TqqqChartPoint>(maxPoints);
        result.Add(source[0]);

        var step = (double)(source.Count - 1) / (maxPoints - 1);
        for (int i = 1; i < maxPoints - 1; i++)
        {
            var idx = (int)Math.Round(i * step);
            result.Add(source[idx]);
        }

        result.Add(source[^1]);
        return result;
    }

    /// <summary>DailyRecords를 maxPoints 이하로 균등 다운샘플링 (처음/끝 보존)</summary>
    private static List<TqqqDailyRecord> DownsampleRecords(List<TqqqDailyRecord> source, int maxPoints)
    {
        if (source.Count <= maxPoints) return source;

        var result = new List<TqqqDailyRecord>(maxPoints);
        result.Add(source[0]);

        var step = (double)(source.Count - 1) / (maxPoints - 1);
        for (int i = 1; i < maxPoints - 1; i++)
        {
            var idx = (int)Math.Round(i * step);
            result.Add(source[idx]);
        }

        result.Add(source[^1]);
        return result;
    }

    /// <summary>비중 코드 → 표시 레이블</summary>
    private static string GetCodeLabel(int code) => code switch
    {
        0   => "현금 0%",
        1   => "방어 10%",
        2   => "풀포지션 100%",
        3   => "과열1 90%",
        4   => "과열2 80%",
        5   => "과열3 5%",
        _   => $"코드{code}"
    };

    /// <summary>비중 코드 → MudBlazor Color</summary>
    private static Color GetCodeColor(int code) => code switch
    {
        0   => Color.Default,
        1   => Color.Warning,
        2   => Color.Success,
        3   => Color.Info,
        4   => Color.Primary,
        5   => Color.Error,
        _   => Color.Secondary
    };

    /// <summary>매매 타점 차트용 데이터 포인트</summary>
    private sealed class TqqqChartPoint
    {
        public DateTime Date { get; set; }
        public decimal? TqqqClose { get; set; }
        /// <summary>투자 중일 때만 TqqqClose 값, 현금 구간은 null → 차트에서 빈 영역으로 표시</summary>
        public decimal? InvestedClose { get; set; }
    }
