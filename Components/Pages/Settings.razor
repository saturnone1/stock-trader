@page "/settings"
@rendermode InteractiveServer
@using StockTrader.Models
@using StockTrader.Models.Enums
@using StockTrader.Data.Repositories
@using StockTrader.Configuration
@using StockTrader.Services.Notification
@using StockTrader.Services.LiveParameter
@using StockTrader.Services.Market
@using Microsoft.Extensions.Options
@using System.Reflection
@inject ISettingsRepository SettingsRepo
@inject ISnackbar Snackbar
@inject INotificationDispatcher NotificationDispatcher
@inject IOptions<NotificationSettings> NotificationOptions
@inject IOptions<TradingSettings> TradingOptions
@inject IMarketCalendar MarketCalendar
@inject IOptions<AlpacaSettings> AlpacaOptions
@inject IOptionsSnapshot<PatternSettings> PatternOptions
@inject ILiveParameterService LiveParameterService

<PageTitle>설정 - 주식 트레이더</PageTitle>

<MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Class="mb-3">
    <MudText Typo="Typo.h5">설정</MudText>
    <MudIconButton Icon="@Icons.Material.Filled.HelpOutline" Size="Size.Small" Color="Color.Default" OnClick="@(() => _showHelp = true)" title="도움말" />
</MudStack>

<MudDialog @bind-Visible="_showHelp">
    <TitleContent><MudText Typo="Typo.h6">설정 도움말</MudText></TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-2">앱의 모든 설정을 관리합니다.</MudText>
        <MudList T="string" Dense="true">
            <MudListItem Icon="@Icons.Material.Filled.Circle" IconSize="Size.Small" IconColor="Color.Primary">
                <strong>알림 전용</strong>: 시그널만 알려주고 직접 매매 판단
            </MudListItem>
            <MudListItem Icon="@Icons.Material.Filled.Circle" IconSize="Size.Small" IconColor="Color.Primary">
                <strong>자동 주문</strong>: Alpaca Paper Trading으로 자동 매매 실행
            </MudListItem>
            <MudListItem Icon="@Icons.Material.Filled.Circle" IconSize="Size.Small" IconColor="Color.Primary">
                <strong>계좌 규모</strong>: 포지션 크기(1%)와 일일 한도(-3%) 계산 기준
            </MudListItem>
            <MudListItem Icon="@Icons.Material.Filled.Circle" IconSize="Size.Small" IconColor="Color.Primary">
                <strong>API 키</strong>: appsettings.json에서 설정 (보안상 UI 미노출)
            </MudListItem>
        </MudList>
    </DialogContent>
    <DialogActions><MudButton OnClick="@(() => _showHelp = false)">닫기</MudButton></DialogActions>
</MudDialog>

@if (_settings != null)
{
    <MudCard Class="mb-4">
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h6">거래 모드</MudText>
            </CardHeaderContent>
        </MudCardHeader>
        <MudCardContent>
            <ModeToggle OnModeChanged="OnModeChanged" />
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2">
                알림 전용: 시그널 발생 시 알림만 받습니다. 자동 주문: Alpaca API를 통해 자동으로 매매를 실행합니다.
            </MudText>
        </MudCardContent>
    </MudCard>

    <MudCard Class="mb-4">
        <MudCardHeader>
            <CardHeaderContent>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                    <MudIcon Icon="@Icons.Material.Filled.Storage" Size="Size.Small" Color="Color.Info" />
                    <MudText Typo="Typo.h6">시세 데이터 소스</MudText>
                </MudStack>
            </CardHeaderContent>
        </MudCardHeader>
        <MudCardContent>
            <MudGrid>
                <MudItem xs="12" md="4">
                    <MudSelect T="DataSource" @bind-Value="_settings.PreferredDataSource"
                               Label="데이터 소스" Variant="Variant.Outlined" Dense="true">
                        @foreach (var source in Enum.GetValues<DataSource>())
                        {
                            <MudSelectItem T="DataSource" Value="@source">@source</MudSelectItem>
                        }
                    </MudSelect>
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">
                        패턴 감지를 위한 시세 데이터 출처입니다. 실거래 주문은 항상 Alpaca API를 사용합니다.
                    </MudText>
                </MudItem>
            </MudGrid>
            <MudPaper Outlined="true" Class="pa-2 mt-3" Style="border-color:rgba(33,150,243,0.3);background:rgba(33,150,243,0.04);">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                    <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" Color="Color.Info" />
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        <strong>Alpaca</strong>: 실시간 데이터, VWAP 포함 (API 키 필요) · <strong>Yahoo</strong>: 15분 지연 데이터, 무료.
                        API 키는 보안상 <code>appsettings.json</code>에서 설정합니다.
                    </MudText>
                </MudStack>
            </MudPaper>
        </MudCardContent>
    </MudCard>

    <MudCard Class="mb-4">
        <MudCardHeader>
            <CardHeaderContent>
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <MudIcon Icon="@Icons.Material.Filled.Shield" Size="Size.Small" Color="Color.Warning" />
                        <MudText Typo="Typo.h6">리스크 관리</MudText>
                    </MudStack>
                    <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Secondary"
                               StartIcon="@Icons.Material.Filled.RestartAlt"
                               OnClick="ResetRiskDefaults">기본값 복원</MudButton>
                </MudStack>
            </CardHeaderContent>
        </MudCardHeader>
        <MudCardContent>
            <MudGrid Spacing="3">

                @* 계좌 규모 *@
                <MudItem xs="12" md="6" lg="4">
                    <MudNumericField @bind-Value="_settings.AccountSize"
                                     Label="기본 계좌 규모 ($)"
                                     Variant="Variant.Outlined" Margin="Margin.Dense" Format="N0"
                                     Min="1000m" Max="100000000m"
                                     HelperText="포지션 크기 및 손실 한도 계산 기준" />
                </MudItem>

                @* 거래당 리스크 비율 *@
                <MudItem xs="12" md="6" lg="4">
                    <MudStack Spacing="0">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">거래당 리스크 비율</MudText>
                            <MudText Typo="Typo.caption" Style="font-weight:600; color: var(--mud-palette-warning);">
                                @(_settings.RiskPerTradePercent * 100m).ToString("F1")%
                            </MudText>
                        </MudStack>
                        <MudSlider @bind-Value="_settings.RiskPerTradePercent"
                                   Min="0.001m" Max="0.05m" Step="0.001m"
                                   Color="Color.Warning" />
                        <MudStack Row="true" Justify="Justify.SpaceBetween">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">0.1%</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">5%</MudText>
                        </MudStack>
                        <MudText Typo="Typo.caption" Color="Color.Tertiary">
                            계좌 $@(_settings.AccountSize.ToString("N0")) 기준 거래당 리스크 $@((_settings.AccountSize * _settings.RiskPerTradePercent).ToString("N0"))
                        </MudText>
                    </MudStack>
                </MudItem>

                @* 일일 손실 한도 *@
                <MudItem xs="12" md="6" lg="4">
                    <MudStack Spacing="0">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">일일 손실 한도</MudText>
                            <MudText Typo="Typo.caption" Style="font-weight:600; color: var(--mud-palette-error);">
                                @(_settings.DailyLossLimitPercent * 100m).ToString("F1")%
                            </MudText>
                        </MudStack>
                        <MudSlider @bind-Value="_settings.DailyLossLimitPercent"
                                   Min="0.01m" Max="0.15m" Step="0.005m"
                                   Color="Color.Error" />
                        <MudStack Row="true" Justify="Justify.SpaceBetween">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">1%</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">15%</MudText>
                        </MudStack>
                        <MudText Typo="Typo.caption" Color="Color.Tertiary">
                            하루 최대 손실 $@((_settings.AccountSize * _settings.DailyLossLimitPercent).ToString("N0"))에서 자동 중지
                        </MudText>
                    </MudStack>
                </MudItem>

                @* 최대 동시 포지션 수 *@
                <MudItem xs="12" md="6" lg="4">
                    <MudStack Spacing="0">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">최대 동시 포지션 수</MudText>
                            <MudText Typo="Typo.caption" Style="font-weight:600;">@_settings.MaxTotalPositions 종목</MudText>
                        </MudStack>
                        <MudSlider @bind-Value="_settings.MaxTotalPositions"
                                   Min="1" Max="30" Step="1"
                                   Color="Color.Info" />
                        <MudStack Row="true" Justify="Justify.SpaceBetween">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">1</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">30</MudText>
                        </MudStack>
                        <MudText Typo="Typo.caption" Color="Color.Tertiary">
                            종목당 최대 자본 비중 @((100.0m / _settings.MaxTotalPositions).ToString("F0"))%
                        </MudText>
                    </MudStack>
                </MudItem>

                @* 섹터당 최대 포지션 *@
                <MudItem xs="12" md="6" lg="4">
                    <MudStack Spacing="0">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">섹터당 최대 포지션</MudText>
                            <MudText Typo="Typo.caption" Style="font-weight:600;">@_settings.MaxPositionsPerSector 종목</MudText>
                        </MudStack>
                        <MudSlider @bind-Value="_settings.MaxPositionsPerSector"
                                   Min="1" Max="10" Step="1"
                                   Color="Color.Success" />
                        <MudStack Row="true" Justify="Justify.SpaceBetween">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">1</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">10</MudText>
                        </MudStack>
                        <MudText Typo="Typo.caption" Color="Color.Tertiary">
                            같은 섹터 내 최대 @_settings.MaxPositionsPerSector 종목 동시 보유
                        </MudText>
                    </MudStack>
                </MudItem>

                @* 최소 기대 수익 *@
                <MudItem xs="12" md="6" lg="4">
                    <MudNumericField @bind-Value="_settings.MinExpectancy"
                                     Label="최소 기대 수익"
                                     Variant="Variant.Outlined" Margin="Margin.Dense" Format="F2"
                                     Step="0.05m" Min="0m" Max="5m"
                                     HelperText="0 = 제한 없음. 기대값이 이 값 미만인 시그널 무시" />
                </MudItem>
            </MudGrid>

            @* 리스크 요약 인포 박스 *@
            <MudPaper Outlined="true" Class="pa-2 mt-3" Style="border-color: rgba(255,193,7,0.3); background: rgba(255,193,7,0.04);">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Wrap="Wrap.Wrap">
                    <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" Color="Color.Warning" />
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        실제 트레이딩에 적용됩니다. 저장 후 다음 시그널 감지부터 반영됩니다.
                        포지션 크기 = 계좌규모 × 거래당리스크 ÷ 손절폭.
                        현재: 거래당 <strong style="color:var(--mud-palette-warning);">@((_settings.RiskPerTradePercent * 100m).ToString("F1"))%</strong>,
                        일일한도 <strong style="color:var(--mud-palette-error);">@((_settings.DailyLossLimitPercent * 100m).ToString("F1"))%</strong>,
                        최대 <strong>@_settings.MaxTotalPositions</strong>종목
                    </MudText>
                </MudStack>
            </MudPaper>
        </MudCardContent>
    </MudCard>

    <MudCard Class="mb-4">
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h6">관심 종목</MudText>
            </CardHeaderContent>
        </MudCardHeader>
        <MudCardContent>
            <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="mb-3">
                @foreach (var symbol in _settings.WatchlistSymbols)
                {
                    <MudChip T="string" Color="Color.Primary" Variant="Variant.Filled"
                             OnClose="@(async () => await RemoveSymbol(symbol))">@symbol</MudChip>
                }
            </MudStack>
            <MudTextField @bind-Value="_newSymbol" Label="종목 추가" Placeholder="종목 추가..."
                          Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width: 300px;"
                          OnKeyDown="OnSymbolKeyDown"
                          Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Add"
                          OnAdornmentClick="@(async () => await AddSymbol())" />
        </MudCardContent>
    </MudCard>

    @* ── 스트리밍 설정 ──────────────────────────── *@
    <MudCard Class="mb-4">
        <MudCardHeader>
            <CardHeaderContent>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                    <MudIcon Icon="@Icons.Material.Filled.Stream" Size="Size.Small" Color="Color.Info" />
                    <MudText Typo="Typo.h6">실시간 스트리밍</MudText>
                    <MudChip T="string" Size="Size.Small"
                             Color="@(_alpacaSettings.EnableStreaming ? Color.Success : Color.Default)"
                             Variant="Variant.Filled">
                        @(_alpacaSettings.EnableStreaming ? "활성" : "비활성")
                    </MudChip>
                </MudStack>
            </CardHeaderContent>
        </MudCardHeader>
        <MudCardContent>
            <MudGrid>
                <MudItem xs="6" md="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">스트리밍</MudText>
                    <MudText Typo="Typo.body1" Color="@(_alpacaSettings.EnableStreaming ? Color.Success : Color.Default)">
                        @(_alpacaSettings.EnableStreaming ? "WebSocket 활성" : "REST 폴링")
                    </MudText>
                </MudItem>
                <MudItem xs="6" md="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">재연결 최대</MudText>
                    <MudText Typo="Typo.body1">@(_alpacaSettings.MaxReconnectAttempts)회</MudText>
                </MudItem>
                <MudItem xs="6" md="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Paper 모드</MudText>
                    <MudText Typo="Typo.body1">@(_alpacaSettings.IsPaper ? "예" : "아니오")</MudText>
                </MudItem>
                <MudItem xs="6" md="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">스트림 타입</MudText>
                    <MudText Typo="Typo.body1">@string.Join(", ", _alpacaSettings.StreamTypes)</MudText>
                </MudItem>
            </MudGrid>
            <MudPaper Outlined="true" Class="pa-2 mt-3" Style="border-color:rgba(33,150,243,0.3);background:rgba(33,150,243,0.04);">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                    <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" Color="Color.Info" />
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        스트리밍 설정은 <code>appsettings.json</code>의 <code>Alpaca.EnableStreaming</code>에서 변경합니다.
                        활성화하면 WebSocket으로 실시간 바 데이터를 수신하고, 비활성 시 REST 폴링으로 대체됩니다.
                    </MudText>
                </MudStack>
            </MudPaper>
        </MudCardContent>
    </MudCard>

    @* ── 시장 시간 & 데이터 간격 ──────────────────────────── *@
    <MudCard Class="mb-4">
        <MudCardHeader>
            <CardHeaderContent>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                    <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" Color="Color.Tertiary" />
                    <MudText Typo="Typo.h6">시장 시간 & 데이터 간격</MudText>
                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">
                        appsettings.json 설정
                    </MudChip>
                </MudStack>
            </CardHeaderContent>
        </MudCardHeader>
        <MudCardContent>
            <MudGrid>
                <MudItem xs="6" md="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">US 개장/마감 (ET)</MudText>
                    <MudText Typo="Typo.h6">@MarketCalendar.GetMarketOpen(MarketType.US).ToString(@"hh\:mm") ~ @MarketCalendar.GetMarketClose(MarketType.US).ToString(@"hh\:mm")</MudText>
                </MudItem>
                <MudItem xs="6" md="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">KRX 개장/마감 (KST)</MudText>
                    <MudText Typo="Typo.h6">@MarketCalendar.GetMarketOpen(MarketType.KRX).ToString(@"hh\:mm") ~ @MarketCalendar.GetMarketClose(MarketType.KRX).ToString(@"hh\:mm")</MudText>
                </MudItem>
                <MudItem xs="6" md="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">데이터 수집 간격</MudText>
                    <MudText Typo="Typo.h6">@(_tradingSettings.DataFetchIntervalSeconds)초</MudText>
                </MudItem>
                <MudItem xs="6" md="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">리스크 체크 간격</MudText>
                    <MudText Typo="Typo.h6">@(_tradingSettings.RiskCheckIntervalSeconds)초</MudText>
                </MudItem>
            </MudGrid>
            <MudPaper Outlined="true" Class="pa-2 mt-3" Style="border-color:rgba(255,193,7,0.3);background:rgba(255,193,7,0.04);">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                    <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" Color="Color.Warning" />
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        시장 시간 및 간격 설정은 <code>appsettings.json</code>의 <code>Trading</code> 섹션에서 변경합니다.
                        변경 후 앱을 재시작해야 적용됩니다.
                    </MudText>
                </MudStack>
            </MudPaper>
        </MudCardContent>
    </MudCard>

    @* ── 활성 패턴 + 파라미터 ──────────────────────────── *@
    <MudCard Class="mb-4">
        <MudCardHeader>
            <CardHeaderContent>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                    <MudText Typo="Typo.h6">활성 패턴</MudText>
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">
                        @(_settings.EnabledPatterns.Count) / @(Enum.GetValues<PatternType>().Length)
                    </MudChip>
                </MudStack>
            </CardHeaderContent>
        </MudCardHeader>
        <MudCardContent>
            @foreach (var pattern in Enum.GetValues<PatternType>())
            {
                var isEnabled = _settings.EnabledPatterns.Contains(pattern);
                var meta = PatternMetadataMap.Get(pattern);
                <MudPaper Outlined="true" Class="pa-2 mb-2"
                          Style="@(isEnabled ? "border-color: rgba(33,150,243,0.4);" : "border-color: rgba(128,128,128,0.2); opacity: 0.7;")">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween"
                              @onclick="@(() => TogglePatternExpand(pattern))"
                              Style="cursor: pointer; user-select: none;">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2"
                                  @onclick:stopPropagation="false">
                            <MudSwitch T="bool" Value="@isEnabled"
                                       ValueChanged="@(v => TogglePattern(pattern, v))"
                                       Color="Color.Primary"
                                       @onclick:stopPropagation="true" />
                            <div>
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                    <MudText Typo="Typo.subtitle2">@meta.KoreanName</MudText>
                                    @if (meta.Status != PatternStatus.Verified)
                                    {
                                        <MudTooltip Text="@meta.StatusNote">
                                            <MudChip T="string"
                                                     Color="@PatternMetadataMap.GetStatusColor(meta.Status)"
                                                     Variant="Variant.Outlined"
                                                     Size="Size.Small"
                                                     Icon="@PatternMetadataMap.GetStatusIcon(meta.Status)"
                                                     Style="height: 20px; font-size: 10px;">
                                                @PatternMetadataMap.GetStatusLabel(meta.Status)
                                            </MudChip>
                                        </MudTooltip>
                                    }
                                </MudStack>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@pattern — @meta.StyleLabel · @meta.HoldingPeriod</MudText>
                            </div>
                        </MudStack>
                        <MudIcon Icon="@(_expandedPatterns.Contains(pattern) ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                 Size="Size.Small" Color="Color.Default" />
                    </MudStack>
                    @if (_expandedPatterns.Contains(pattern) && PatternFieldDefs.TryGetValue(pattern, out var pFields))
                    {
                        <MudDivider Class="my-2" />
                        @foreach (var grp in pFields.GroupBy(f => f.Category).OrderBy(g => g.Key == "exit" ? 1 : 0))
                        {
                            <MudText Typo="Typo.caption"
                                     Color="@(grp.Key == "exit" ? Color.Warning : Color.Primary)"
                                     Class="@(grp.Key == "exit" ? "mt-2 mb-1" : "mb-1")"
                                     Style="font-weight:600;">
                                @(grp.Key == "exit" ? "청산 전략" : "감지 파라미터")
                            </MudText>
                            <MudGrid Spacing="2">
                                @foreach (var field in grp)
                                {
                                    var prop = FieldPropCache[field.VmPropName];
                                    <MudItem xs="6" md="3">
                                        @if (prop.PropertyType == typeof(decimal))
                                        {
                                            <MudNumericField T="decimal"
                                                Value="@((decimal)prop.GetValue(_liveParams)!)"
                                                ValueChanged="@((decimal v) => prop.SetValue(_liveParams, v))"
                                                Label="@field.Label" Variant="Variant.Outlined"
                                                Margin="Margin.Dense" Format="@field.Format" Step="@field.DecStep" />
                                        }
                                        else if (prop.PropertyType == typeof(int))
                                        {
                                            <MudNumericField T="int"
                                                Value="@((int)prop.GetValue(_liveParams)!)"
                                                ValueChanged="@((int v) => prop.SetValue(_liveParams, v))"
                                                Label="@field.Label" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                        }
                                        else if (prop.PropertyType == typeof(string))
                                        {
                                            <MudTextField T="string"
                                                Value="@((string?)prop.GetValue(_liveParams) ?? "")"
                                                ValueChanged="@((string v) => prop.SetValue(_liveParams, v))"
                                                Label="@field.Label" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                        }
                                    </MudItem>
                                }
                            </MudGrid>
                        }
                    }
                </MudPaper>
            }

            @* 파라미터 저장 버튼 *@
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mt-3">
                <MudButton Variant="Variant.Filled" Color="Color.Warning" Size="Size.Medium"
                           StartIcon="@Icons.Material.Filled.Save"
                           OnClick="SavePatternParamsAsync" Disabled="@_savingParams">
                    @if (_savingParams)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
                    }
                    파라미터 저장
                </MudButton>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    변경된 패턴 감지 + 청산 전략 파라미터를 실거래에 즉시 반영합니다.
                </MudText>
            </MudStack>
        </MudCardContent>
    </MudCard>

    @* ── 알림 설정 (인앱) ─────────────────────────────── *@
    <MudCard Class="mb-4">
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h6">알림</MudText>
            </CardHeaderContent>
        </MudCardHeader>
        <MudCardContent>
            <MudSwitch T="bool" @bind-Value="_settings.SoundAlerts"
                       Label="소리 알림" Color="Color.Primary" />
        </MudCardContent>
    </MudCard>

    @* ── 외부 알림 채널 설정 ──────────────────────────── *@
    <MudCard Class="mb-4">
        <MudCardHeader>
            <CardHeaderContent>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                    <MudIcon Icon="@Icons.Material.Filled.Notifications" Size="Size.Small" Color="Color.Info" />
                    <MudText Typo="Typo.h6">외부 알림 채널</MudText>
                </MudStack>
            </CardHeaderContent>
        </MudCardHeader>
        <MudCardContent>

            @* ── Telegram ─────────────────────────────────────── *@
            <MudPaper Outlined="true" Class="pa-3 mb-3" Style="@GetChannelBorderStyle(_notifEdit.EnableTelegram)">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-2" Wrap="Wrap.Wrap">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.Send" Color="Color.Info" />
                        <MudText Typo="Typo.subtitle1" Style="font-weight:600;">텔레그램</MudText>
                    </MudStack>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudSwitch T="bool" @bind-Value="_notifEdit.EnableTelegram"
                                   Label="@(_notifEdit.EnableTelegram ? "활성" : "비활성")"
                                   Color="Color.Info" />
                        <MudButton Variant="Variant.Outlined" Size="Size.Small"
                                   Color="@(_notifEdit.EnableTelegram ? Color.Info : Color.Default)"
                                   StartIcon="@Icons.Material.Filled.Send"
                                   Disabled="@(!_notifEdit.EnableTelegram || _testingChannel == "Telegram")"
                                   OnClick="@(() => TestChannelAsync("Telegram"))">
                            @if (_testingChannel == "Telegram")
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
                            }
                            테스트 발송
                        </MudButton>
                    </MudStack>
                </MudStack>
                @if (_notifEdit.EnableTelegram)
                {
                    <MudGrid Spacing="2">
                        <MudItem xs="12" md="6">
                            <MudTextField @bind-Value="_notifEdit.TelegramBotToken"
                                          Label="Bot Token" Variant="Variant.Outlined" Margin="Margin.Dense"
                                          InputType="InputType.Password"
                                          HelperText="BotFather에서 발급받은 토큰" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField @bind-Value="_notifEdit.TelegramChatId"
                                          Label="Chat ID" Variant="Variant.Outlined" Margin="Margin.Dense"
                                          HelperText="알림받을 채팅 ID (&#64;userinfobot으로 확인)" />
                        </MudItem>
                    </MudGrid>
                }
                else
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        활성화 토글을 켜면 Bot Token과 Chat ID를 입력할 수 있습니다.
                    </MudText>
                }
            </MudPaper>

            @* ── Discord ──────────────────────────────────────── *@
            <MudPaper Outlined="true" Class="pa-3 mb-3" Style="@GetChannelBorderStyle(_notifEdit.EnableDiscord)">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-2" Wrap="Wrap.Wrap">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.Forum" Color="Color.Secondary" />
                        <MudText Typo="Typo.subtitle1" Style="font-weight:600;">디스코드</MudText>
                    </MudStack>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudSwitch T="bool" @bind-Value="_notifEdit.EnableDiscord"
                                   Label="@(_notifEdit.EnableDiscord ? "활성" : "비활성")"
                                   Color="Color.Secondary" />
                        <MudButton Variant="Variant.Outlined" Size="Size.Small"
                                   Color="@(_notifEdit.EnableDiscord ? Color.Secondary : Color.Default)"
                                   StartIcon="@Icons.Material.Filled.Send"
                                   Disabled="@(!_notifEdit.EnableDiscord || _testingChannel == "Discord")"
                                   OnClick="@(() => TestChannelAsync("Discord"))">
                            @if (_testingChannel == "Discord")
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
                            }
                            테스트 발송
                        </MudButton>
                    </MudStack>
                </MudStack>
                @if (_notifEdit.EnableDiscord)
                {
                    <MudTextField @bind-Value="_notifEdit.DiscordWebhookUrl"
                                  Label="Webhook URL" Variant="Variant.Outlined" Margin="Margin.Dense"
                                  InputType="InputType.Password"
                                  HelperText="Discord 서버 설정 > 연동 > 웹훅에서 복사" />
                }
                else
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        활성화 토글을 켜면 Webhook URL을 입력할 수 있습니다.
                    </MudText>
                }
            </MudPaper>

            @* ── Email ────────────────────────────────────────── *@
            <MudPaper Outlined="true" Class="pa-3 mb-3" Style="@GetChannelBorderStyle(_notifEdit.EnableEmail)">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-2" Wrap="Wrap.Wrap">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.Email" Color="Color.Warning" />
                        <MudText Typo="Typo.subtitle1" Style="font-weight:600;">이메일</MudText>
                    </MudStack>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudSwitch T="bool" @bind-Value="_notifEdit.EnableEmail"
                                   Label="@(_notifEdit.EnableEmail ? "활성" : "비활성")"
                                   Color="Color.Warning" />
                        <MudButton Variant="Variant.Outlined" Size="Size.Small"
                                   Color="@(_notifEdit.EnableEmail ? Color.Warning : Color.Default)"
                                   StartIcon="@Icons.Material.Filled.Send"
                                   Disabled="@(!_notifEdit.EnableEmail || _testingChannel == "Email")"
                                   OnClick="@(() => TestChannelAsync("Email"))">
                            @if (_testingChannel == "Email")
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
                            }
                            테스트 발송
                        </MudButton>
                    </MudStack>
                </MudStack>
                @if (_notifEdit.EnableEmail)
                {
                    <MudGrid Spacing="2">
                        <MudItem xs="12" md="5">
                            <MudTextField @bind-Value="_notifEdit.SmtpHost"
                                          Label="SMTP 호스트" Variant="Variant.Outlined" Margin="Margin.Dense"
                                          HelperText="예: smtp.gmail.com" />
                        </MudItem>
                        <MudItem xs="6" md="2">
                            <MudNumericField T="int" @bind-Value="_notifEdit.SmtpPort"
                                             Label="포트" Variant="Variant.Outlined" Margin="Margin.Dense"
                                             Min="1" Max="65535" />
                        </MudItem>
                        <MudItem xs="6" md="2">
                            <MudSwitch T="bool" @bind-Value="_notifEdit.SmtpUseSsl"
                                       Label="SSL/TLS" Color="Color.Success" Class="mt-3" />
                        </MudItem>
                        <MudItem xs="12" md="3">
                            <MudTextField @bind-Value="_notifEdit.SmtpUsername"
                                          Label="SMTP 사용자명" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudTextField @bind-Value="_notifEdit.SmtpPassword"
                                          Label="SMTP 비밀번호" Variant="Variant.Outlined" Margin="Margin.Dense"
                                          InputType="InputType.Password" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudTextField @bind-Value="_notifEdit.EmailFrom"
                                          Label="발신 주소" Variant="Variant.Outlined" Margin="Margin.Dense"
                                          HelperText="보내는 사람 이메일" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudTextField @bind-Value="_notifEdit.EmailTo"
                                          Label="수신 주소" Variant="Variant.Outlined" Margin="Margin.Dense"
                                          HelperText="받는 사람 이메일" />
                        </MudItem>
                    </MudGrid>
                }
                else
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        활성화 토글을 켜면 SMTP 설정을 입력할 수 있습니다.
                    </MudText>
                }
            </MudPaper>

            @* ── 일일 리포트 시간 (KST) ──────────────────────── *@
            <MudDivider Class="my-3" />
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
                <MudIcon Icon="@Icons.Material.Filled.Schedule" Color="Color.Tertiary" Size="Size.Small" />
                <MudText Typo="Typo.subtitle2">일일 리포트 발송 시간 (KST)</MudText>
                <MudTextField @bind-Value="_notifEdit.DailyReportTimeKst"
                              Label="KST 발송 시간" Variant="Variant.Outlined" Margin="Margin.Dense"
                              Style="max-width:120px;"
                              Placeholder="HH:mm"
                              HelperText="예: 09:00 (한국 시간 기준)" />
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    현재 ET 기준: @_notificationSettings.DailyReportTime
                </MudText>
            </MudStack>

            @* 알림 채널 저장 버튼 *@
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mt-3">
                <MudButton Variant="Variant.Filled" Color="Color.Info" Size="Size.Medium"
                           StartIcon="@Icons.Material.Filled.Save"
                           OnClick="SaveNotifSettingsAsync" Disabled="@_savingNotif">
                    @if (_savingNotif)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
                    }
                    알림 설정 저장
                </MudButton>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    저장 후 앱 재시작 없이 다음 알림부터 즉시 반영됩니다.
                </MudText>
            </MudStack>
        </MudCardContent>
    </MudCard>

    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large"
               OnClick="SaveAsync" Disabled="@_saving">
        @if (_saving)
        {
            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
        }
        설정 저장
    </MudButton>
}

@code {
    private bool _showHelp;
    private UserSettings? _settings;
    private string _newSymbol = "";
    private bool _saving;

    // 알림 채널 관련 상태
    private NotificationSettings _notificationSettings = new();
    private TradingSettings _tradingSettings = new();
    private AlpacaSettings _alpacaSettings = new();
    private PatternSettings _patternSettings = new();
    private string _testingChannel = "";
    private HashSet<PatternType> _expandedPatterns = new();

    // 패턴 파라미터 편집
    private PatternParamViewModel _liveParams = new();
    private bool _savingParams;

    // 외부 알림 채널 편집 모델 (DB 저장 대상, UserSettings 필드 추가 시 바인딩)
    private NotifEditModel _notifEdit = new();
    private bool _savingNotif;

    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _settings = await SettingsRepo.GetAsync();
            _notificationSettings = NotificationOptions.Value;
            _tradingSettings = TradingOptions.Value;
            _alpacaSettings = AlpacaOptions.Value;
            _patternSettings = PatternOptions.Value;

            var exitOverrides = await LiveParameterService.GetLiveOverridesAsync();
            _liveParams = PatternParamViewModel.FromLiveSettings(_patternSettings, exitOverrides);

            // 알림 편집 모델 초기화: DB 저장 값 우선, 없으면 appsettings 초기값 사용
            _notifEdit = NotifEditModel.FromUserSettings(_settings, _notificationSettings);
        }
        catch (Exception ex)
        {
            _error = $"설정 로드 실패: {ex.Message}";
        }
    }

    private async Task AddSymbol()
    {
        if (!string.IsNullOrWhiteSpace(_newSymbol) && _settings != null)
        {
            var symbol = _newSymbol.Trim().ToUpper();
            if (!_settings.WatchlistSymbols.Contains(symbol))
            {
                _settings.WatchlistSymbols.Add(symbol);
                await SaveSettingsQuietAsync();
            }
            _newSymbol = "";
        }
    }

    private async Task RemoveSymbol(string symbol)
    {
        if (_settings?.WatchlistSymbols.Remove(symbol) == true)
            await SaveSettingsQuietAsync();
    }

    private async Task OnSymbolKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await AddSymbol();
    }

    // 관심종목 추가/삭제 시 스낵바 없이 조용히 저장 (UX: 빠른 응답)
    private async Task SaveSettingsQuietAsync()
    {
        if (_settings == null) return;
        try
        {
            await SettingsRepo.SaveAsync(_settings);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"관심종목 저장 실패: {ex.Message}", Severity.Error);
        }
    }

    private void TogglePattern(PatternType pattern, bool enabled)
    {
        if (_settings == null) return;
        if (enabled && !_settings.EnabledPatterns.Contains(pattern))
            _settings.EnabledPatterns.Add(pattern);
        else if (!enabled)
            _settings.EnabledPatterns.Remove(pattern);
    }

    private async Task OnModeChanged(OrderMode mode)
    {
        if (_settings != null) _settings.OrderMode = mode;
    }

    private void ResetRiskDefaults()
    {
        if (_settings == null) return;
        _settings.AccountSize = 100_000m;
        _settings.RiskPerTradePercent = 0.01m;
        _settings.DailyLossLimitPercent = 0.03m;
        _settings.MaxTotalPositions = 10;
        _settings.MaxPositionsPerSector = 2;
        _settings.MinExpectancy = 0m;
        Snackbar.Add("리스크 설정이 기본값으로 복원되었습니다.", Severity.Info);
    }

    private async Task SaveAsync()
    {
        if (_settings == null) return;
        _saving = true;
        try
        {
            // 알림 편집 모델 값도 함께 반영 (알림 설정 저장 버튼 안 누르고 맨 밑 저장만 눌러도 반영)
            ApplyNotifEditToSettings();
            await SettingsRepo.SaveAsync(_settings);
            Snackbar.Add("설정이 저장되었습니다!", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"설정 저장 실패: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task SavePatternParamsAsync()
    {
        if (_settings == null) return;
        _savingParams = true;
        StateHasChanged();
        try
        {
            await LiveParameterService.ApplyToLiveAsync(
                _liveParams.ToOverrides(),
                _settings.EnabledPatterns.ToList(),
                _settings.RiskPerTradePercent,
                _settings.DailyLossLimitPercent,
                _settings.MaxTotalPositions,
                _settings.MaxPositionsPerSector);
            Snackbar.Add("패턴 파라미터가 실거래에 적용되었습니다!", Severity.Success,
                config => { config.VisibleStateDuration = 3000; });
        }
        catch (Exception ex)
        {
            Snackbar.Add($"파라미터 저장 실패: {ex.Message}", Severity.Error,
                config => { config.VisibleStateDuration = 5000; });
        }
        finally
        {
            _savingParams = false;
        }
    }

    private async Task TestChannelAsync(string channelName)
    {
        _testingChannel = channelName;
        StateHasChanged();

        try
        {
            // 테스트 전 현재 설정을 DB에 자동 저장 (저장 안 누르고 테스트만 누르는 경우 대비)
            await SaveNotifSettingsAsync();

            var success = await NotificationDispatcher.TestChannelAsync(channelName);
            if (success)
                Snackbar.Add($"{channelName} 테스트 메시지 발송 완료!", Severity.Success);
            else
                Snackbar.Add($"{channelName} 테스트 발송 실패. 설정을 확인하세요.", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{channelName} 오류: {ex.Message}", Severity.Error);
        }
        finally
        {
            _testingChannel = "";
            StateHasChanged();
        }
    }

    private async Task SaveNotifSettingsAsync()
    {
        if (_settings == null) return;
        _savingNotif = true;
        try
        {
            ApplyNotifEditToSettings();
            await SettingsRepo.SaveAsync(_settings);
            Snackbar.Add("알림 설정이 저장되었습니다. 앱 재시작 없이 즉시 적용됩니다.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"알림 설정 저장 실패: {ex.Message}", Severity.Error);
        }
        finally
        {
            _savingNotif = false;
        }
    }

    /// <summary>_notifEdit 뷰모델 → _settings 엔티티 알림 필드 복사</summary>
    private void ApplyNotifEditToSettings()
    {
        if (_settings == null) return;
        _settings.EnableTelegram     = _notifEdit.EnableTelegram;
        _settings.TelegramBotToken   = string.IsNullOrWhiteSpace(_notifEdit.TelegramBotToken)
                                        ? null : _notifEdit.TelegramBotToken;
        _settings.TelegramChatId     = string.IsNullOrWhiteSpace(_notifEdit.TelegramChatId)
                                        ? null : _notifEdit.TelegramChatId;
        _settings.EnableDiscord      = _notifEdit.EnableDiscord;
        _settings.DiscordWebhookUrl  = string.IsNullOrWhiteSpace(_notifEdit.DiscordWebhookUrl)
                                        ? null : _notifEdit.DiscordWebhookUrl;
        _settings.EnableEmail        = _notifEdit.EnableEmail;
        _settings.SmtpHost           = string.IsNullOrWhiteSpace(_notifEdit.SmtpHost)
                                        ? null : _notifEdit.SmtpHost;
        _settings.SmtpPort           = _notifEdit.SmtpPort;
        _settings.SmtpUseSsl         = _notifEdit.SmtpUseSsl;
        _settings.SmtpUsername       = string.IsNullOrWhiteSpace(_notifEdit.SmtpUsername)
                                        ? null : _notifEdit.SmtpUsername;
        _settings.SmtpPassword       = string.IsNullOrWhiteSpace(_notifEdit.SmtpPassword)
                                        ? null : _notifEdit.SmtpPassword;
        _settings.EmailFrom          = string.IsNullOrWhiteSpace(_notifEdit.EmailFrom)
                                        ? null : _notifEdit.EmailFrom;
        _settings.EmailTo            = string.IsNullOrWhiteSpace(_notifEdit.EmailTo)
                                        ? null : _notifEdit.EmailTo;
        _settings.DailyReportTimeKst = string.IsNullOrWhiteSpace(_notifEdit.DailyReportTimeKst)
                                        ? null : _notifEdit.DailyReportTimeKst;
    }

    private static string MaskSecret(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return "(미설정)";
        if (value.Length <= 8) return new string('*', value.Length);
        return value[..4] + new string('*', value.Length - 8) + value[^4..];
    }

    private static string GetChannelBorderStyle(bool isEnabled) =>
        isEnabled
            ? "border-color: rgba(76,175,80,0.5); background: rgba(76,175,80,0.04);"
            : "border-color: rgba(128,128,128,0.3);";

    private void TogglePatternExpand(PatternType pattern)
    {
        if (!_expandedPatterns.Remove(pattern))
            _expandedPatterns.Add(pattern);
    }

    // PatternParamViewModel.PatternFieldDefs / FieldPropCache 사용 (공유 필드 정의)
    private static Dictionary<string, PropertyInfo> FieldPropCache => PatternParamViewModel.FieldPropCache;
    private static Dictionary<PatternType, List<PatternParamViewModel.FieldDef>> PatternFieldDefs => PatternParamViewModel.PatternFieldDefs;

    /// <summary>
    /// 외부 알림 채널 편집용 뷰모델.
    /// UserSettings에 알림 필드가 추가되면 SaveNotifSettingsAsync에서 바인딩 코드를 활성화하세요.
    /// </summary>
    private class NotifEditModel
    {
        // Telegram
        public bool   EnableTelegram    { get; set; }
        public string TelegramBotToken  { get; set; } = "";
        public string TelegramChatId    { get; set; } = "";

        // Discord
        public bool   EnableDiscord     { get; set; }
        public string DiscordWebhookUrl { get; set; } = "";

        // Email
        public bool   EnableEmail       { get; set; }
        public string SmtpHost          { get; set; } = "";
        public int    SmtpPort          { get; set; } = 587;
        public bool   SmtpUseSsl        { get; set; } = true;
        public string SmtpUsername      { get; set; } = "";
        public string SmtpPassword      { get; set; } = "";
        public string EmailFrom         { get; set; } = "";
        public string EmailTo           { get; set; } = "";

        // 일일 리포트 시간 (KST, "HH:mm" 형식)
        public string DailyReportTimeKst { get; set; } = "09:00";

        /// <summary>appsettings에서 읽은 NotificationSettings를 초기값으로 복사합니다.</summary>
        public static NotifEditModel FromNotificationSettings(NotificationSettings ns) => new()
        {
            EnableTelegram    = ns.EnableTelegram,
            TelegramBotToken  = ns.TelegramBotToken  ?? "",
            TelegramChatId    = ns.TelegramChatId    ?? "",
            EnableDiscord     = ns.EnableDiscord,
            DiscordWebhookUrl = ns.DiscordWebhookUrl ?? "",
            EnableEmail       = ns.EnableEmail,
            SmtpHost          = ns.SmtpHost          ?? "",
            SmtpPort          = ns.SmtpPort,
            SmtpUseSsl        = ns.SmtpUseSsl,
            SmtpUsername      = ns.SmtpUsername      ?? "",
            SmtpPassword      = ns.SmtpPassword      ?? "",
            EmailFrom         = ns.EmailFrom         ?? "",
            EmailTo           = ns.EmailTo           ?? "",
            DailyReportTimeKst = "09:00",
        };

        /// <summary>
        /// DB UserSettings 값(null이 아닌 경우 우선)과 appsettings 초기값을 병합하여 편집 모델을 생성합니다.
        /// null인 DB 필드는 appsettings 기본값을 사용합니다.
        /// </summary>
        public static NotifEditModel FromUserSettings(UserSettings us, NotificationSettings ns) => new()
        {
            EnableTelegram    = us.EnableTelegram    ?? ns.EnableTelegram,
            TelegramBotToken  = us.TelegramBotToken  ?? ns.TelegramBotToken ?? "",
            TelegramChatId    = us.TelegramChatId    ?? ns.TelegramChatId   ?? "",
            EnableDiscord     = us.EnableDiscord     ?? ns.EnableDiscord,
            DiscordWebhookUrl = us.DiscordWebhookUrl ?? ns.DiscordWebhookUrl ?? "",
            EnableEmail       = us.EnableEmail       ?? ns.EnableEmail,
            SmtpHost          = us.SmtpHost          ?? ns.SmtpHost         ?? "",
            SmtpPort          = us.SmtpPort          ?? ns.SmtpPort,
            SmtpUseSsl        = us.SmtpUseSsl        ?? ns.SmtpUseSsl,
            SmtpUsername      = us.SmtpUsername      ?? ns.SmtpUsername     ?? "",
            SmtpPassword      = us.SmtpPassword      ?? ns.SmtpPassword     ?? "",
            EmailFrom         = us.EmailFrom         ?? ns.EmailFrom        ?? "",
            EmailTo           = us.EmailTo           ?? ns.EmailTo          ?? "",
            DailyReportTimeKst = us.DailyReportTimeKst ?? "09:00",
        };
    }
}
