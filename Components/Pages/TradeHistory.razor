@page "/history"
@rendermode InteractiveServer
@using StockTrader.Models
@using StockTrader.Models.Enums
@using StockTrader.Data.Repositories
@using StockTrader.Services.Account
@inject ITradeRepository TradeRepo
@inject IAccountManager AccountManager
@implements IDisposable

<PageTitle>거래 내역 - 주식 트레이더</PageTitle>

<div class="page-header">
    <MudText Typo="Typo.h5">거래 내역</MudText>
    <MudIconButton Icon="@Icons.Material.Filled.HelpOutline" Size="Size.Small" Color="Color.Default" OnClick="@(() => _showHelp = true)" title="도움말" />
</div>
<MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3 page-description">추천 내역, 진행 중인 거래, 청산된 거래를 탭으로 확인하세요.</MudText>

<MudDialog @bind-Visible="_showHelp">
    <TitleContent><MudText Typo="Typo.h6">거래 내역 도움말</MudText></TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-2">세 가지 탭으로 거래 전 주기를 추적합니다.</MudText>
        <MudList T="string" Dense="true">
            <MudListItem Icon="@Icons.Material.Filled.Circle" IconSize="Size.Small" IconColor="Color.Primary">
                <strong>전체 추천</strong>: 시그널에서 생성된 모든 추천. 거래 전에도 즉시 확인 가능
            </MudListItem>
            <MudListItem Icon="@Icons.Material.Filled.Circle" IconSize="Size.Small" IconColor="Color.Primary">
                <strong>진행 중</strong>: 현재 보유 중인 포지션과 미실현 손익
            </MudListItem>
            <MudListItem Icon="@Icons.Material.Filled.Circle" IconSize="Size.Small" IconColor="Color.Primary">
                <strong>청산 완료</strong>: 종료된 거래의 최종 손익 결과
            </MudListItem>
            <MudListItem Icon="@Icons.Material.Filled.Circle" IconSize="Size.Small" IconColor="Color.Primary">
                <strong>손익률</strong>: (청산가 - 진입가) / 진입가 × 100
            </MudListItem>
        </MudList>
    </DialogContent>
    <DialogActions><MudButton OnClick="@(() => _showHelp = false)">닫기</MudButton></DialogActions>
</MudDialog>

@if (_loading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-2" />
}
@if (_error != null)
{
    <MudAlert Severity="Severity.Error" Class="mb-2" ShowCloseIcon="true" CloseIconClicked="() => _error = null">@_error</MudAlert>
}

<MudTabs Elevation="0" Rounded="false" ApplyEffectsToContainer="true" Class="pt-4"
         ActivePanelIndex="_activeTab"
         ActivePanelIndexChanged="@((int i) => _activeTab = i)"
         Color="Color.Primary">

    @* ── 탭 1: 전체 추천 내역 ── *@
    <MudTabPanel Text="전체 추천" Icon="@Icons.Material.Filled.Lightbulb"
                 BadgeData="@(_recommendations.Count > 0 ? _recommendations.Count.ToString() : null)"
                 BadgeColor="Color.Primary">
        @{
            var execCount = _recommendations.Count(r => r.WasExecuted);
            var pendingCount = _recommendations.Count(r => !r.WasExecuted);
        }

        @* 추천 요약 카드 *@
        <div class="summary-grid">
            <div class="summary-card">
                <div class="summary-card-label">전체 추천</div>
                <div class="summary-card-value">@_recommendations.Count</div>
            </div>
            <div class="summary-card">
                <div class="summary-card-label">실행됨</div>
                <div class="summary-card-value" style="color: var(--mud-palette-success);">@execCount</div>
            </div>
            <div class="summary-card">
                <div class="summary-card-label">미실행</div>
                <div class="summary-card-value">@pendingCount</div>
            </div>
            <div class="summary-card">
                <div class="summary-card-label">실행률</div>
                <div class="summary-card-value" style="color: var(--mud-palette-info);">
                    @(_recommendations.Count > 0
                        ? ((decimal)execCount / _recommendations.Count).ToString("P0")
                        : "-")
                </div>
            </div>
        </div>

        @* 추천 수 선택 *@
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mb-3" Wrap="Wrap.Wrap">
            <MudText Typo="Typo.body2" Color="Color.Secondary">최근</MudText>
            @foreach (var n in new[] { 20, 50, 100, 200 })
            {
                <MudButton Size="Size.Small"
                           Variant="@(_recoCount == n ? Variant.Filled : Variant.Outlined)"
                           Color="@(_recoCount == n ? Color.Primary : Color.Default)"
                           OnClick="@(() => SetRecoCount(n))">
                    @(n)건
                </MudButton>
            }
            <MudSpacer />
            <MudTooltip Text="추천 내역 새로고침">
                <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Small"
                               Color="Color.Default" OnClick="LoadRecommendationsAsync" />
            </MudTooltip>
        </MudStack>

        @if (_recommendations.Count > 0)
        {
            <div class="table-scroll-wrapper">
            <MudTable Items="@_recommendations" Dense="true" Hover="true" Striped="true"
                      SortLabel="정렬"
                      RowStyleFunc="@((TradeRecommendation r, int _) => r.WasExecuted ? "" : "opacity:0.75;")">
                <HeaderContent>
                    <MudTh><MudTableSortLabel SortBy="new Func<TradeRecommendation, object>(x => x.Symbol)">종목</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortBy="new Func<TradeRecommendation, object>(x => x.PatternType)">패턴</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortBy="new Func<TradeRecommendation, object>(x => x.EntryPrice)">진입가</MudTableSortLabel></MudTh>
                    <MudTh Class="col-hide-sm">손절가</MudTh>
                    <MudTh Class="col-hide-sm">목표가</MudTh>
                    <MudTh><MudTableSortLabel SortBy="new Func<TradeRecommendation, object>(x => x.RiskRewardRatio)">R:R</MudTableSortLabel></MudTh>
                    <MudTh Class="col-hide-md"><MudTableSortLabel SortBy="new Func<TradeRecommendation, object>(x => x.Expectancy)">기대값</MudTableSortLabel></MudTh>
                    <MudTh Class="col-hide-md">수량</MudTh>
                    <MudTh><MudTableSortLabel SortBy="new Func<TradeRecommendation, object>(x => x.WasExecuted)">상태</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel InitialDirection="MudBlazor.SortDirection.Descending" SortBy="new Func<TradeRecommendation, object>(x => x.GeneratedAt)">생성시각</MudTableSortLabel></MudTh>
                </HeaderContent>
                <RowTemplate>
                    @{
                        var rMeta = PatternMetadataMap.Get(context.PatternType);
                    }
                    <MudTd><b>@context.Symbol</b></MudTd>
                    <MudTd>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            <MudText Typo="Typo.body2" Style="white-space:nowrap;">@rMeta.KoreanName</MudText>
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Filled"
                                     Color="@PatternMetadataMap.GetMudColor(context.PatternType)"
                                     Class="chip-xs">
                                @rMeta.StyleLabel
                            </MudChip>
                        </MudStack>
                    </MudTd>
                    <MudTd>$@context.EntryPrice.ToString("F2")</MudTd>
                    <MudTd Class="col-hide-sm"><MudText Color="Color.Error">$@context.StopLossPrice.ToString("F2")</MudText></MudTd>
                    <MudTd Class="col-hide-sm"><MudText Color="Color.Success">$@context.TargetPrice.ToString("F2")</MudText></MudTd>
                    <MudTd>
                        <MudText Color="@(context.RiskRewardRatio >= 2 ? Color.Success : context.RiskRewardRatio >= 1 ? Color.Warning : Color.Error)">
                            @context.RiskRewardRatio.ToString("F1")x
                        </MudText>
                    </MudTd>
                    <MudTd Class="col-hide-md">
                        <MudText Color="@(context.Expectancy >= 0 ? Color.Success : Color.Error)">
                            @(context.Expectancy >= 0 ? "+" : "")@context.Expectancy.ToString("F3")
                        </MudText>
                    </MudTd>
                    <MudTd Class="col-hide-md">@(context.ShareQuantity)주</MudTd>
                    <MudTd>
                        @if (context.WasExecuted)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled"
                                     Class="chip-xs">
                                실행됨
                            </MudChip>
                        }
                        else
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined"
                                     Class="chip-xs">
                                미실행
                            </MudChip>
                        }
                    </MudTd>
                    <MudTd>
                        <MudTooltip Text="@context.GeneratedAt.ToString("yyyy-MM-dd HH:mm:ss")">
                            <MudText Typo="Typo.caption">@context.GeneratedAt.ToString("MM/dd HH:mm")</MudText>
                        </MudTooltip>
                    </MudTd>
                </RowTemplate>
            </MudTable>
            </div>@* /table-scroll-wrapper *@
        }
        else if (!_loading)
        {
            <MudAlert Severity="Severity.Info" Class="mt-2">
                아직 추천 내역이 없습니다. 패턴 스캐너가 신호를 감지하면 여기에 표시됩니다.
            </MudAlert>
        }
    </MudTabPanel>

    @* ── 탭 2: 진행 중인 거래 ── *@
    <MudTabPanel Text="진행 중" Icon="@Icons.Material.Filled.PlayCircle"
                 BadgeData="@(_openPositions.Count > 0 ? _openPositions.Count.ToString() : null)"
                 BadgeColor="Color.Warning">
        @{
            var totalUnrealized = _openPositions.Sum(p => p.UnrealizedPnL);
            var totalInvested   = _openPositions.Sum(p => p.EntryPrice * p.Quantity);
            var unrealizedPct   = totalInvested > 0 ? totalUnrealized / totalInvested : 0m;
        }

        @if (_openPositions.Count > 0)
        {
            @* 진행 중 요약 카드 *@
            <div class="summary-grid">
                <div class="summary-card">
                    <div class="summary-card-label">보유 종목수</div>
                    <div class="summary-card-value" style="color: var(--mud-palette-info);">@_openPositions.Count</div>
                </div>
                <div class="summary-card">
                    <div class="summary-card-label">총 투자금</div>
                    <div class="summary-card-value">$@totalInvested.ToString("N0")</div>
                </div>
                <div class="summary-card">
                    <div class="summary-card-label">미실현 손익</div>
                    <div class="summary-card-value" style="color: var(--mud-palette-@(totalUnrealized >= 0 ? "success" : "error"));">
                        @(totalUnrealized >= 0 ? "+" : "")$@totalUnrealized.ToString("N2")
                    </div>
                </div>
                <div class="summary-card">
                    <div class="summary-card-label">미실현 수익률</div>
                    <div class="summary-card-value" style="color: var(--mud-palette-@(unrealizedPct >= 0 ? "success" : "error"));">
                        @(unrealizedPct >= 0 ? "+" : "")@unrealizedPct.ToString("P2")
                    </div>
                </div>
            </div>

            <div class="table-scroll-wrapper">
            <MudTable Items="@_openPositions" Dense="true" Hover="true" Striped="true" SortLabel="정렬"
                      RowStyleFunc="@((StockTrader.Models.Position p, int _) => p.UnrealizedPnL >= 0
                          ? "background: rgba(46,125,50,0.08);"
                          : "background: rgba(198,40,40,0.08);")">
                <HeaderContent>
                    <MudTh><MudTableSortLabel SortBy="new Func<StockTrader.Models.Position, object>(x => x.Symbol)">종목</MudTableSortLabel></MudTh>
                    <MudTh Class="col-hide-sm"><MudTableSortLabel SortBy="new Func<StockTrader.Models.Position, object>(x => x.PatternType)">패턴</MudTableSortLabel></MudTh>
                    <MudTh Class="col-hide-md">수량</MudTh>
                    <MudTh><MudTableSortLabel SortBy="new Func<StockTrader.Models.Position, object>(x => x.EntryPrice)">진입가</MudTableSortLabel></MudTh>
                    <MudTh>현재가</MudTh>
                    <MudTh Class="col-hide-sm">손절가</MudTh>
                    <MudTh Class="col-hide-sm">목표가</MudTh>
                    <MudTh><MudTableSortLabel InitialDirection="MudBlazor.SortDirection.Descending" SortBy="new Func<StockTrader.Models.Position, object>(x => x.UnrealizedPnL)">손익</MudTableSortLabel></MudTh>
                    <MudTh>수익률</MudTh>
                    <MudTh Class="col-hide-md">보유기간</MudTh>
                    <MudTh Class="col-hide-md"><MudTableSortLabel SortBy="new Func<StockTrader.Models.Position, object>(x => x.OpenedAt)">진입일</MudTableSortLabel></MudTh>
                </HeaderContent>
                <RowTemplate>
                    @{
                        var oMeta       = PatternMetadataMap.Get(context.PatternType);
                        var holdDaysOp  = (DateTime.UtcNow - context.OpenedAt).TotalDays;
                        var pnlPct      = context.EntryPrice > 0
                                          ? (context.CurrentPrice - context.EntryPrice) / context.EntryPrice
                                          : 0m;
                        var isProfit    = context.UnrealizedPnL >= 0;
                    }
                    <MudTd><b>@context.Symbol</b></MudTd>
                    <MudTd Class="col-hide-sm">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            <MudText Typo="Typo.body2" Style="white-space:nowrap;">@oMeta.KoreanName</MudText>
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Filled"
                                     Color="@PatternMetadataMap.GetMudColor(context.PatternType)"
                                     Class="chip-xs">
                                @oMeta.StyleLabel
                            </MudChip>
                        </MudStack>
                    </MudTd>
                    <MudTd Class="col-hide-md">@(context.Quantity)주</MudTd>
                    <MudTd>$@context.EntryPrice.ToString("F2")</MudTd>
                    <MudTd>
                        @if (context.CurrentPrice > 0)
                        {
                            <MudText Color="@(isProfit ? Color.Success : Color.Error)">
                                $@context.CurrentPrice.ToString("F2")
                            </MudText>
                        }
                        else
                        {
                            <MudText Color="Color.Secondary">-</MudText>
                        }
                    </MudTd>
                    <MudTd Class="col-hide-sm"><MudText Color="Color.Error">$@context.StopLossPrice.ToString("F2")</MudText></MudTd>
                    <MudTd Class="col-hide-sm"><MudText Color="Color.Success">$@context.TargetPrice.ToString("F2")</MudText></MudTd>
                    <MudTd>
                        <MudText Typo="Typo.body2" Color="@(isProfit ? Color.Success : Color.Error)"
                                 Style="font-weight:600;">
                            @(isProfit ? "+" : "")$@context.UnrealizedPnL.ToString("N2")
                        </MudText>
                    </MudTd>
                    <MudTd>
                        <MudText Color="@(isProfit ? Color.Success : Color.Error)">
                            @(pnlPct >= 0 ? "+" : "")@pnlPct.ToString("P2")
                        </MudText>
                    </MudTd>
                    <MudTd Class="col-hide-md">
                        <MudText Typo="Typo.caption">
                            @(holdDaysOp < 1 ? "당일" : $"{holdDaysOp:F0}일")
                        </MudText>
                    </MudTd>
                    <MudTd Class="col-hide-md">
                        <MudTooltip Text="@context.OpenedAt.ToString("yyyy-MM-dd HH:mm")">
                            <MudText Typo="Typo.caption">@context.OpenedAt.ToString("MM/dd HH:mm")</MudText>
                        </MudTooltip>
                    </MudTd>
                </RowTemplate>
            </MudTable>
            </div>@* /table-scroll-wrapper *@
        }
        else if (!_loading)
        {
            <MudAlert Severity="Severity.Info" Class="mt-2">
                현재 진행 중인 포지션이 없습니다.
            </MudAlert>
        }
    </MudTabPanel>

    @* ── 탭 3: 청산 완료 ── *@
    <MudTabPanel Text="청산 완료" Icon="@Icons.Material.Filled.CheckCircle"
                 BadgeData="@(_trades.Count > 0 ? _trades.Count.ToString() : null)"
                 BadgeColor="Color.Default">

        @* 필터 *@
        <MudGrid Class="mb-3" Spacing="2">
            <MudItem xs="12" sm="3">
                <MudSelect T="string" @bind-Value="_filterPattern" Label="패턴" Variant="Variant.Outlined" Dense="true">
                    <MudSelectItem T="string" Value="@("")">전체</MudSelectItem>
                    @foreach (var pattern in Enum.GetValues<PatternType>())
                    {
                        var thMeta = PatternMetadataMap.Get(pattern);
                        <MudSelectItem T="string" Value="@pattern.ToString()">
                            @thMeta.KoreanName (@thMeta.StyleLabel)@(thMeta.Status != PatternStatus.Verified ? $" ⚠ {PatternMetadataMap.GetStatusLabel(thMeta.Status)}" : "")
                        </MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="6" sm="3">
                <MudDatePicker @bind-Date="_fromDate" Label="시작일" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="6" sm="3">
                <MudDatePicker @bind-Date="_toDate" Label="종료일" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="3" Class="d-flex align-end">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="LoadTradesAsync" FullWidth="true" Disabled="_loading">
                    @if (_loading)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    }
                    필터 적용
                </MudButton>
            </MudItem>
        </MudGrid>

        @* 청산 거래 요약 카드 *@
        @{
            var tradesSnapshot = _trades;
            var tradeCount     = tradesSnapshot.Count;
            var totalPnL       = tradeCount > 0 ? tradesSnapshot.Sum(t => t.PnL) : 0m;
            var winRate        = tradeCount > 0
                                 ? (decimal)tradesSnapshot.Count(t => t.IsWin) / tradeCount
                                 : 0m;
            var avgHoldDays    = tradeCount > 0
                                 ? tradesSnapshot.Average(t => (t.ExitTime - t.EntryTime).TotalDays)
                                 : 0.0;
        }

        @if (tradeCount > 0)
        {
            <div class="summary-grid">
                <div class="summary-card">
                    <div class="summary-card-label">총 손익</div>
                    <div class="summary-card-value" style="color: var(--mud-palette-@(totalPnL >= 0 ? "success" : "error"));">
                        $@totalPnL.ToString("N2")
                    </div>
                </div>
                <div class="summary-card">
                    <div class="summary-card-label">승률</div>
                    <div class="summary-card-value">@winRate.ToString("P1")</div>
                </div>
                <div class="summary-card">
                    <div class="summary-card-label">총 거래수</div>
                    <div class="summary-card-value">@tradeCount</div>
                </div>
                <div class="summary-card">
                    <div class="summary-card-label">평균 보유기간</div>
                    <div class="summary-card-value">@avgHoldDays.ToString("F1")일</div>
                </div>
            </div>

            <div class="table-scroll-wrapper">
            <MudTable Items="@_trades" Dense="true" Hover="true" Striped="true"
                      SortLabel="정렬"
                      RowStyleFunc="@((TradeRecord t, int _) => !t.IsWin ? "background: rgba(198,40,40,0.15);" : "")">
                <HeaderContent>
                    <MudTh><MudTableSortLabel SortBy="new Func<TradeRecord, object>(x => x.Symbol)">종목</MudTableSortLabel></MudTh>
                    <MudTh Class="col-hide-sm"><MudTableSortLabel SortBy="new Func<TradeRecord, object>(x => x.PatternType)">패턴</MudTableSortLabel></MudTh>
                    <MudTh Class="col-hide-sm"><MudTableSortLabel SortBy="new Func<TradeRecord, object>(x => x.EntryPrice)">진입가</MudTableSortLabel></MudTh>
                    <MudTh Class="col-hide-sm"><MudTableSortLabel SortBy="new Func<TradeRecord, object>(x => x.ExitPrice)">청산가</MudTableSortLabel></MudTh>
                    <MudTh Class="col-hide-md">수량</MudTh>
                    <MudTh><MudTableSortLabel InitialDirection="MudBlazor.SortDirection.Descending" SortBy="new Func<TradeRecord, object>(x => x.PnL)">손익</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortBy="new Func<TradeRecord, object>(x => x.PnLPercent)">손익률</MudTableSortLabel></MudTh>
                    <MudTh Class="col-hide-md">보유기간</MudTh>
                    <MudTh Class="col-hide-md">청산 사유</MudTh>
                    <MudTh Class="col-hide-sm"><MudTableSortLabel SortBy="new Func<TradeRecord, object>(x => x.EntryTime)">진입일</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortBy="new Func<TradeRecord, object>(x => x.ExitTime)">청산일</MudTableSortLabel></MudTh>
                </HeaderContent>
                <RowTemplate>
                    @{
                        var meta     = PatternMetadataMap.Get(context.PatternType);
                        var holdDays = (context.ExitTime - context.EntryTime).TotalDays;
                    }
                    <MudTd><b>@context.Symbol</b></MudTd>
                    <MudTd Class="col-hide-sm">
                        <MudChip T="string" Size="Size.Small"
                                 Color="@PatternMetadataMap.GetMudColor(context.PatternType)"
                                 Variant="Variant.Filled"
                                 Class="chip-xs">
                            @meta.KoreanName
                        </MudChip>
                    </MudTd>
                    <MudTd Class="col-hide-sm">$@context.EntryPrice.ToString("F2")</MudTd>
                    <MudTd Class="col-hide-sm">$@context.ExitPrice.ToString("F2")</MudTd>
                    <MudTd Class="col-hide-md">@context.Quantity</MudTd>
                    <MudTd>
                        <MudText Color="@(context.IsWin ? Color.Success : Color.Error)">
                            @(context.IsWin ? "+" : "")$@context.PnL.ToString("N2")
                        </MudText>
                    </MudTd>
                    <MudTd>
                        <MudText Color="@(context.IsWin ? Color.Success : Color.Error)">
                            @(context.PnLPercent >= 0 ? "+" : "")@context.PnLPercent.ToString("P2")
                        </MudText>
                    </MudTd>
                    <MudTd Class="col-hide-md">
                        <MudText Typo="Typo.caption">
                            @(holdDays < 1 ? "당일" : $"{holdDays:F0}일")
                        </MudText>
                    </MudTd>
                    <MudTd Class="col-hide-md">@context.ExitReason</MudTd>
                    <MudTd Class="col-hide-sm">@context.EntryTime.ToString("yy/MM/dd")</MudTd>
                    <MudTd>@context.ExitTime.ToString("yy/MM/dd")</MudTd>
                </RowTemplate>
            </MudTable>
            </div>@* /table-scroll-wrapper *@
        }
        else if (!_loading)
        {
            <MudAlert Severity="Severity.Info">아직 청산된 거래가 없습니다.</MudAlert>
        }
    </MudTabPanel>

</MudTabs>

@code {
    [CascadingParameter(Name = "IsMobile")] private bool IsMobile { get; set; }

    private bool _showHelp;
    private bool _loading;
    private string? _error;

    // Tab state
    private int _activeTab = 0;

    // Tab 1: Recommendations
    private List<TradeRecommendation> _recommendations = new();
    private int _recoCount = 50;

    // Tab 2: Open positions
    private List<StockTrader.Models.Position> _openPositions = new();
    private System.Threading.Timer? _positionRefreshTimer;

    // Tab 3: Closed trades
    private List<TradeRecord> _trades = new();
    private string _filterPattern = "";
    private DateTime? _fromDate;
    private DateTime? _toDate;

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            await Task.WhenAll(
                LoadRecommendationsAsync(),
                LoadOpenPositionsAsync(),
                LoadTradesAsync()
            );
        }
        finally
        {
            _loading = false;
            await InvokeAsync(StateHasChanged);
        }

        // 30초마다 진행 중 포지션 갱신 (미실현 손익 실시간 반영)
        _positionRefreshTimer = new System.Threading.Timer(
            async _ =>
            {
                try
                {
                    var broker = await AccountManager.GetActiveBrokerServiceAsync();
                    if (broker != null)
                    {
                        var brokerPositions = await broker.GetPositionsAsync();
                        // DB 포지션에서 메타데이터 보충 (패턴, 손절가, 목표가, 섹터, 진입일)
                        var dbPositions = await TradeRepo.GetOpenPositionsAsync();
                        foreach (var bp in brokerPositions)
                        {
                            var dbMatch = dbPositions.FirstOrDefault(d =>
                                d.Symbol.Equals(bp.Symbol, StringComparison.OrdinalIgnoreCase));
                            if (dbMatch != null)
                            {
                                bp.PatternType = dbMatch.PatternType;
                                bp.StopLossPrice = dbMatch.StopLossPrice;
                                bp.TargetPrice = dbMatch.TargetPrice;
                                bp.Sector = dbMatch.Sector;
                                bp.OpenedAt = dbMatch.OpenedAt;
                            }
                        }
                        _openPositions = brokerPositions;
                    }
                    else
                    {
                        _openPositions = await TradeRepo.GetOpenPositionsAsync();
                    }
                    await InvokeAsync(StateHasChanged);
                }
                catch (ObjectDisposedException) { }
            },
            state: null,
            dueTime: TimeSpan.FromSeconds(30),
            period: TimeSpan.FromSeconds(30));
    }

    public void Dispose()
    {
        _positionRefreshTimer?.Dispose();
    }

    private async Task SetRecoCount(int count)
    {
        _recoCount = count;
        await LoadRecommendationsAsync();
    }

    private async Task LoadRecommendationsAsync()
    {
        _error = null;
        try
        {
            _recommendations = await TradeRepo.GetRecentRecommendationsAsync(_recoCount);
        }
        catch (Exception ex)
        {
            _error = $"추천 내역 로드 실패: {ex.Message}";
        }
    }

    private async Task LoadOpenPositionsAsync()
    {
        try
        {
            _openPositions = await TradeRepo.GetOpenPositionsAsync();
        }
        catch (Exception ex)
        {
            _error = $"진행 중인 거래 로드 실패: {ex.Message}";
        }
    }

    private async Task LoadTradesAsync()
    {
        _error = null;
        try
        {
            PatternType? pattern = Enum.TryParse<PatternType>(_filterPattern, out var parsed)
                ? parsed : null;
            _trades = await TradeRepo.GetTradesAsync(pattern, _fromDate, _toDate);
        }
        catch (Exception ex)
        {
            _error = $"거래 내역 로드 실패: {ex.Message}";
        }
    }
}
