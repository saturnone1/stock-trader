@page "/backtest"
@rendermode InteractiveServer
@using StockTrader.Models
@using StockTrader.Models.Enums
@using StockTrader.Services.Backtest
@using StockTrader.Services.LiveParameter
@using System.Reflection
@inject IBacktestService BacktestService
@inject ILiveParameterService LiveParameterService
@inject ISnackbar Snackbar

<PageTitle>백테스트 - 주식 트레이더</PageTitle>

<MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Class="mb-1">
    <MudText Typo="Typo.h5">백테스트</MudText>
    <MudIconButton Icon="@Icons.Material.Filled.HelpOutline" Size="Size.Small" Color="Color.Default" OnClick="@(() => _showHelp = true)" title="도움말" />
</MudStack>
<MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">과거 데이터를 기반으로 패턴 전략의 수익성을 시뮬레이션합니다. 종목, 기간, 자본금을 설정하고 결과를 확인하세요.</MudText>

<MudDialog @bind-Visible="_showHelp">
    <TitleContent><MudText Typo="Typo.h6">백테스트 도움말</MudText></TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-2">과거 데이터로 전략을 검증하는 시뮬레이션입니다.</MudText>
        <MudList T="string" Dense="true">
            <MudListItem Icon="@Icons.Material.Filled.Circle" IconSize="Size.Small" IconColor="Color.Primary">
                <strong>슬리피지</strong>: 주문가와 체결가의 차이 (기본 0.05%). 실전에선 항상 발생
            </MudListItem>
            <MudListItem Icon="@Icons.Material.Filled.Circle" IconSize="Size.Small" IconColor="Color.Primary">
                <strong>워크포워드</strong>: 학습/검증 구간을 나눠 과적합을 방지. 효율 50% 이상이면 양호
            </MudListItem>
            <MudListItem Icon="@Icons.Material.Filled.Circle" IconSize="Size.Small" IconColor="Color.Primary">
                <strong>몬테카를로</strong>: 거래 순서를 섞어 통계적 유효성 검증. 5% 백분위가 양수면 안정적
            </MudListItem>
            <MudListItem Icon="@Icons.Material.Filled.Circle" IconSize="Size.Small" IconColor="Color.Primary">
                <strong>샤프 비율</strong>: 위험 대비 수익. 1 이상 양호, 2 이상 우수
            </MudListItem>
        </MudList>
    </DialogContent>
    <DialogActions><MudButton OnClick="@(() => _showHelp = false)">닫기</MudButton></DialogActions>
</MudDialog>

<MudCard Class="mb-4">
    <MudCardContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mb-3">
            <MudIcon Icon="@Icons.Material.Filled.Settings" Size="Size.Small" Color="Color.Default" />
            <MudText Typo="Typo.h6">설정</MudText>
        </MudStack>
        @* 기본 설정 *@
        <MudText Typo="Typo.caption" Color="Color.Tertiary" Class="mb-1" Style="font-weight:600; letter-spacing:0.04em; text-transform:uppercase;">기본 설정</MudText>
        <MudGrid>
            <MudItem xs="12" md="4">
                <MudTextField @bind-Value="_symbols" Label="종목 (쉼표로 구분)"
                              Placeholder="AAPL,MSFT,GOOGL" Variant="Variant.Outlined" Margin="Margin.Dense"
                              HelperText="최대 20개 종목 권장" />
            </MudItem>
            <MudItem xs="12" md="2">
                <MudDatePicker @bind-Date="_from" Label="시작일" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" md="2">
                <MudDatePicker @bind-Date="_to" Label="종료일" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" md="2">
                <MudNumericField @bind-Value="_capital" Label="초기 자본금"
                                 Variant="Variant.Outlined" Margin="Margin.Dense" Format="N0" />
            </MudItem>
            <MudItem xs="12" md="2" Class="d-flex align-end">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                           OnClick="RunBacktestAsync" Disabled="@_isRunning">
                    @if (_isRunning)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    }
                    백테스트 실행
                </MudButton>
            </MudItem>
        </MudGrid>

        @* 타임프레임 및 비용 설정 *@
        <MudText Typo="Typo.caption" Color="Color.Tertiary" Class="mt-3 mb-1" Style="font-weight:600; letter-spacing:0.04em; text-transform:uppercase;">타임프레임 및 비용</MudText>
        <MudGrid Class="mt-0">
            <MudItem xs="12" md="3">
                <MudSelect T="TimeFrame" @bind-Value="_timeFrame" Label="타임프레임"
                           Variant="Variant.Outlined" Margin="Margin.Dense"
                           HelperText="@GetTimeFrameHelperText()">
                    <MudSelectItem T="TimeFrame" Value="TimeFrame.OneMinute">1분봉 (스캘핑)</MudSelectItem>
                    <MudSelectItem T="TimeFrame" Value="TimeFrame.FiveMinute">5분봉 (단타)</MudSelectItem>
                    <MudSelectItem T="TimeFrame" Value="TimeFrame.FifteenMinute">15분봉 (단타/스윙)</MudSelectItem>
                    <MudSelectItem T="TimeFrame" Value="TimeFrame.Daily">일봉 (스윙/포지션)</MudSelectItem>
                    <MudSelectItem T="TimeFrame" Value="TimeFrame.Weekly">주봉 (장기)</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="2">
                <MudSelect T="DataSource?" @bind-Value="_dataSource" Label="데이터 소스"
                           Variant="Variant.Outlined" Margin="Margin.Dense"
                           HelperText="null=기본설정 사용">
                    <MudSelectItem T="DataSource?" Value="@((DataSource?)null)">기본 설정</MudSelectItem>
                    <MudSelectItem T="DataSource?" Value="DataSource.Alpaca">Alpaca</MudSelectItem>
                    <MudSelectItem T="DataSource?" Value="DataSource.Yahoo">Yahoo Finance</MudSelectItem>
                    <MudSelectItem T="DataSource?" Value="DataSource.LsSecurities">LS증권 (국내)</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="2">
                <MudSelect @bind-Value="_slippageModel" Label="슬리피지 모델" T="SlippageModel"
                           Variant="Variant.Outlined" Margin="Margin.Dense">
                    <MudSelectItem T="SlippageModel" Value="SlippageModel.Adaptive">적응형 (ATR+거래량)</MudSelectItem>
                    <MudSelectItem T="SlippageModel" Value="SlippageModel.Fixed">고정 비율</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="2">
                <MudNumericField @bind-Value="_slippagePercent" Label="@(_slippageModel == SlippageModel.Fixed ? "슬리피지 (%)" : "기본 슬리피지 (%)")"
                                 Variant="Variant.Outlined" Margin="Margin.Dense" Format="F3"
                                 Step="0.01m" Min="0m" Max="1m" />
            </MudItem>
            <MudItem xs="12" md="2">
                <MudNumericField @bind-Value="_commissionPerTrade" Label="수수료 ($/거래)"
                                 Variant="Variant.Outlined" Margin="Margin.Dense" Format="F2"
                                 Step="0.5m" Min="0m" />
            </MudItem>
        </MudGrid>

        @* 분봉 기간 경고 *@
        @if (_timeFrame != TimeFrame.Daily && _timeFrame != TimeFrame.Weekly)
        {
            <MudGrid Class="mt-1">
                <MudItem xs="12">
                    @if (IsIntraDayPeriodOverLimit())
                    {
                        <MudAlert Severity="Severity.Warning" Dense="true" Icon="@Icons.Material.Filled.Warning">
                            <strong>주의:</strong> @GetTimeFrameLabel(_timeFrame) 백테스트는 데이터 양이 매우 많습니다.
                            현재 선택 기간 <strong>@GetSelectedDays()일</strong>은 권장 최대 기간 <strong>@GetMaxRecommendedDays(_timeFrame)일</strong>을 초과합니다.
                            기간을 줄이거나 일봉으로 전환하는 것을 권장합니다.
                        </MudAlert>
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Info" Dense="true" Icon="@Icons.Material.Filled.AccessTime">
                            @GetTimeFrameLabel(_timeFrame) 백테스트 선택됨 — 데이터 과부하 방지를 위해 워밍업 기간이 자동으로 단축됩니다.
                            권장 최대 기간: <strong>@GetMaxRecommendedDays(_timeFrame)일</strong>
                        </MudAlert>
                    }
                </MudItem>
            </MudGrid>
        }

        @* 고급 분석 설정 *@
        <MudText Typo="Typo.caption" Color="Color.Tertiary" Class="mt-3 mb-1" Style="font-weight:600; letter-spacing:0.04em; text-transform:uppercase;">고급 분석</MudText>
        <MudGrid Class="mt-0">
            <MudItem xs="12" md="3">
                <MudTooltip Text="학습/검증 구간을 나눠 과적합을 방지하는 고급 검증">
                    <MudSwitch @bind-Value="_enableWalkForward" Label="Walk-Forward 분석" Color="Color.Primary" />
                </MudTooltip>
            </MudItem>
            @if (_enableWalkForward)
            {
                <MudItem xs="12" md="2">
                    <MudNumericField @bind-Value="_wfInSampleMonths" Label="IS 기간 (개월)"
                                     Variant="Variant.Outlined" Margin="Margin.Dense"
                                     Min="3" Max="60" />
                </MudItem>
                <MudItem xs="12" md="2">
                    <MudNumericField @bind-Value="_wfOutOfSampleMonths" Label="OOS 기간 (개월)"
                                     Variant="Variant.Outlined" Margin="Margin.Dense"
                                     Min="1" Max="24" />
                </MudItem>
            }
            <MudItem xs="12" md="3">
                <MudTooltip Text="거래 순서를 무작위로 섞어 전략의 통계적 유효성을 검증">
                    <MudSwitch @bind-Value="_enableMonteCarlo" Label="Monte Carlo 시뮬레이션" Color="Color.Primary" />
                </MudTooltip>
            </MudItem>
            @if (_enableMonteCarlo)
            {
                <MudItem xs="12" md="2">
                    <MudNumericField @bind-Value="_mcSimulations" Label="시뮬레이션 횟수"
                                     Variant="Variant.Outlined" Margin="Margin.Dense"
                                     Min="100" Max="10000" Step="100" />
                </MudItem>
            }
        </MudGrid>

        <MudText Typo="Typo.caption" Color="Color.Tertiary" Class="mt-3 mb-1" Style="font-weight:600; letter-spacing:0.04em; text-transform:uppercase;">패턴 선택</MudText>
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-1">
            <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Filled" Class="mr-1">스캘핑</MudChip>
            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled" Class="mr-1">단타</MudChip>
            <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled" Class="mr-1">스윙</MudChip>
            <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Filled" Class="mr-1">포지션</MudChip>
            <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined" Class="mr-1">필터</MudChip>
        </MudText>
        @* 현재 타임프레임에 적합한 패턴 힌트 *@
        <MudText Typo="Typo.caption" Color="Color.Tertiary" Class="mb-2">
            @GetTimeFramePatternHint(_timeFrame)
        </MudText>
        <MudGrid Spacing="1">
            @foreach (var pattern in Enum.GetValues<PatternType>())
            {
                var meta = PatternMetadataMap.Get(pattern);
                var mudColor = PatternMetadataMap.GetMudColor(pattern);
                <MudItem xs="12" sm="6" md="4" lg="3">
                    <MudTooltip Text="@($"{meta.Description} | 보유기간: {meta.HoldingPeriod} | 지표: {meta.Indicators}")"
                                Placement="Placement.Top" Arrow="true">
                        <MudPaper Outlined="true" Class="pa-2 d-flex align-center gap-2"
                                  Style="@(_selectedPatterns.Contains(pattern) ? "border-color: var(--mud-palette-primary); background: rgba(var(--mud-palette-primary-rgb), 0.08);" : "opacity: 0.7;")">
                            <MudCheckBox T="bool"
                                         Value="@_selectedPatterns.Contains(pattern)"
                                         ValueChanged="@(v => TogglePattern(pattern, v))"
                                         Dense="true"
                                         Color="Color.Primary"
                                         Class="mr-0" />
                            <MudStack Spacing="0" Style="flex: 1; min-width: 0;">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                    <MudText Typo="Typo.body2" Style="font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                        @meta.KoreanName
                                    </MudText>
                                    <MudChip T="string" Size="Size.Small" Color="@mudColor"
                                             Variant="Variant.Filled"
                                             Style="height: 18px; font-size: 10px; padding: 0 6px; min-width: 0;">
                                        @meta.StyleLabel
                                    </MudChip>
                                    @if (meta.Status != PatternStatus.Verified)
                                    {
                                        <MudChip T="string" Size="Size.Small"
                                                 Color="@PatternMetadataMap.GetStatusColor(meta.Status)"
                                                 Variant="Variant.Outlined"
                                                 Icon="@PatternMetadataMap.GetStatusIcon(meta.Status)"
                                                 Style="height: 18px; font-size: 10px; padding: 0 6px; min-width: 0;">
                                            @PatternMetadataMap.GetStatusLabel(meta.Status)
                                        </MudChip>
                                    }
                                </MudStack>
                                <MudText Typo="Typo.caption" Color="Color.Secondary"
                                         Style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                    @meta.EnglishName
                                </MudText>
                            </MudStack>
                        </MudPaper>
                    </MudTooltip>
                </MudItem>
            }
        </MudGrid>

        @* ── 리스크 관리 섹션 ── *@
        <MudDivider Class="mt-3 mb-2" />
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-2">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                <MudIcon Icon="@Icons.Material.Filled.Shield" Size="Size.Small" Color="Color.Warning" />
                <MudText Typo="Typo.subtitle2">리스크 관리</MudText>
                <MudTooltip Text="포지션 크기와 손실 한도를 제어합니다. 실제 트레이딩 설정(appsettings.json)은 변경되지 않습니다." Placement="Placement.Right">
                    <MudIcon Icon="@Icons.Material.Filled.HelpOutline" Size="Size.Small" Color="Color.Secondary" Style="cursor:help;" />
                </MudTooltip>
            </MudStack>
            <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Secondary"
                       StartIcon="@Icons.Material.Filled.RestartAlt"
                       OnClick="ResetRiskDefaults">기본값 복원</MudButton>
        </MudStack>

        <MudGrid Spacing="2">
            @* 거래당 리스크 비율 *@
            <MudItem xs="12" md="6" lg="4">
                <MudStack Spacing="0">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">거래당 리스크 비율</MudText>
                        <MudText Typo="Typo.caption" Style="font-weight:600; color: var(--mud-palette-warning);">
                            @(_riskPerTradePercent * 100m).ToString("F1")%
                        </MudText>
                    </MudStack>
                    <MudSlider @bind-Value="_riskPerTradePercent"
                               Min="0.001m" Max="0.05m" Step="0.001m"
                               Color="Color.Warning" />
                    <MudStack Row="true" Justify="Justify.SpaceBetween">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">0.1%</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">5%</MudText>
                    </MudStack>
                    <MudText Typo="Typo.caption" Color="Color.Tertiary">
                        계좌 $@(_capital.ToString("N0")) 기준 거래당 리스크 $@((_capital * _riskPerTradePercent).ToString("N0"))
                    </MudText>
                </MudStack>
            </MudItem>

            @* 일일 손실 한도 *@
            <MudItem xs="12" md="6" lg="4">
                <MudStack Spacing="0">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">일일 손실 한도</MudText>
                        <MudText Typo="Typo.caption" Style="font-weight:600; color: var(--mud-palette-error);">
                            @(_riskDailyLossLimitPercent * 100m).ToString("F1")%
                        </MudText>
                    </MudStack>
                    <MudSlider @bind-Value="_riskDailyLossLimitPercent"
                               Min="0.01m" Max="0.15m" Step="0.005m"
                               Color="Color.Error" />
                    <MudStack Row="true" Justify="Justify.SpaceBetween">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">1%</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">15%</MudText>
                    </MudStack>
                    <MudText Typo="Typo.caption" Color="Color.Tertiary">
                        하루 최대 손실 $@((_capital * _riskDailyLossLimitPercent).ToString("N0"))에서 자동 중지
                    </MudText>
                </MudStack>
            </MudItem>

            @* 최대 동시 포지션 수 *@
            <MudItem xs="12" md="6" lg="4">
                <MudStack Spacing="1">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">최대 동시 포지션 수</MudText>
                        <MudText Typo="Typo.caption" Style="font-weight:600;">@_riskMaxTotalPositions 종목</MudText>
                    </MudStack>
                    <MudSlider @bind-Value="_riskMaxTotalPositions"
                               Min="1" Max="30" Step="1"
                               Color="Color.Info" />
                    <MudStack Row="true" Justify="Justify.SpaceBetween">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">1</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">30</MudText>
                    </MudStack>
                    <MudText Typo="Typo.caption" Color="Color.Tertiary">
                        종목당 최대 자본 비중 @((100.0m / _riskMaxTotalPositions).ToString("F0"))%
                    </MudText>
                </MudStack>
            </MudItem>

            @* 섹터당 최대 포지션 *@
            <MudItem xs="12" md="6" lg="4">
                <MudStack Spacing="1">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">섹터당 최대 포지션</MudText>
                        <MudText Typo="Typo.caption" Style="font-weight:600;">@_riskMaxPositionsPerSector 종목</MudText>
                    </MudStack>
                    <MudSlider @bind-Value="_riskMaxPositionsPerSector"
                               Min="1" Max="10" Step="1"
                               Color="Color.Success" />
                    <MudStack Row="true" Justify="Justify.SpaceBetween">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">1</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">10</MudText>
                    </MudStack>
                </MudStack>
            </MudItem>
        </MudGrid>

        @* 리스크 요약 인포 박스 *@
        <MudPaper Outlined="true" Class="pa-2 mt-2" Style="border-color: rgba(255,193,7,0.3); background: rgba(255,193,7,0.04);">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Wrap="Wrap.Wrap">
                <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" Color="Color.Warning" />
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    포지션 크기 = 자본 × 거래당리스크 ÷ 손절폭.
                    현재 설정: 거래당 <strong style="color:var(--mud-palette-warning);">@((_riskPerTradePercent * 100m).ToString("F1"))%</strong>,
                    일일한도 <strong style="color:var(--mud-palette-error);">@((_riskDailyLossLimitPercent * 100m).ToString("F1"))%</strong>,
                    최대 <strong>@_riskMaxTotalPositions</strong>종목 동시 보유
                </MudText>
            </MudStack>
        </MudPaper>

        @* ── 패턴 상세 파라미터 섹션 ── *@
        @if (_selectedPatterns.Count > 0)
        {
            <MudDivider Class="mt-3 mb-2" />
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-1">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                    <MudIcon Icon="@Icons.Material.Filled.Tune" Size="Size.Small" Color="Color.Primary" />
                    <MudText Typo="Typo.subtitle2">패턴 상세 파라미터</MudText>
                    <MudTooltip Text="각 패턴의 진입 조건 파라미터를 조정합니다. 백테스트 실행 시에만 적용되며, 실제 라이브 트레이딩 설정은 변경되지 않습니다." Placement="Placement.Right">
                        <MudIcon Icon="@Icons.Material.Filled.HelpOutline" Size="Size.Small" Color="Color.Secondary" Style="cursor:help;" />
                    </MudTooltip>
                </MudStack>
                <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Secondary"
                           StartIcon="@Icons.Material.Filled.RestartAlt"
                           OnClick="ResetPatternDefaults">기본값 복원</MudButton>
            </MudStack>

            <MudExpansionPanels MultiExpansion="true" Elevation="0" Class="mb-1">
                @foreach (var pattern in Enum.GetValues<PatternType>())
                {
                    if (!_selectedPatterns.Contains(pattern)) continue;
                    if (!PatternParamViewModel.PatternFieldDefs.TryGetValue(pattern, out var pFields)) continue;

                    var meta = PatternMetadataMap.Get(pattern);
                    var mudColor = PatternMetadataMap.GetMudColor(pattern);

                    <MudExpansionPanel>
                        <TitleContent>
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                <MudChip T="string" Size="Size.Small" Color="@mudColor"
                                         Variant="@(meta.Style == TradingStyle.Filter ? Variant.Outlined : Variant.Filled)"
                                         Style="height:18px; font-size:10px; padding:0 6px; min-width:0;">@meta.StyleLabel</MudChip>
                                <MudText Typo="Typo.body2" Style="font-weight:500;">@meta.KoreanName (@meta.EnglishName)</MudText>
                            </MudStack>
                        </TitleContent>
                        <ChildContent>
                            <MudGrid Spacing="2" Class="pa-2">
                                @foreach (var grp in pFields.GroupBy(f => f.Category).OrderBy(g => g.Key == "exit" ? 1 : 0))
                                {
                                    <MudItem xs="12">
                                        @if (grp.Key != pFields[0].Category)
                                        {
                                            <MudDivider />
                                        }
                                        <MudText Typo="Typo.caption"
                                                 Color="@(grp.Key == "exit" ? Color.Secondary : Color.Tertiary)"
                                                 Class="mt-1"
                                                 Style="font-weight:600; letter-spacing:0.04em; text-transform:uppercase;">
                                            @(grp.Key == "exit" ? "청산 전략" : "감지 파라미터")
                                        </MudText>
                                    </MudItem>
                                    @foreach (var field in grp)
                                    {
                                        var prop = PatternParamViewModel.FieldPropCache[field.VmPropName];
                                        <MudItem xs="12" sm="6" md="4">
                                            @if (prop.PropertyType == typeof(decimal))
                                            {
                                                <MudNumericField T="decimal"
                                                    Value="@((decimal)prop.GetValue(_p)!)"
                                                    ValueChanged="@((decimal v) => { prop.SetValue(_p, v); })"
                                                    Label="@field.Label"
                                                    Variant="Variant.Outlined" Margin="Margin.Dense"
                                                    Format="@field.Format" Step="@field.DecStep"
                                                    HelperText="@field.HelperText" />
                                            }
                                            else if (prop.PropertyType == typeof(int))
                                            {
                                                <MudNumericField T="int"
                                                    Value="@((int)prop.GetValue(_p)!)"
                                                    ValueChanged="@((int v) => { prop.SetValue(_p, v); })"
                                                    Label="@field.Label"
                                                    Variant="Variant.Outlined" Margin="Margin.Dense"
                                                    HelperText="@field.HelperText" />
                                            }
                                            else if (prop.PropertyType == typeof(string))
                                            {
                                                <MudTextField T="string"
                                                    Value="@((string?)prop.GetValue(_p) ?? "")"
                                                    ValueChanged="@((string v) => { prop.SetValue(_p, v); })"
                                                    Label="@field.Label"
                                                    Variant="Variant.Outlined" Margin="Margin.Dense"
                                                    HelperText="@field.HelperText" />
                                            }
                                        </MudItem>
                                    }
                                }
                            </MudGrid>
                        </ChildContent>
                    </MudExpansionPanel>
                }
            </MudExpansionPanels>
        }

    </MudCardContent>
</MudCard>

@if (_result != null)
{
    @* 치명적 에러 표시 *@
    @if (_result.ErrorMessage != null)
    {
        <MudAlert Severity="Severity.Error" Class="mb-3">
            <strong>백테스트 실패:</strong> @_result.ErrorMessage
        </MudAlert>
    }

    @* 경고 목록 표시 *@
    @if (_result.Warnings.Count > 0)
    {
        <MudCard Class="mb-3">
            <MudCardContent Class="pa-3">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mb-2">
                    <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Warning" Size="Size.Small" />
                    <MudText Typo="Typo.subtitle2" Color="Color.Warning">데이터 경고 (@(_result.Warnings.Count)건)</MudText>
                </MudStack>
                @foreach (var warning in _result.Warnings)
                {
                    <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-1">@warning</MudAlert>
                }
                @if (_result.UsedTimeFrame is TimeFrame.OneMinute or TimeFrame.FiveMinute or TimeFrame.FifteenMinute)
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2">
                        분봉 백테스트 시 Yahoo Finance API 제한으로 인해 최근 데이터만 사용 가능합니다.
                        Alpaca 데이터 소스를 사용하면 더 긴 기간의 분봉 데이터를 받을 수 있습니다.
                        (설정 → 데이터 소스 변경)
                    </MudText>
                }
            </MudCardContent>
        </MudCard>
    }

    @* 타임프레임 표시 배너 *@
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
        <MudChip T="string" Size="Size.Medium" Color="Color.Primary" Variant="Variant.Filled"
                 Icon="@Icons.Material.Filled.AccessTime">
            @GetTimeFrameLabel(_result.UsedTimeFrame) 백테스트
        </MudChip>
        <MudText Typo="Typo.caption" Color="Color.Secondary">
            선택 패턴: @string.Join(", ", _selectedPatterns.Select(p => PatternMetadataMap.GetKoreanName(p)))
        </MudText>
        @if (_result.ActualDataFrom.HasValue && _result.ActualDataFrom.Value > (_from ?? DateTime.MinValue).AddDays(1))
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined"
                     Icon="@Icons.Material.Filled.AccessTime">
                실제 데이터: @_result.ActualDataFrom.Value.ToString("yyyy-MM-dd") 부터
            </MudChip>
        }
    </MudStack>

    @* Summary cards *@
    <MudGrid Class="mb-3">
        <MudItem xs="6" sm="4" md="2">
            <MudCard Style="min-height: 84px;">
                <MudCardContent Class="text-center pa-3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">총 수익</MudText>
                    <MudText Typo="Typo.h5" Class="mt-1" Color="@(_result.TotalReturn >= 0 ? Color.Success : Color.Error)">
                        @(_result.TotalReturn >= 0 ? "+" : "")$@_result.TotalReturn.ToString("N0")
                    </MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="6" sm="4" md="2">
            <MudCard Style="min-height: 84px;">
                <MudCardContent Class="text-center pa-3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">수익률</MudText>
                    <MudText Typo="Typo.h5" Class="mt-1" Color="@(_result.TotalReturnPercent >= 0 ? Color.Success : Color.Error)">
                        @_result.TotalReturnPercent.ToString("P2")
                    </MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="6" sm="4" md="2">
            <MudCard Style="min-height: 84px;">
                <MudCardContent Class="text-center pa-3">
                    <MudTooltip Text="최고점 대비 최대 하락폭. -20% 이내면 양호" Placement="Placement.Top">
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Style="cursor:help">최대 낙폭 ⓘ</MudText>
                    </MudTooltip>
                    <MudText Typo="Typo.h5" Class="mt-1" Color="Color.Error">@_result.MaxDrawdown.ToString("P2")</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="6" sm="4" md="2">
            <MudCard Style="min-height: 84px;">
                <MudCardContent Class="text-center pa-3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">승률</MudText>
                    <MudText Typo="Typo.h5" Class="mt-1">@_result.OverallWinRate.ToString("P1")</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="6" sm="4" md="2">
            <MudCard Style="min-height: 84px;">
                <MudCardContent Class="text-center pa-3">
                    <MudTooltip Text="위험 대비 수익률. 1 이상 양호, 2 이상 우수" Placement="Placement.Top">
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Style="cursor:help">샤프 비율 ⓘ</MudText>
                    </MudTooltip>
                    <MudText Typo="Typo.h5" Class="mt-1"
                             Color="@(_result.SharpeRatio >= 1 ? Color.Success : _result.SharpeRatio >= 0 ? Color.Warning : Color.Error)">
                        @_result.SharpeRatio.ToString("F2")
                    </MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="6" sm="4" md="2">
            <MudCard Style="min-height: 84px;">
                <MudCardContent Class="text-center pa-3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">총 거래</MudText>
                    <MudText Typo="Typo.h5" Class="mt-1">@_result.TotalTrades</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>

    @* 실거래 적용 버튼 *@
    <MudCard Class="mb-3" Style="border: 1px solid var(--mud-palette-primary); background: var(--mud-palette-surface);">
        <MudCardContent Class="pa-3">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.RocketLaunch" Color="Color.Primary" />
                <MudStack Spacing="0">
                    <MudText Typo="Typo.subtitle1" Style="font-weight: 600;">실거래 적용</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        현재 백테스트 파라미터 (패턴 감지, 청산 전략, 리스크 관리)를 실거래에 적용합니다.
                        적용 후 즉시 반영되며, 다음 패턴 스캔부터 새 파라미터가 사용됩니다.
                    </MudText>
                </MudStack>
                <MudSpacer />
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Check"
                           OnClick="ApplyToLiveAsync"
                           Disabled="_isApplying || _result.TotalTrades == 0">
                    @if (_isApplying)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        @:적용 중...
                    }
                    else
                    {
                        @:실거래에 적용
                    }
                </MudButton>
            </MudStack>
            @if (_applySuccess)
            {
                <MudAlert Severity="Severity.Success" Dense="true" Class="mt-2">
                    실거래 파라미터가 성공적으로 적용되었습니다. 패턴 감지, 청산 전략, 리스크 관리 설정이 모두 업데이트되었습니다.
                </MudAlert>
            }
            @if (_applyError != null)
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2">@_applyError</MudAlert>
            }
        </MudCardContent>
    </MudCard>

    @* Cost breakdown *@
    @if (_result.TotalSlippageCost > 0 || _result.TotalCommissionCost > 0)
    {
        <MudGrid Class="mb-3">
            <MudItem xs="4">
                <MudCard>
                    <MudCardContent Class="text-center pa-3">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">슬리피지 비용</MudText>
                        <MudText Typo="Typo.h6" Class="mt-1" Color="Color.Warning">$@_result.TotalSlippageCost.ToString("N2")</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="4">
                <MudCard>
                    <MudCardContent Class="text-center pa-3">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">수수료 비용</MudText>
                        <MudText Typo="Typo.h6" Class="mt-1" Color="Color.Warning">$@_result.TotalCommissionCost.ToString("N2")</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="4">
                <MudCard>
                    <MudCardContent Class="text-center pa-3">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">총 비용</MudText>
                        <MudText Typo="Typo.h6" Class="mt-1" Color="Color.Error">$@((_result.TotalSlippageCost + _result.TotalCommissionCost).ToString("N2"))</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>
    }

    @* Equity Curve Chart *@
    @if (_chartData.Count > 1)
    {
        <MudText Typo="Typo.h6" Class="mb-2">자산 곡선</MudText>
        <MudCard Class="mb-3 pa-3">
            <ApexCharts.ApexChart TItem="EquityPoint" Options="_equityChartOptions" Height="300">
                <ApexCharts.ApexPointSeries TItem="EquityPoint"
                                 Items="_chartData"
                                 SeriesType="ApexCharts.SeriesType.Area"
                                 XValue="@(e => e.Date.ToString("yyyy-MM-dd"))"
                                 YAggregate="@(e => e.Last().Equity)"
                                 Name="자산" />
            </ApexCharts.ApexChart>
        </MudCard>
    }

    @* Walk-Forward Results *@
    @if (_result.WalkForward != null && _result.WalkForward.Windows.Count > 0)
    {
        <MudExpansionPanels Class="mb-3">
            <MudExpansionPanel Text="워크포워드 분석 결과" Expanded="false">
                <MudGrid Class="mb-3 mt-1">
                    <MudItem xs="12" md="3">
                        <MudCard>
                            <MudCardContent Class="text-center">
                                <MudText Typo="Typo.subtitle2" Color="Color.Secondary">OOS 평균 수익률</MudText>
                                <MudText Typo="Typo.h6" Color="@(_result.WalkForward.AggregateOosReturnPercent >= 0 ? Color.Success : Color.Error)">
                                    @_result.WalkForward.AggregateOosReturnPercent.ToString("P2")
                                </MudText>
                            </MudCardContent>
                        </MudCard>
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudCard>
                            <MudCardContent Class="text-center">
                                <MudText Typo="Typo.subtitle2" Color="Color.Secondary">OOS 최대 낙폭</MudText>
                                <MudText Typo="Typo.h6" Color="Color.Error">
                                    @_result.WalkForward.AggregateOosMaxDrawdown.ToString("P2")
                                </MudText>
                            </MudCardContent>
                        </MudCard>
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudCard>
                            <MudCardContent Class="text-center">
                                <MudText Typo="Typo.subtitle2" Color="Color.Secondary">OOS 승률</MudText>
                                <MudText Typo="Typo.h6">
                                    @_result.WalkForward.AggregateOosWinRate.ToString("P1")
                                </MudText>
                            </MudCardContent>
                        </MudCard>
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudCard>
                            <MudCardContent Class="text-center">
                                <MudText Typo="Typo.subtitle2" Color="Color.Secondary">WF 효율</MudText>
                                <MudText Typo="Typo.h6"
                                         Color="@(_result.WalkForward.WalkForwardEfficiency >= 0.5m ? Color.Success : Color.Warning)">
                                    @_result.WalkForward.WalkForwardEfficiency.ToString("P1")
                                </MudText>
                            </MudCardContent>
                        </MudCard>
                    </MudItem>
                </MudGrid>

                <MudTable Items="@_result.WalkForward.Windows" Dense="true" Hover="true" Striped="true" Class="mb-2">
                    <HeaderContent>
                        <MudTh>#</MudTh>
                        <MudTh>IS 기간</MudTh>
                        <MudTh>IS 거래수</MudTh>
                        <MudTh>IS 수익률</MudTh>
                        <MudTh>OOS 기간</MudTh>
                        <MudTh>OOS 거래수</MudTh>
                        <MudTh>OOS 수익률</MudTh>
                        <MudTh>OOS 낙폭</MudTh>
                        <MudTh>효율</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@(_result.WalkForward.Windows.IndexOf(context) + 1)</MudTd>
                        <MudTd>@context.InSampleFrom.ToString("yy/MM") ~ @context.InSampleTo.ToString("yy/MM")</MudTd>
                        <MudTd>@context.InSampleTrades</MudTd>
                        <MudTd>
                            <MudText Color="@(context.InSampleReturnPercent >= 0 ? Color.Success : Color.Error)">
                                @context.InSampleReturnPercent.ToString("P2")
                            </MudText>
                        </MudTd>
                        <MudTd>@context.OutOfSampleFrom.ToString("yy/MM") ~ @context.OutOfSampleTo.ToString("yy/MM")</MudTd>
                        <MudTd>@context.OutOfSampleTrades</MudTd>
                        <MudTd>
                            <MudText Color="@(context.OutOfSampleReturnPercent >= 0 ? Color.Success : Color.Error)">
                                @context.OutOfSampleReturnPercent.ToString("P2")
                            </MudText>
                        </MudTd>
                        <MudTd>
                            <MudText Color="Color.Error">@context.OutOfSampleMaxDrawdown.ToString("P2")</MudText>
                        </MudTd>
                        <MudTd>
                            <MudText Color="@(context.Efficiency >= 0.5m ? Color.Success : Color.Warning)">
                                @context.Efficiency.ToString("P1")
                            </MudText>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            </MudExpansionPanel>
        </MudExpansionPanels>
    }

    @* Monte Carlo Results *@
    @if (_result.MonteCarlo != null)
    {
        <MudExpansionPanels Class="mb-3">
            <MudExpansionPanel Text="@($"몬테카를로 시뮬레이션 ({_result.MonteCarlo.Simulations}회)")" Expanded="false">
                <MudGrid Class="mb-3 mt-1">
                    <MudItem xs="12" md="3">
                        <MudCard>
                            <MudCardContent Class="text-center">
                                <MudText Typo="Typo.subtitle2" Color="Color.Secondary">중앙값 최종 자산</MudText>
                                <MudText Typo="Typo.h6">$@_result.MonteCarlo.MedianFinalEquity.ToString("N0")</MudText>
                            </MudCardContent>
                        </MudCard>
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudCard>
                            <MudCardContent Class="text-center">
                                <MudText Typo="Typo.subtitle2" Color="Color.Secondary">손실 확률</MudText>
                                <MudText Typo="Typo.h6" Color="@(_result.MonteCarlo.ProbabilityOfLoss > 0.3m ? Color.Error : Color.Success)">
                                    @_result.MonteCarlo.ProbabilityOfLoss.ToString("P1")
                                </MudText>
                            </MudCardContent>
                        </MudCard>
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudCard>
                            <MudCardContent Class="text-center">
                                <MudText Typo="Typo.subtitle2" Color="Color.Secondary">중앙값 최대 낙폭</MudText>
                                <MudText Typo="Typo.h6" Color="Color.Warning">@_result.MonteCarlo.MedianMaxDrawdown.ToString("P2")</MudText>
                            </MudCardContent>
                        </MudCard>
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudCard>
                            <MudCardContent Class="text-center">
                                <MudText Typo="Typo.subtitle2" Color="Color.Secondary">최악 낙폭 (95%)</MudText>
                                <MudText Typo="Typo.h6" Color="Color.Error">@_result.MonteCarlo.WorstCaseMaxDrawdown.ToString("P2")</MudText>
                            </MudCardContent>
                        </MudCard>
                    </MudItem>
                </MudGrid>

                <MudCard Class="mb-2">
                    <MudCardContent>
                        <MudText Typo="Typo.subtitle1" Class="mb-2">최종 자산 분포</MudText>
                        <MudSimpleTable Dense="true" Hover="true">
                            <thead>
                                <tr>
                                    <th>백분위</th>
                                    <th>최종 자산</th>
                                    <th>수익률</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>5% (최악)</td>
                                    <td>$@_result.MonteCarlo.Percentile5Equity.ToString("N0")</td>
                                    <td class="@(_result.MonteCarlo.Percentile5Equity >= _capital ? "mud-success-text" : "mud-error-text")">
                                        @(SafeReturnPercent(_result.MonteCarlo.Percentile5Equity).ToString("P2"))
                                    </td>
                                </tr>
                                <tr>
                                    <td>25%</td>
                                    <td>$@_result.MonteCarlo.Percentile25Equity.ToString("N0")</td>
                                    <td class="@(_result.MonteCarlo.Percentile25Equity >= _capital ? "mud-success-text" : "mud-error-text")">
                                        @(SafeReturnPercent(_result.MonteCarlo.Percentile25Equity).ToString("P2"))
                                    </td>
                                </tr>
                                <tr style="font-weight: bold;">
                                    <td>50% (중앙값)</td>
                                    <td>$@_result.MonteCarlo.MedianFinalEquity.ToString("N0")</td>
                                    <td class="@(_result.MonteCarlo.MedianFinalEquity >= _capital ? "mud-success-text" : "mud-error-text")">
                                        @(SafeReturnPercent(_result.MonteCarlo.MedianFinalEquity).ToString("P2"))
                                    </td>
                                </tr>
                                <tr>
                                    <td>75%</td>
                                    <td>$@_result.MonteCarlo.Percentile75Equity.ToString("N0")</td>
                                    <td class="@(_result.MonteCarlo.Percentile75Equity >= _capital ? "mud-success-text" : "mud-error-text")">
                                        @(SafeReturnPercent(_result.MonteCarlo.Percentile75Equity).ToString("P2"))
                                    </td>
                                </tr>
                                <tr>
                                    <td>95% (최선)</td>
                                    <td>$@_result.MonteCarlo.Percentile95Equity.ToString("N0")</td>
                                    <td class="@(_result.MonteCarlo.Percentile95Equity >= _capital ? "mud-success-text" : "mud-error-text")">
                                        @(SafeReturnPercent(_result.MonteCarlo.Percentile95Equity).ToString("P2"))
                                    </td>
                                </tr>
                            </tbody>
                        </MudSimpleTable>
                    </MudCardContent>
                </MudCard>
            </MudExpansionPanel>
        </MudExpansionPanels>
    }

    @* 거래 0건 안내 *@
    @if (_result.TotalTrades == 0 && _result.ErrorMessage == null)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-3">
            <strong>거래 신호 없음:</strong> 선택한 기간/종목/패턴 조합에서 진입 신호가 생성되지 않았습니다.
            @if (_result.UsedTimeFrame is TimeFrame.OneMinute or TimeFrame.FiveMinute or TimeFrame.FifteenMinute)
            {
                <span>분봉 백테스트는 데이터 기간이 짧으므로, 시작일을 오늘 기준 @GetMaxRecommendedDays(_result.UsedTimeFrame)일 이내로 설정하고 재시도하세요.</span>
            }
            else
            {
                <span>다른 패턴을 선택하거나 기간을 늘려보세요.</span>
            }
        </MudAlert>
    }

    @* Pattern stats *@
    @if (_result.PerPatternStats.Count > 0)
    {
        <MudText Typo="Typo.h6" Class="mb-2">패턴별 상세 분석</MudText>
        <PatternStatsTable Stats="@_result.PerPatternStats.Values.ToList()" />
    }

    @* Symbol stats *@
    @if (_result.PerSymbolStats.Count > 0)
    {
        <MudText Typo="Typo.h6" Class="mt-4 mb-2">종목별 자본 배분 & 수익</MudText>
        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">
            포지션 상한: 자본금의 <b>@((1.0m / Math.Max(1, _riskMaxTotalPositions)).ToString("P1"))</b> (=$@((_capital / Math.Max(1, _riskMaxTotalPositions)).ToString("N0")))
            &nbsp;|&nbsp; 최대 동시 보유: <b>@_riskMaxTotalPositions</b>개
            &nbsp;|&nbsp; 1회 리스크: <b>@(_riskPerTradePercent.ToString("P1"))</b>
        </MudAlert>
        <MudTable Items="@_result.PerSymbolStats" Dense="true" Hover="true" Striped="true">
            <HeaderContent>
                <MudTh>종목</MudTh>
                <MudTh>거래 수</MudTh>
                <MudTh>승률</MudTh>
                <MudTh>최대 배분</MudTh>
                <MudTh>최대 투입금</MudTh>
                <MudTh>평균 손익%</MudTh>
                <MudTh>총 손익</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd><b>@context.Symbol</b></MudTd>
                <MudTd>@context.TradeCount</MudTd>
                <MudTd>@context.WinRate.ToString("P1")</MudTd>
                <MudTd>@context.MaxAllocationPercent.ToString("P1")</MudTd>
                <MudTd>$@context.MaxPositionSize.ToString("N0")</MudTd>
                <MudTd>
                    <MudText Color="@(context.AvgPnLPercent >= 0 ? Color.Success : Color.Error)">
                        @context.AvgPnLPercent.ToString("P2")
                    </MudText>
                </MudTd>
                <MudTd>
                    <MudText Color="@(context.TotalPnL >= 0 ? Color.Success : Color.Error)">
                        @(context.TotalPnL >= 0 ? "+" : "")$@context.TotalPnL.ToString("N0")
                    </MudText>
                </MudTd>
            </RowTemplate>
        </MudTable>
    }

    @* Trade history *@
    @if (_result.Trades.Count > 0)
    {
        <MudText Typo="Typo.h6" Class="mt-4 mb-2">거래 내역 (@(_result.Trades.Count)건)</MudText>
        <MudTable @ref="_tradeTable" Items="@_result.Trades" Dense="true" Hover="true" Striped="true"
                  FixedHeader="true" Height="500px" RowsPerPage="50"
                  CurrentPage="0">
            <HeaderContent>
                <MudTh>#</MudTh>
                <MudTh>종목</MudTh>
                <MudTh>패턴</MudTh>
                <MudTh>진입가</MudTh>
                <MudTh>청산가</MudTh>
                <MudTh>수량</MudTh>
                <MudTh>진입일</MudTh>
                <MudTh>청산일</MudTh>
                <MudTh>손익 ($)</MudTh>
                <MudTh>손익 (%)</MudTh>
                <MudTh>청산 사유</MudTh>
            </HeaderContent>
            <RowTemplate>
                @{ var rowIdx = _result.Trades.IndexOf(context); }
                <MudTd DataLabel="#">@(rowIdx + 1)</MudTd>
                <MudTd DataLabel="종목"><b>@context.Symbol</b></MudTd>
                <MudTd DataLabel="패턴">
                    <span style="white-space: nowrap;">
                        @PatternMetadataMap.GetKoreanName(context.PatternType)
                        <span class="mud-chip mud-chip-size-small" style="height:18px;font-size:10px;padding:0 6px;background:var(--mud-palette-primary);color:white;border-radius:12px;vertical-align:middle;">
                            @PatternMetadataMap.GetStyleLabel(context.PatternType)
                        </span>
                    </span>
                </MudTd>
                <MudTd DataLabel="진입가">@FormatPrice(context.EntryPrice)</MudTd>
                <MudTd DataLabel="청산가">@FormatPrice(context.ExitPrice)</MudTd>
                <MudTd DataLabel="수량">@context.Quantity</MudTd>
                <MudTd DataLabel="진입일">@context.EntryTime.ToString("yy-MM-dd")</MudTd>
                <MudTd DataLabel="청산일">@context.ExitTime.ToString("yy-MM-dd")</MudTd>
                <MudTd DataLabel="손익 ($)">
                    <span style="color: @(context.PnL >= 0 ? "var(--mud-palette-success)" : "var(--mud-palette-error)")">
                        @(context.PnL >= 0 ? "+" : "")@context.PnL.ToString("N0")
                    </span>
                </MudTd>
                <MudTd DataLabel="손익 (%)">
                    <span style="color: @(context.PnLPercent >= 0 ? "var(--mud-palette-success)" : "var(--mud-palette-error)")">
                        @(context.PnLPercent >= 0 ? "+" : "")@context.PnLPercent.ToString("P1")
                    </span>
                </MudTd>
                <MudTd DataLabel="청산 사유">
                    <span class="mud-chip mud-chip-size-small" style="height:18px;font-size:10px;padding:0 6px;border-radius:12px;color:white;background:@(context.ExitReason == "목표 도달" ? "var(--mud-palette-success)" : context.ExitReason == "손절" ? "var(--mud-palette-error)" : "var(--mud-palette-warning)");">
                        @context.ExitReason
                    </span>
                </MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager PageSizeOptions="new int[] { 50, 100 }" />
            </PagerContent>
        </MudTable>
    }
}
else if (!string.IsNullOrEmpty(_errorMessage))
{
    <MudAlert Severity="Severity.Error" Class="mt-4" CloseIconClicked="() => _errorMessage = null" ShowCloseIcon="true">@_errorMessage</MudAlert>
}
else if (!_isRunning)
{
    <MudAlert Severity="Severity.Info">매개변수를 설정하고 "백테스트 실행" 버튼을 클릭하여 시작하세요.</MudAlert>
}
