{
  "name": "desktop-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build --configLoader native",
    "preview": "vite preview",
    "test": "node --test src/features/**/*.test.js",
    "api:generate": "dotnet build ../StockTrader.csproj --no-restore && openapi-typescript openapi/stocktrader_desktop.json -o src/api/generated.ts",
    "api:check": "dotnet build ../StockTrader.csproj --no-restore && openapi-typescript openapi/stocktrader_desktop.json -o src/api/generated.ts --check"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tailwindcss/vite": "^4.2.4",
    "autoprefixer": "^10.5.0",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.13",
    "svelte": "5.56.9",
    "tailwindcss": "^4.2.4",
    "vite": "^8.0.10"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.0",
    "axios": "1.19.0",
    "lucide-svelte": "^1.0.1"
  }
}
