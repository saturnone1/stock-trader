FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY ["StockTrader.csproj", "./"]
COPY ["src/StockTrader.Engine/StockTrader.Engine.csproj", "src/StockTrader.Engine/"]
COPY ["src/StockTrader.OptimizationProtocol/StockTrader.OptimizationProtocol.csproj", "src/StockTrader.OptimizationProtocol/"]
COPY ["src/StockTrader.ServiceContracts/StockTrader.ServiceContracts.csproj", "src/StockTrader.ServiceContracts/"]
COPY ["src/StockTrader.MlTrainingCompute/StockTrader.MlTrainingCompute.csproj", "src/StockTrader.MlTrainingCompute/"]
COPY ["src/StockTrader.TradingCore/StockTrader.TradingCore.csproj", "src/StockTrader.TradingCore/"]
COPY ["src/StockTrader.TradingCore.BrokerPorts/StockTrader.TradingCore.BrokerPorts.csproj", "src/StockTrader.TradingCore.BrokerPorts/"]
COPY ["src/StockTrader.TradingCore.AlpacaAdapter/StockTrader.TradingCore.AlpacaAdapter.csproj", "src/StockTrader.TradingCore.AlpacaAdapter/"]
RUN dotnet restore "StockTrader.csproj"
COPY . .
RUN dotnet publish "StockTrader.csproj" -c Release -o /app/publish /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime-base
WORKDIR /app
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl tzdata \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /app/publish .
ENV ASPNETCORE_HTTP_PORTS=5239
ENV ASPNETCORE_ENVIRONMENT=Production
ENV ConnectionStrings__DefaultConnection="Data Source=/data/stocktrader.db"
ENV TZ=America/New_York
VOLUME ["/data"]
EXPOSE 5239
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl --fail --silent http://localhost:5239/api/health || exit 1
ENTRYPOINT ["dotnet", "StockTrader.dll"]

FROM runtime-base AS local

FROM runtime-base AS remote
RUN rm -f /app/Alpaca.Markets.dll /app/StockTrader.TradingCore.AlpacaAdapter.dll
