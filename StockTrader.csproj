<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>58709c35-6c47-4b06-9c21-5a5da617f2fb</UserSecretsId>
    <OpenApiGenerateDocuments>true</OpenApiGenerateDocuments>
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)/desktop-app/openapi</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOptions>--document-name desktop --file-name stocktrader</OpenApiGenerateDocumentsOptions>
  </PropertyGroup>

  <ItemGroup>
    <!-- Exclude test project files from main project compilation -->
    <Compile Remove="tests\**\*.cs" />
    <Compile Remove="src\**\*.cs" />
    <Compile Remove="Domain\MarketData\TimeFrame.cs" />
    <Compile Remove="Domain\MarketData\TimeFrameCatalog.cs" />
    <Compile Remove="Domain\Strategies\IndicatorCatalog.cs" />
    <Compile Remove="Domain\Strategies\RuleOperatorCatalog.cs" />
    <Compile Remove="Domain\Strategies\StrategyCatalog.cs" />
    <Compile Remove="Domain\Strategies\StrategyDocumentDefaults.cs" />
    <Compile Remove="Domain\Strategies\StrategyDocumentVersions.cs" />
    <Compile Remove="Application\Strategies\CompiledStrategy.cs" />
    <Compile Remove="Application\Strategies\LiveStrategyCompatibilityPolicy.cs" />
    <Compile Remove="Application\Strategies\StrategyCompiler.cs" />
    <Compile Remove="Application\Strategies\StrategyDocument.cs" />
    <Compile Remove="Application\Strategies\StrategyDocumentVersionPolicy.cs" />
    <Compile Remove="Application\Strategies\StrategyEvaluationPolicy.cs" />
    <Compile Remove="Application\Execution\LongPositionCloseDecisionPolicy.cs" />
    <Compile Remove="Application\Execution\LongPositionExecutionPolicy.cs" />
    <Compile Remove="Application\Execution\LongPositionExecutionContracts.cs" />
    <Compile Remove="Application\Execution\LongEntryFillPolicy.cs" />
    <Compile Remove="Application\Execution\LongPositionExecutionSessionPolicy.cs" />
    <Compile Remove="Application\Execution\LongPositionScalingPolicy.cs" />
    <Compile Remove="Application\Execution\LongPositionSizingPolicy.cs" />
    <Content Remove="tests\**\*" />
    <EmbeddedResource Remove="tests\**\*" />
    <None Remove="tests\**\*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Alpaca.Markets" Version="7.2.2" />
    <PackageReference Include="Microsoft.ML" Version="4.0.0" />
    <PackageReference Include="Microsoft.ML.FastTree" Version="4.0.0" />
    <PackageReference Include="Microsoft.ML.TimeSeries" Version="4.0.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
    <PackageReference Include="Serilog.Enrichers.Environment" Version="3.0.1" />
    <PackageReference Include="Serilog.Enrichers.Thread" Version="4.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="Serilog.Formatting.Compact" Version="3.0.0" />
    <PackageReference Include="TimeZoneConverter" Version="7.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="src\StockTrader.Engine\StockTrader.Engine.csproj" />
    <ProjectReference Include="src\StockTrader.OptimizationProtocol\StockTrader.OptimizationProtocol.csproj" />
    <ProjectReference Include="src\StockTrader.ServiceContracts\StockTrader.ServiceContracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>StockTrader.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
