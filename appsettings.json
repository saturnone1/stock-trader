{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "StockTrader.BackgroundServices": "Information",
      "StockTrader.Services.Patterns": "Debug"
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Enrichers.Environment",
      "Serilog.Enrichers.Thread"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "StockTrader.BackgroundServices": "Information",
        "StockTrader.Services.Patterns": "Debug",
        "StockTrader.Services.ML": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "theme": "Serilog.Sinks.SystemConsole.Themes.AnsiConsoleTheme::Code, Serilog.Sinks.Console",
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}{NewLine}  {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/stocktrader-.json",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 31,
          "buffered": true,
          "flushToDiskInterval": "00:00:02",
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/stocktrader-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 31,
          "buffered": true,
          "flushToDiskInterval": "00:00:02",
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}{NewLine}  {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ],
    "Properties": {
      "Application": "StockTrader"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5239"
      }
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=C:\\Users\\satur\\Desktop\\stock\\trader\\stocktrader.db"
  },
  "Security": {
    "SessionTimeoutMinutes": 1440,
    "MaxFailedLoginAttempts": 5,
    "LockoutMinutes": 15,
    "RequireHttps": false,
    "AllowRegistration": false,
    "MasterEncryptionKey": ""
  },
  "Broker": {
    "DefaultBrokerType": "Alpaca"
  },
  "Alpaca": {
    "ApiKey": "YOUR_ALPACA_API_KEY",
    "ApiSecret": "YOUR_ALPACA_API_SECRET",
    "BaseUrl": "https://paper-api.alpaca.markets",
    "DataBaseUrl": "https://data.alpaca.markets",
    "IsPaper": true,
    "EnableStreaming": true,
    "StreamTypes": [
      "minuteBars"
    ],
    "MaxReconnectAttempts": 10,
    "InitialReconnectDelaySeconds": 2,
    "MaxReconnectDelaySeconds": 300
  },
  "Polygon": {
    "ApiKey": "YOUR_POLYGON_API_KEY",
    "BaseUrl": "https://api.polygon.io"
  },
  "YahooFinance": {
    "BaseUrl": "https://query1.finance.yahoo.com",
    "RateLimitDelayMs": 200,
    "MaxRetries": 3,
    "UserAgent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36"
  },
  "LsSecurities": {
    "AppKey": "YOUR_LS_APP_KEY",
    "AppSecret": "YOUR_LS_APP_SECRET",
    "AccountNo": "00000000",
    "AccountPassword": "0000",
    "IsPaper": true,
    "BaseUrl": "https://openapi.ls-sec.co.kr:8080",
    "WebSocketUrl": "wss://openapi.ls-sec.co.kr:9443/websocket",
    "WebSocketPaperUrl": "wss://openapi.ls-sec.co.kr:29443/websocket"
  },
  "Trading": {
    "DefaultAccountSize": 100000,
    "RiskPerTradePercent": 0.01,
    "DailyLossLimitPercent": 0.03,
    "MaxPositionsPerSector": 2,
    "MaxTotalPositions": 7,
    "MinExpectancy": 0.0,
    "MinConfidence": 0.3,
    "MarketOpenET": "09:30",
    "MarketCloseET": "16:00",
    "DataFetchIntervalSeconds": 60,
    "PatternScanIntervalSeconds": 60,
    "RiskCheckIntervalSeconds": 30
  },
  "Notification": {
    "EnableTelegram": false,
    "TelegramBotToken": "",
    "TelegramChatId": "",
    "EnableDiscord": false,
    "DiscordWebhookUrl": "",
    "EnableEmail": false,
    "SmtpHost": "",
    "SmtpPort": 587,
    "SmtpUseSsl": true,
    "SmtpUsername": "",
    "SmtpPassword": "",
    "EmailFrom": "",
    "EmailTo": "",
    "DailyReportTime": "16:30",
    "MaxRetryAttempts": 3,
    "RetryDelaySeconds": 5
  },
  "ML": {
    "ModelDirectory": "ml_models",
    "RegimeModelFileName": "regime_classifier.zip",
    "SignalScorerModelFileName": "signal_scorer.zip",
    "MinTrainingSamples": 50,
    "RegimeClusterCount": 4,
    "RegimeTrainingDays": 365,
    "MlScoreBlendWeight": 0.5,
    "EnableMlScoring": true,
    "AutoRetrainIntervalHours": 24
  },
  "Patterns": {
    "EnabledPatterns": [
      "Breakout",
      "TrendPullback",
      "VolatilityExpansion",
      "MomentumReversal",
      "MeanReversionChannel",
      "Rsi2Bollinger",
      "Tqqq200Sma"
    ],
    "GapUpPullback": {
      "MinGapPercent": 0.005,
      "MaxPullbackPercent": 0.8,
      "MinVolume": 100000
    },
    "Breakout": {
      "LookbackDays": 10,
      "MinVolumeMultiplier": 1.0,
      "BreakoutMarginPercent": 0.001,
      "AtrStopMultiplier": 1.5,
      "AtrTargetMultiplier": 4.0
    },
    "VwapReversion": {
      "MaxDeviationPercent": 0.01,
      "MinBouncePercent": 0.003,
      "MinBounceFromLowPercent": 0.2
    },
    "RsiMeanReversion": {
      "OversoldThreshold": 30,
      "Period": 14,
      "MinVolumeIncreaseMultiplier": 1.0,
      "AtrStopMultiplier": 1.5,
      "AtrTargetMultiplier": 2.0
    },
    "TrendPullback": {
      "MaPeriod": 20,
      "MaxPullbackFromMa": 0.025,
      "TrendConfirmationDays": 7,
      "AtrStopMultiplier": 1.5,
      "AtrTargetMultiplier": 5.0
    },
    "OpeningRangeBreakout": {
      "RangeMinutes": 15,
      "MinRangePercent": 0.005
    },
    "VolumeSpikeContinuation": {
      "VolumeMultiplier": 1.5,
      "ContinuationBars": 2,
      "VolumeAvgPeriod": 20,
      "AtrStopMultiplier": 2.0,
      "AtrTargetMultiplier": 3.0
    },
    "EarningsDrift": {
      "DriftDays": 5,
      "MinSurprisePercent": 0.05
    },
    "IndexRegimeFilter": {
      "MaPeriod": 200,
      "IndexSymbol": "SPY"
    },
    "VolatilityExpansion": {
      "BollingerPeriod": 20,
      "StdDevMultiplier": 2.0,
      "AtrStopMultiplier": 2.0,
      "AtrTargetMultiplier": 2.0
    },
    "MomentumReversal": {
      "FastEmaPeriod": 12,
      "SlowEmaPeriod": 26,
      "MacdSignalPeriod": 9,
      "RsiPeriod": 14,
      "RsiOversold": 30,
      "RsiOverbought": 70,
      "RsiMomentumMin": 40,
      "AtrStopMultiplier": 2.0,
      "AtrTargetMultiplier": 3.0
    },
    "MultiTimeframeTrend": {
      "LongTrendMaPeriod": 50,
      "ShortEntryMaPeriod": 20,
      "MaxPullbackPercent": 0.05,
      "TrendConfirmationBars": 3,
      "MaxDistanceAboveShortMa": 0.02,
      "AtrStopMultiplier": 1.5,
      "AtrTargetMultiplier": 3.0
    },
    "MeanReversionChannel": {
      "EmaPeriod": 25,
      "AtrPeriod": 10,
      "AtrMultiplier": 1.5,
      "RsiPeriod": 14,
      "RsiOversold": 40,
      "RecentLowLookbackBars": 5
    },
    "Rsi2Bollinger": {
      "RsiPeriod": 2,
      "RsiThreshold": 20,
      "BollingerPeriod": 20,
      "BollingerStdDev": 2.0,
      "LongTrendMaPeriod": 200,
      "AtrStopMultiplier": 1.5
    },
    "VolatilityBreakout": {
      "BreakoutFactor": 0.5,
      "MinVolumeMultiplier": 1.0,
      "VolumeAvgPeriod": 20,
      "AtrStopMultiplier": 2.0,
      "AtrTargetMultiplier": 3.0
    },
    "Tqqq200Sma": {
      "SmaPeriod": 200,
      "EntryDistancePercent": 1.01,
      "FixedStopPercent": 0.059,
      "SpyExitDistancePercent": 0.9775,
      "MaxVolatility20d": 0.059,
      "OverheatStage1": 1.39,
      "OverheatStage2": 1.46,
      "VolumeAvgPeriod": 20,
      "MinVolumeRatio": 1.0,
      "AllowedSymbols": [ "TQQQ" ]
    }
  }
}