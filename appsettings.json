{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "StockTrader.BackgroundServices": "Information",
      "StockTrader.Services.Patterns": "Debug"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:5239"
      }
    }
  },

  "ConnectionStrings": {
    "DefaultConnection": "Data Source=stocktrader.db"
  },

  "Alpaca": {
    "ApiKey": "YOUR_ALPACA_API_KEY",
    "ApiSecret": "YOUR_ALPACA_API_SECRET",
    "BaseUrl": "https://paper-api.alpaca.markets",
    "DataBaseUrl": "https://data.alpaca.markets",
    "IsPaper": true,
    "EnableStreaming": false,
    "StreamTypes": [ "minuteBars" ],
    "MaxReconnectAttempts": 10,
    "InitialReconnectDelaySeconds": 2,
    "MaxReconnectDelaySeconds": 300
  },

  "Polygon": {
    "ApiKey": "YOUR_POLYGON_API_KEY",
    "BaseUrl": "https://api.polygon.io"
  },

  "YahooFinance": {
    "BaseUrl": "https://query1.finance.yahoo.com",
    "RateLimitDelayMs": 200,
    "MaxRetries": 3,
    "UserAgent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36"
  },

  "Trading": {
    "DefaultAccountSize": 100000,
    "RiskPerTradePercent": 0.01,
    "DailyLossLimitPercent": 0.03,
    "MaxPositionsPerSector": 2,
    "MaxTotalPositions": 10,
    "MinExpectancy": 0.0,
    "MarketOpenET": "09:30",
    "MarketCloseET": "16:00",
    "DataFetchIntervalSeconds": 60,
    "PatternScanIntervalSeconds": 60,
    "RiskCheckIntervalSeconds": 30
  },

  "Patterns": {
    "EnabledPatterns": [ "GapUpPullback", "Breakout", "VwapReversion" ],
    "GapUpPullback": {
      "MinGapPercent": 0.02,
      "MaxPullbackPercent": 0.5,
      "MinVolume": 500000
    },
    "Breakout": {
      "LookbackDays": 252,
      "MinVolumeMultiplier": 1.5,
      "BreakoutMarginPercent": 0.001
    },
    "VwapReversion": {
      "MaxDeviationPercent": 0.02,
      "MinBouncePercent": 0.003
    },
    "RsiMeanReversion": {
      "OversoldThreshold": 30,
      "Period": 14
    },
    "TrendPullback": {
      "MaPeriod": 20,
      "MaxPullbackFromMa": 0.02,
      "TrendConfirmationDays": 10
    },
    "OpeningRangeBreakout": {
      "RangeMinutes": 15,
      "MinRangePercent": 0.005
    },
    "VolumeSpikeContinuation": {
      "VolumeMultiplier": 2.0,
      "ContinuationBars": 3
    },
    "EarningsDrift": {
      "DriftDays": 5,
      "MinSurprisePercent": 0.05
    },
    "IndexRegimeFilter": {
      "MaPeriod": 200,
      "IndexSymbol": "SPY"
    },
    "VolatilityExpansion": {
      "BollingerPeriod": 20,
      "StdDevMultiplier": 2.0
    },
    "MomentumReversal": {
      "FastEmaPeriod": 12,
      "SlowEmaPeriod": 26,
      "MacdSignalPeriod": 9,
      "RsiPeriod": 14,
      "RsiOversold": 30,
      "RsiOverbought": 70
    },
    "MultiTimeframeTrend": {
      "LongTrendMaPeriod": 50,
      "ShortEntryMaPeriod": 20,
      "MaxPullbackPercent": 0.03,
      "TrendConfirmationBars": 5
    },
    "MeanReversionChannel": {
      "EmaPeriod": 20,
      "AtrPeriod": 10,
      "AtrMultiplier": 1.5,
      "RsiPeriod": 14,
      "RsiOversold": 35
    }
  }
}
