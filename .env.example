# =============================================================================
# .env.example — Environment variable template for Docker deployment
#
# USAGE:
#   cp .env.example .env
#   (edit .env with your real values)
#   docker compose up -d
#
# IMPORTANT: Never commit .env to git.  .gitignore already excludes it.
# =============================================================================

# ── Build ─────────────────────────────────────────────────────────────────────
BUILD_VERSION=1.0.0

# ── Alpaca Markets API ────────────────────────────────────────────────────────
# Get your keys from https://app.alpaca.markets/paper-trading
ALPACA_API_KEY=PKxxxxxxxxxxxxxxxxxxxxxxxx
ALPACA_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Set to false for live trading (use with caution)
ALPACA_IS_PAPER=true

# ── Polygon.io (optional, for alternative data feed) ─────────────────────────
POLYGON_API_KEY=

# ── Telegram Notifications (optional) ────────────────────────────────────────
NOTIFY_TELEGRAM=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Discord Notifications (optional) ─────────────────────────────────────────
NOTIFY_DISCORD=false
DISCORD_WEBHOOK_URL=

# ── Email Notifications (optional) ───────────────────────────────────────────
NOTIFY_EMAIL=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# ── LS Securities 한국주식 (optional) ─────────────────────────────────────────
LS_APP_KEY=
LS_APP_SECRET=
LS_ACCOUNT_NO=00000000
LS_ACCOUNT_PASSWORD=0000
LS_IS_PAPER=true

# ── Trading Parameters ────────────────────────────────────────────────────────
DEFAULT_ACCOUNT_SIZE=100000
RISK_PER_TRADE=0.01
DAILY_LOSS_LIMIT=0.03
