<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <!-- C# service contracts carry nullable annotations that F# 10 reports again after explicit
         Option/isNull guards. Keep the guards and suppress only that interop diagnostic. -->
    <NoWarn>$(NoWarn);3261</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
    <ProjectReference Include="..\..\src\StockTrader.ServiceContracts\StockTrader.ServiceContracts.csproj" />
    <ProjectReference Include="..\..\src\StockTrader.Engine\StockTrader.Engine.csproj" />
    <ProjectReference Include="..\..\src\StockTrader.TradingCore\StockTrader.TradingCore.csproj" />
    <Compile Include="Configuration.fs" />
    <Compile Include="Database.fs" />
    <Compile Include="SecretStore.fs" />
    <Compile Include="TradingCoreStore.fs" />
    <Compile Include="TradingCoreAuthorityStore.fs" />
    <Compile Include="TradingCoreRecommendationStore.fs" />
    <Compile Include="TradingCoreEntryStore.fs" />
    <Compile Include="TradingCoreEntryBrokerStore.fs" />
    <Compile Include="TradingCoreShadowStore.fs" />
    <Compile Include="TradingCoreCommandStore.fs" />
    <Compile Include="TradingCorePositionStore.fs" />
    <Compile Include="TradingCorePositionStateStore.fs" />
    <Compile Include="TradingCorePositionBrokerStore.fs" />
    <Compile Include="TradingCoreQueryStore.fs" />
    <Compile Include="TradingCoreMarketStore.fs" />
    <Compile Include="TradingCoreOperations.fs" />
    <Compile Include="BrokerWorker.fs" />
    <Compile Include="HttpHost.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
</Project>
