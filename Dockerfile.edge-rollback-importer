FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY . .
RUN dotnet publish src/StockTrader.EdgeRollbackImporter/StockTrader.EdgeRollbackImporter.csproj -c Release -o /out

FROM mcr.microsoft.com/dotnet/runtime:10.0
WORKDIR /app
RUN useradd --uid 1654 --create-home appuser
COPY --from=build /out .
USER 1654
ENTRYPOINT ["dotnet", "StockTrader.EdgeRollbackImporter.dll"]
