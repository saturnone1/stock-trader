FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY . .
RUN dotnet publish workers/trading-core-shadow-host/StockTrader.TradingCoreShadowHost.fsproj -c Release -o /out /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0
WORKDIR /app
COPY --from=build /out .
ENV ASPNETCORE_ENVIRONMENT=Production
EXPOSE 8080 9443
USER $APP_UID
ENTRYPOINT ["dotnet", "StockTrader.TradingCoreShadowHost.dll"]
